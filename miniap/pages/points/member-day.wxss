.day{min-height:100vh;padding:0 24rpx 40rpx;background:#fff6eb}.hero{margin:0 -24rpx;padding:70rpx 36rpx 60rpx;text-align:center;color:#fff;background:linear-gradient(135deg,#ff8d28,#ff5516)}.kicker{font-size:26rpx}.title{margin-top:20rpx;font-size:62rpx;font-weight:800;letter-spacing:5rpx}.sub{margin-top:14rpx;font-size:27rpx;opacity:.9}.benefits{margin-top:-25rpx;padding:0 8rpx}.benefit{display:flex;align-items:center;gap:18rpx;margin-top:16rpx;padding:26rpx;border-radius:16rpx;background:#fff;box-shadow:0 8rpx 24rpx rgba(255,102,0,.08)}.benefit-icon{width:66rpx;height:66rpx;border-radius:50%;background:#fff1df;color:#ff6600;font-size:34rpx;font-weight:800;line-height:66rpx;text-align:center}.benefit-title{font-size:30rpx;font-weight:700}.benefit-desc{margin-top:7rpx;color:#8a9099;font-size:23rpx}.coupon-btn{height:54rpx;margin:0 0 0 auto;padding:0 16rpx;border-radius:16rpx;background:#fff1e6;color:#ff6600;font-size:22rpx}.mall-title{margin:36rpx 8rpx 18rpx;font-size:31rpx;font-weight:700}.mall-title text{float:right;color:#ff6600;font-size:24rpx}.products{display:grid;grid-template-columns:repeat(2,1fr);gap:16rpx}.product{padding:24rpx;border-radius:16rpx;background:#fff}.product-name{overflow:hidden;font-size:26rpx;text-overflow:ellipsis;white-space:nowrap}.product-points{margin-top:12rpx;color:#ff6600;font-size:25rpx;font-weight:700}.primary-btn{margin-top:44rpx}.tip{text-align:center;margin-top:16rpx;color:#9aa0a6;font-size:23rpx}
