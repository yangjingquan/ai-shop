.member-day-page {
  min-height: 100vh;
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
}

.member-lift {
  position: relative;
  margin: -40rpx 32rpx 0;
  z-index: 1;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.benefit-card {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 28rpx;
  margin: 0;
}

.benefit-symbol {
  width: 96rpx;
  height: 96rpx;
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 38rpx;
  font-weight: 900;
  flex: none;
}

.benefit-symbol-yellow {
  background: #FFD23F;
  color: #15161C;
}

.benefit-symbol-orange {
  background: #FFE3D6;
  color: #FF4A1C;
}

.benefit-copy {
  flex: 1;
  min-width: 0;
}

.benefit-title {
  font-size: 32rpx;
  font-weight: 800;
  color: #15161C;
}

.benefit-desc {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #9A9EA8;
}

.coupon-btn {
  flex: none;
}

.lottery-entry {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin: 20rpx 32rpx 0;
  padding: 28rpx;
}

.lottery-thumb {
  width: 112rpx;
  height: 112rpx;
  border-radius: 28rpx;
  flex: none;
}

.lottery-copy {
  flex: 1;
  min-width: 0;
}

.lottery-kicker {
  font-size: 20rpx;
  font-weight: 800;
  letter-spacing: 4rpx;
  color: #7B5CFF;
}

.lottery-title {
  font-size: 30rpx;
  font-weight: 800;
  color: #15161C;
}

.lottery-desc {
  margin-top: 4rpx;
  font-size: 24rpx;
  color: #9A9EA8;
}

.lottery-go {
  flex: none;
  padding: 12rpx 20rpx;
  border-radius: 28rpx;
  background: linear-gradient(90deg, #7B5CFF, #FF5CA8);
  color: #fff;
  font-size: 24rpx;
  font-weight: 700;
}

.mall-head {
  margin: 32rpx 32rpx 20rpx;
}

.product-grid {
  display: flex;
  gap: 16rpx;
  padding: 0 32rpx;
  overflow-x: auto;
}

.product-mini {
  flex: 0 0 calc(33.33% - 12rpx);
  min-width: 200rpx;
  padding: 16rpx;
  border-radius: 28rpx;
  background: #fff;
  box-shadow: 0 8rpx 36rpx rgba(20, 22, 28, 0.04);
}

.product-mini-cover {
  width: 100%;
  height: 160rpx;
  border-radius: 24rpx;
}

.product-mini-name {
  margin-top: 12rpx;
  font-size: 24rpx;
  font-weight: 700;
  color: #15161C;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.product-mini-points {
  margin-top: 6rpx;
  font-size: 24rpx;
  font-weight: 800;
  color: #B07A00;
}

.member-cta {
  width: 100%;
  display: flex;
  margin: 28rpx 32rpx 0;
  box-sizing: border-box;
  width: calc(100% - 64rpx);
}
