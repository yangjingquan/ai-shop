<view class="points-page page-shell">
  <view class="page-hero page-hero-gold">
    <view class="hero-blob"></view>
    <view class="points-hero-inner">
      <text class="level-pill">{{profile.levelName || '普通会员'}} · Lv.{{profile.level || 1}}</text>
      <text class="balance">{{profile.remainingPoints || profile.balance || 0}}</text>
      <text class="balance-label">剩余积分</text>
      <view class="points-summary">
        <view class="summary-col">
          <text class="summary-label">总积分</text>
          <text class="summary-value">{{profile.totalPoints || 0}}</text>
        </view>
        <view class="summary-col summary-col-border">
          <text class="summary-label">{{profile.hasNextLevel ? '距下一等级' : '会员等级'}}</text>
          <text class="summary-value">{{profile.hasNextLevel ? profile.pointsToNext : '已达最高级'}}</text>
        </view>
      </view>
    </view>
  </view>

  <view class="shortcut-card card">
    <view class="shortcut-item" bindtap="goMall">
      <view class="shortcut-icon shortcut-icon-yellow">商</view>
      <text>积分商城 ›</text>
    </view>
    <view class="shortcut-item" bindtap="goRecords">
      <view class="shortcut-icon shortcut-icon-orange">记</view>
      <text>兑换记录 ›</text>
    </view>
    <view class="shortcut-item" bindtap="goMemberDay">
      <view class="shortcut-icon shortcut-icon-purple">日</view>
      <text>会员日 ›</text>
    </view>
  </view>

  <view wx:if="{{lotteryActivity}}" class="lottery-entry card" bindtap="goLottery">
    <image class="lottery-thumb" src="{{lotteryActivity.entryImage || '/assets/lottery/blind-box-hero.jpg'}}" mode="aspectFill" />
    <view class="lottery-copy">
      <view class="lottery-kicker">DAILY SURPRISE</view>
      <view class="lottery-title">互动抽奖盲盒</view>
      <view class="lottery-desc">每日 {{lotteryActivity.dailyChances || 1}} 次，积分好礼等你拿</view>
    </view>
    <text class="lottery-go">去抽奖 ›</text>
  </view>

  <view class="task-card card">
    <view>
      <view class="task-title">每日签到</view>
      <view class="task-desc">每天签到，持续积攒好礼</view>
    </view>
    <button class="btn btn-primary btn-sm sign-btn {{signedToday ? 'btn-disabled' : ''}}" bindtap="signIn">{{signedToday ? '已签到' : '签到领积分'}}</button>
  </view>

  <view class="page-section-head ledger-head">
    <text class="page-section-title">积分明细</text>
    <text class="page-section-tip">最近 30 条</text>
  </view>

  <view class="ledger card">
    <view wx:if="{{!ledgers.length}}" class="empty-state2 ledger-empty">
      <text class="empty-state2-desc">暂无积分记录</text>
    </view>
    <view wx:for="{{ledgers}}" wx:key="id" class="ledger-row">
      <view>
        <view class="ledger-title">{{item.source === 'MEMBER_DAY_COUPON' ? '已领取会员日专享券' : item.description}}</view>
        <view class="ledger-time">{{item.timeText}}</view>
      </view>
      <view wx:if="{{item.source !== 'MEMBER_DAY_COUPON'}}" class="ledger-change {{item.changeValue > 0 ? 'income' : 'cost'}}">{{item.sign}}{{item.changeValue}}</view>
    </view>
  </view>
</view>
