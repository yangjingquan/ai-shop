<view class="points-page page-shell">
  <view class="points-hero"><text class="hero-label">{{profile.levelName || '普通会员'}} · Lv.{{profile.level || 1}}</text><text class="balance">{{profile.remainingPoints || profile.balance || 0}}</text><text class="balance-label">剩余积分</text><view class="points-summary"><view><text>总积分</text><text>{{profile.totalPoints || 0}}</text></view><view wx:if="{{profile.hasNextLevel}}"><text>距下一等级</text><text>{{profile.pointsToNext}}</text></view><view wx:else><text>会员等级</text><text>已达最高级</text></view></view><view class="hero-actions"><view bindtap="goMall">积分商城 ›</view><view bindtap="goRecords">兑换记录 ›</view><view bindtap="goMemberDay">会员日 ›</view></view></view>
  <view wx:if="{{lotteryActivity}}" class="lottery-entry card" bindtap="goLottery"><image class="lottery-entry-image" src="{{lotteryActivity.entryImage || '/assets/lottery/blind-box-hero.png'}}" mode="aspectFill" /><view class="lottery-entry-copy"><view class="lottery-entry-kicker">DAILY SURPRISE</view><view class="lottery-entry-title">互动抽奖盲盒</view><view class="lottery-entry-desc">每日 {{lotteryActivity.dailyChances || 1}} 次，积分好礼等你拿</view></view><view class="lottery-entry-arrow">去抽奖 ›</view></view>
  <view class="task-card card"><view><view class="task-title">每日签到</view><view class="task-desc">每天签到，持续积攒好礼</view></view><button class="sign-btn {{signedToday ? 'done' : ''}}" bindtap="signIn">{{signedToday ? '已签到' : '签到领积分'}}</button></view>
  <view class="section-head"><text>积分明细</text><text class="muted">最近 30 条</text></view>
  <view class="ledger card"><view wx:if="{{!ledgers.length}}" class="empty">暂无积分记录</view><view wx:for="{{ledgers}}" wx:key="id" class="ledger-row"><view><view class="ledger-title">{{item.source === 'MEMBER_DAY_COUPON' ? '已领取会员日专享券' : item.description}}</view><view class="ledger-time">{{item.timeText}}</view></view><view wx:if="{{item.source !== 'MEMBER_DAY_COUPON'}}" class="ledger-change {{item.changeValue > 0 ? 'income' : 'cost'}}">{{item.sign}}{{item.changeValue}}</view></view></view>
</view>
