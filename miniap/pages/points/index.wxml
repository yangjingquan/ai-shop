<view class="points-page page-shell">
  <view class="points-hero"><text class="hero-label">我的积分</text><text class="balance">{{profile.balance || 0}}</text><view class="hero-actions"><view bindtap="goMall">积分商城 ›</view><view bindtap="goMemberDay">会员日 ›</view></view></view>
  <view class="task-card card"><view><view class="task-title">每日签到</view><view class="task-desc">每天签到，持续积攒好礼</view></view><button class="sign-btn {{signedToday ? 'done' : ''}}" bindtap="signIn">{{signedToday ? '已签到' : '签到领积分'}}</button></view>
  <view class="section-head"><text>积分明细</text><text class="muted">最近 30 条</text></view>
  <view class="ledger card"><view wx:if="{{!ledgers.length}}" class="empty">暂无积分记录</view><view wx:for="{{ledgers}}" wx:key="id" class="ledger-row"><view><view class="ledger-title">{{item.description}}</view><view class="ledger-time">{{item.timeText}}</view></view><view class="ledger-change {{item.changeValue > 0 ? 'income' : 'cost'}}">{{item.sign}}{{item.changeValue}}</view></view></view>
</view>
