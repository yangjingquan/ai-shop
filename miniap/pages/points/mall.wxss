.mall-page {
  min-height: 100vh;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
}

.mall-page .page-hero {
  padding-bottom: 56rpx;
}

.mall-follow {
  position: relative;
  z-index: 2;
}

.mall-follow .mall-notice {
  margin-top: 0;
}

.mall-page .hero-chip-on {
  color: #B07A00;
}

.points-balance-label {
  margin-top: 0;
  font-size: 26rpx;
  line-height: 1.45;
  opacity: 0.7;
  letter-spacing: 2rpx;
}

.points-balance-value {
  font-size: 76rpx;
  font-weight: 900;
  line-height: 1.1;
}

.mall-notice {
  margin: 24rpx 32rpx 0;
  padding: 16rpx 24rpx;
  border-radius: 24rpx;
  background: #FFF6D6;
  color: #B07A00;
  font-size: 24rpx;
  font-weight: 600;
}

.mall-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 20rpx;
  margin-top: 24rpx;
  width: 100%;
  box-sizing: border-box;
}

.mall-item {
  display: flex;
  flex-direction: column;
  align-items: stretch;
  min-width: 0;
  padding: 16rpx 16rpx 20rpx;
  border-radius: 32rpx;
  background: #fff;
  box-shadow: 0 8rpx 36rpx rgba(20, 22, 28, 0.04);
  box-sizing: border-box;
  overflow: hidden;
}

.mall-image {
  width: 100%;
  height: 260rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  font-weight: 900;
  color: #FF4A1C;
  flex: none;
}

.mall-name {
  margin: 16rpx 0 8rpx;
  font-size: 26rpx;
  font-weight: 700;
  color: #15161C;
  display: -webkit-box;
  overflow: hidden;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  min-width: 0;
}

.mall-price {
  color: #B07A00;
  font-size: 26rpx;
  font-weight: 800;
  flex: none;
}

.mall-meta-line {
  width: 100%;
  min-width: 0;
  margin-top: 12rpx;
  font-size: 20rpx;
  color: #9A9EA8;
  line-height: 1.5;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.mall-redeem-btn {
  width: 100%;
  height: 60rpx;
  margin: 16rpx 0 0;
  padding: 0 16rpx;
  font-size: 22rpx;
  display: flex;
  box-sizing: border-box;
  flex: none;
}

.mall-empty {
  grid-column: 1 / -1;
}
