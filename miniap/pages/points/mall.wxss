.mall-page {
  min-height: 100vh;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
}

.mall-page .page-hero {
  padding-bottom: 40rpx;
}

.points-balance-label {
  margin-top: 0;
  font-size: 26rpx;
  opacity: 0.92;
}

.points-balance-value {
  font-size: 76rpx;
  font-weight: 900;
  line-height: 1.1;
}

.mall-notice {
  margin: 24rpx 32rpx 0;
  padding: 16rpx 24rpx;
  border-radius: 24rpx;
  background: #FFF6D6;
  color: #B07A00;
  font-size: 24rpx;
  font-weight: 600;
}

.mall-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  margin-top: 24rpx;
}

.mall-item {
  width: calc(50% - 10rpx);
  margin-bottom: 20rpx;
  padding: 16rpx 16rpx 24rpx;
  border-radius: 32rpx;
  background: #fff;
  box-shadow: 0 8rpx 36rpx rgba(20, 22, 28, 0.04);
  box-sizing: border-box;
}

.mall-image {
  width: 100%;
  height: 260rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  font-weight: 900;
  color: #FF4A1C;
}

.mall-name {
  margin: 16rpx 0 8rpx;
  font-size: 26rpx;
  font-weight: 700;
  color: #15161C;
  display: -webkit-box;
  overflow: hidden;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.mall-price {
  color: #B07A00;
  font-size: 26rpx;
  font-weight: 800;
}

.mall-bottom {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 8rpx;
  margin-top: 12rpx;
}

.mall-meta {
  flex: 1;
  min-width: 0;
  font-size: 20rpx;
  color: #9A9EA8;
  line-height: 1.5;
}

.mall-bottom .btn-sm {
  flex: none;
  height: 60rpx;
  padding: 0 20rpx;
  font-size: 22rpx;
}

.mall-empty {
  width: 100%;
}
