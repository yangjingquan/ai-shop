.mall{min-height:100vh;padding:24rpx;background:#f6f7f9}.balance-bar{display:flex;align-items:center;padding:24rpx 26rpx;border-radius:16rpx;background:#fff;color:#646a73;font-size:25rpx}.balance-bar text{margin-left:10rpx;color:#ff6600;font-size:34rpx;font-weight:800}.address-link{margin-left:auto;color:#ff6600;font-size:23rpx}.notice{margin:18rpx 4rpx;color:#8a9099;font-size:23rpx}.grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18rpx}.item{padding:16rpx;overflow:hidden}.image{width:100%;height:218rpx;border-radius:12rpx;background:#f7f0e9}.placeholder{display:flex;align-items:center;justify-content:center;color:#ffb16d;font-size:60rpx;font-weight:800}.name{margin-top:15rpx;overflow:hidden;font-size:27rpx;font-weight:600;text-overflow:ellipsis;white-space:nowrap}.bottom{margin-top:14rpx}.price{height:30rpx;margin-bottom:10rpx;color:#ff6600;font-size:23rpx;font-weight:700;line-height:30rpx;white-space:nowrap}.mall .grid .item .redeem{box-sizing:border-box;width:300rpx!important;min-width:0!important;max-width:100%;height:52rpx;margin:0 auto!important;padding:0;border-radius:16rpx;background:#ff6600;color:#fff;font-size:22rpx;line-height:52rpx;white-space:nowrap}.mall .grid .item .redeem.disabled[disabled]{color:#fff;background:#cbd0d8}.stock{margin-top:10rpx;color:#9aa0a6;font-size:21rpx}.quota{margin-top:5rpx;color:#a1a7b0;font-size:19rpx;line-height:1.35;white-space:nowrap}
