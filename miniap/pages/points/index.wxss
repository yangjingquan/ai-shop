.points-page {
  min-height: 100vh;
  padding-bottom: 48rpx;
}

.points-hero-inner {
  text-align: center;
  padding-bottom: 48rpx;
}

.level-pill {
  display: inline-block;
  padding: 8rpx 24rpx;
  border-radius: 24rpx;
  background: rgba(0, 0, 0, 0.25);
  font-size: 24rpx;
}

.balance {
  display: block;
  margin-top: 16rpx;
  font-size: 104rpx;
  font-weight: 900;
  line-height: 1;
}

.balance-label {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  opacity: 0.8;
}

.points-summary {
  display: flex;
  margin-top: 28rpx;
  padding: 20rpx 0;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.15);
}

.summary-col {
  flex: 1;
  text-align: center;
}

.summary-col-border {
  border-left: 2rpx solid rgba(255, 255, 255, 0.25);
}

.summary-label {
  display: block;
  font-size: 24rpx;
  opacity: 0.85;
}

.summary-value {
  display: block;
  margin-top: 8rpx;
  font-size: 34rpx;
  font-weight: 800;
}

.shortcut-card {
  display: flex;
  justify-content: space-around;
  margin: -80rpx 32rpx 0;
  padding: 28rpx 16rpx;
  position: relative;
  z-index: 2;
}

.shortcut-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  font-size: 26rpx;
  font-weight: 700;
  color: #15161C;
}

.shortcut-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 900;
}

.shortcut-icon-yellow {
  background: #FFD23F;
  color: #15161C;
}

.shortcut-icon-orange {
  background: #FFE3D6;
  color: #FF4A1C;
}

.shortcut-icon-purple {
  background: #EDE6FF;
  color: #7B5CFF;
}

.lottery-entry {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin: 20rpx 32rpx 0;
  padding: 28rpx;
}

.lottery-thumb {
  width: 112rpx;
  height: 112rpx;
  border-radius: 28rpx;
  flex: none;
}

.lottery-copy {
  flex: 1;
  min-width: 0;
}

.lottery-kicker {
  font-size: 20rpx;
  font-weight: 800;
  letter-spacing: 4rpx;
  color: #7B5CFF;
}

.lottery-title {
  font-size: 30rpx;
  font-weight: 800;
  color: #15161C;
}

.lottery-desc {
  margin-top: 4rpx;
  font-size: 24rpx;
  color: #9A9EA8;
}

.lottery-go {
  flex: none;
  padding: 12rpx 20rpx;
  border-radius: 28rpx;
  background: linear-gradient(90deg, #7B5CFF, #FF5CA8);
  color: #fff;
  font-size: 24rpx;
  font-weight: 700;
}

.task-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 20rpx 32rpx 0;
  padding: 28rpx;
}

.task-title {
  font-size: 32rpx;
  font-weight: 800;
  color: #15161C;
}

.task-desc {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #9A9EA8;
}

.sign-btn {
  flex: none;
  margin: 0;
}

.ledger-head {
  margin: 32rpx 32rpx 16rpx;
}

.ledger {
  margin: 0 32rpx;
  padding: 8rpx 28rpx;
  overflow: hidden;
}

.ledger-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
  border-bottom: 2rpx solid #ECEDF0;
}

.ledger-row:last-child {
  border-bottom: 0;
}

.ledger-title {
  font-size: 26rpx;
  font-weight: 700;
  color: #15161C;
}

.ledger-time {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #9A9EA8;
}

.ledger-change {
  font-size: 32rpx;
  font-weight: 800;
}

.income {
  color: #16C47F;
}

.cost {
  color: #FF4A1C;
}

.ledger-empty {
  padding: 48rpx 0;
}
