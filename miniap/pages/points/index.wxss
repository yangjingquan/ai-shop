.points-page{min-height:100vh;padding:24rpx;background:#f6f7f9}.points-hero{padding:36rpx 32rpx 28rpx;border-radius:16rpx;background:linear-gradient(135deg,#ff8b28,#ff5b16);color:#fff;box-shadow:0 14rpx 30rpx rgba(255,102,0,.2)}.hero-label{display:block;font-size:25rpx;opacity:.9}.balance{display:block;margin-top:8rpx;font-size:68rpx;line-height:1;font-weight:800}.hero-actions{display:flex;gap:28rpx;margin-top:28rpx;font-size:25rpx}.task-card{display:flex;align-items:center;justify-content:space-between;margin-top:20rpx;padding:26rpx 28rpx}.task-title{font-size:30rpx;font-weight:700}.task-desc{margin-top:8rpx;color:#8a9099;font-size:23rpx}.sign-btn{height:62rpx;margin:0;padding:0 22rpx;border-radius:18rpx;background:#fff1e6;color:#ff6600;font-size:24rpx}.sign-btn.done{background:#f2f4f6;color:#9aa0a6}.section-head{display:flex;justify-content:space-between;margin:32rpx 4rpx 14rpx;font-size:30rpx;font-weight:700}.section-head .muted{font-size:23rpx;font-weight:400}.ledger{overflow:hidden}.ledger-row{display:flex;align-items:center;justify-content:space-between;padding:26rpx 28rpx;border-bottom:1rpx solid #eef0f3}.ledger-row:last-child{border:0}.ledger-title{font-size:27rpx}.ledger-time{margin-top:7rpx;color:#9aa0a6;font-size:22rpx}.ledger-change{font-size:30rpx;font-weight:700}.income{color:#20a05a}.cost{color:#ff6600}.empty{padding:60rpx;text-align:center;color:#9aa0a6}
