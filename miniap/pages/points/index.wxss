.points-page{min-height:100vh;padding:24rpx;background:#f8f5f0}.points-hero{padding:36rpx 32rpx 28rpx;border-radius:16rpx;background:linear-gradient(135deg,#ff8b28,#ff5b16);color:#fff;box-shadow:0 14rpx 30rpx rgba(255,102,0,.2)}.hero-label{display:block;font-size:25rpx;opacity:.9}.balance{display:block;margin-top:8rpx;font-size:68rpx;line-height:1;font-weight:800}.balance-label{display:block;margin-top:8rpx;font-size:22rpx;opacity:.82}.points-summary{display:flex;gap:54rpx;margin-top:24rpx}.points-summary view{display:flex;flex-direction:column;gap:6rpx}.points-summary text:first-child{font-size:22rpx;opacity:.82}.points-summary text:last-child{font-size:28rpx;font-weight:700}.hero-actions{display:flex;gap:28rpx;margin-top:28rpx;font-size:25rpx}.task-card{display:flex;align-items:center;justify-content:space-between;margin-top:20rpx;padding:26rpx 28rpx}.task-title{font-size:30rpx;font-weight:700}.task-desc{margin-top:8rpx;color:#8a9099;font-size:23rpx}.sign-btn{height:62rpx;margin:0;padding:0 22rpx;border-radius:18rpx;background:#fff1e6;color:#ef5523;font-size:24rpx}.sign-btn.done{background:#f2f4f6;color:#9aa0a6}.section-head{display:flex;justify-content:space-between;margin:32rpx 4rpx 14rpx;font-size:30rpx;font-weight:700}.section-head .muted{font-size:23rpx;font-weight:400}.ledger{overflow:hidden}.ledger-row{display:flex;align-items:center;justify-content:space-between;padding:26rpx 28rpx;border-bottom:1rpx solid #eef0f3}.ledger-row:last-child{border:0}.ledger-title{font-size:27rpx}.ledger-time{margin-top:7rpx;color:#9aa0a6;font-size:22rpx}.ledger-change{font-size:30rpx;font-weight:700}.income{color:#20a05a}.cost{color:#ef5523}.empty{padding:60rpx;text-align:center;color:#9aa0a6}
.lottery-entry { display: flex; align-items: center; position: relative; overflow: hidden; min-height: 144rpx; margin: 18rpx 0; padding: 18rpx 22rpx; box-sizing: border-box; border: 0; border-radius: 18rpx; color: #fff7e9; background: #f35b16; box-shadow: 0 12rpx 22rpx rgba(243, 91, 22, .18); }
.lottery-entry-image { flex: 0 0 auto; width: 118rpx; height: 118rpx; border-radius: 14rpx; background: #ffbd4a; }
.lottery-entry-copy { min-width: 0; margin-left: 18rpx; }
.lottery-entry-kicker { color: #ffe6a8; font-size: 18rpx; letter-spacing: 2rpx; }
.lottery-entry-title { margin-top: 8rpx; color: #fff; font-size: 32rpx; font-weight: 800; }
.lottery-entry-desc { margin-top: 8rpx; color: #ffe3be; font-size: 22rpx; }
.lottery-entry-arrow { margin-left: auto; padding-left: 12rpx; color: #fff; font-size: 23rpx; font-weight: 700; white-space: nowrap; }
