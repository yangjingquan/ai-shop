<view class="day page-shell"><view class="hero"><text class="kicker">每月 {{activity.dayOfMonth || '--'}} 日 · 会员专享</text><view class="title">积分会员日</view><view class="sub">{{activity.active ? '今日权益已开启' : (activity.statusText || '敬请期待')}}</view></view><view class="benefits"><view class="benefit"><text class="benefit-icon">倍</text><view><view class="benefit-title">双倍积分</view><view class="benefit-desc">活动时段内下单享双倍积分</view></view></view><view class="benefit"><text class="benefit-icon">券</text><view><view class="benefit-title">会员专享券</view><view class="benefit-desc">精选商品享专属优惠</view></view><button wx:if="{{activity.couponTemplateId && activity.active}}" class="coupon-btn" bindtap="receiveCoupon">立即领取</button></view></view><view class="mall-title">积分兑换好礼 <text bindtap="goMall">全部 ›</text></view><view class="products"><view wx:for="{{items}}" wx:key="id" class="product"><view class="product-name">{{item.title}}</view><view class="product-points">{{item.pointsPrice}} 积分</view></view></view><button class="primary-btn" bindtap="goMall">立即兑换</button><view class="tip">实物好礼纯积分兑换，商家包邮</view></view>
