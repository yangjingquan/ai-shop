<view class="records-page page-shell">
  <view wx:if="{{records.length}}" class="record-list">
    <view wx:for="{{records}}" wx:key="id" class="record-card card" data-item="{{item}}" bindtap="viewRecord">
      <image wx:if="{{item.image}}" class="record-image" src="{{item.image}}" mode="aspectFill" />
      <view wx:else class="record-image placeholder">积</view>
      <view class="record-main">
        <view class="record-title-row"><view class="record-title">{{item.title}}</view><text class="type-tag">{{item.typeText}}</text></view>
        <view class="record-meta">{{item.quantityText}} · {{item.timeText}}</view>
        <view class="record-status">{{item.statusText}}</view>
      </view>
      <view class="record-side"><view class="record-points">{{item.pointsText}}</view><view wx:if="{{item.actionText}}" class="record-action">{{item.actionText}} ›</view></view>
    </view>
  </view>
  <view wx:elif="{{!loading}}" class="empty-state"><view class="empty-title">暂无兑换记录</view><view class="empty-desc">去积分商城兑换一份喜欢的好礼吧</view></view>
  <view wx:if="{{loading && !records.length}}" class="loading-text">加载中...</view>
  <view wx:if="{{records.length && !hasMore}}" class="end-text">没有更多记录了</view>
</view>
