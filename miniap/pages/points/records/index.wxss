.records-page{min-height:100vh;padding:24rpx;background:#f8f5f0}.record-list{display:flex;flex-direction:column;gap:16rpx}.record-card{display:flex;align-items:center;padding:22rpx;min-height:142rpx}.record-image{flex:0 0 auto;width:112rpx;height:112rpx;border-radius:12rpx;background:#f7f0e9}.placeholder{display:flex;align-items:center;justify-content:center;color:#ffb16d;font-size:48rpx;font-weight:800}.record-main{min-width:0;flex:1;margin:0 18rpx}.record-title-row{display:flex;align-items:center;min-width:0}.record-title{overflow:hidden;font-size:28rpx;font-weight:600;text-overflow:ellipsis;white-space:nowrap}.type-tag{flex:0 0 auto;margin-left:10rpx;padding:4rpx 10rpx;border-radius:8rpx;background:#fff1e6;color:#ef5523;font-size:19rpx}.record-meta{margin-top:12rpx;color:#8a9099;font-size:22rpx}.record-status{margin-top:12rpx;color:#646a73;font-size:23rpx}.record-side{flex:0 0 auto;display:flex;flex-direction:column;align-items:flex-end}.record-points{color:#ef5523;font-size:25rpx;font-weight:700;white-space:nowrap}.record-action{margin-top:18rpx;color:#ef5523;font-size:22rpx;white-space:nowrap}.loading-text,.end-text{padding:28rpx;text-align:center;color:#9aa0a6;font-size:23rpx}
