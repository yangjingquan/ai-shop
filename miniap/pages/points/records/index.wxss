.records-page {
  min-height: 100vh;
  padding: 16rpx 0 48rpx;
  background: #fff;
}

.record-list {
  padding: 0 32rpx;
}

.record-card {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-bottom: 20rpx;
  padding: 28rpx;
}

.record-image,
.record-image.placeholder {
  width: 112rpx;
  height: 112rpx;
  border-radius: 28rpx;
  flex: none;
}

.record-image.placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #FFF6D6;
  color: #B07A00;
  font-size: 44rpx;
  font-weight: 900;
}

.record-main {
  flex: 1;
  min-width: 0;
}

.record-title-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.record-title {
  font-size: 28rpx;
  font-weight: 800;
  color: #15161C;
}

.type-tag {
  flex: none;
}

.record-meta {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #9A9EA8;
}

.record-status {
  display: inline-block;
  margin-top: 8rpx;
}

.record-side {
  flex: none;
  text-align: right;
}

.record-points {
  color: #FF4A1C;
  font-size: 32rpx;
  font-weight: 800;
}

.record-action {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #5B5F6B;
}

.loading-text,
.end-text {
  padding: 32rpx;
  text-align: center;
  font-size: 24rpx;
  color: #9A9EA8;
}

.records-page .empty-state2 {
  margin: 48rpx 32rpx 0;
}
