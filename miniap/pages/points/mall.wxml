<view class="mall-page page-shell">
  <view class="page-hero page-hero-gold">
    <view class="hero-blob"></view>
    <view class="points-balance-label">当前可用积分</view>
    <view class="points-balance-value">{{balance}}</view>
    <view class="hero-chip-row">
      <view class="hero-chip hero-chip-on" bindtap="goRecords">兑换记录 ›</view>
      <view class="hero-chip" bindtap="chooseAddress">{{addressId ? '已选地址' : '选择收货地址'}} ›</view>
    </view>
  </view>

  <view class="mall-follow page-body-lift">
  <view class="mall-notice">实物兑换纯积分支付，商家包邮</view>

  <view class="mall-grid page-body">
    <view wx:for="{{items}}" wx:key="id" class="mall-item">
      <image wx:if="{{item.image}}" class="mall-image" src="{{item.image}}" mode="aspectFill" />
      <view wx:else class="mall-image img-placeholder img-placeholder-1">积</view>
      <view class="mall-name">{{item.title}}</view>
      <view class="mall-price">消耗 {{item.pointsPrice}} 积分</view>
      <view class="mall-meta-line">{{item.stockText}} {{item.quotaText}}</view>
      <button
        class="btn btn-sm btn-block mall-redeem-btn {{item.canRedeem ? 'btn-primary' : 'btn-disabled'}}"
        disabled="{{!item.canRedeem || redeemingId === item.id}}"
        bindtap="redeem"
        data-item="{{item}}"
      >{{redeemingId === item.id ? '兑换中' : item.redeemText}}</button>
    </view>

    <view wx:if="{{!items.length}}" class="empty-state2 mall-empty">
      <view class="empty-state2-symbol">积</view>
      <text class="empty-state2-title">暂无可兑换好礼</text>
      <text class="empty-state2-desc">商家正在准备中</text>
    </view>
  </view>
  </view>
</view>
