<view class="mall page-shell"><view class="balance-bar">当前可用积分 <text>{{balance}}</text><view class="address-link" bindtap="chooseAddress">{{addressId ? '已选地址' : '选择收货地址'}} ›</view></view><view class="notice">实物兑换纯积分支付，商家包邮</view><view class="grid"><view wx:for="{{items}}" wx:key="id" class="item card"><image wx:if="{{item.image}}" class="image" src="{{item.image}}" mode="aspectFill"/><view wx:else class="image placeholder">积</view><view class="name">{{item.title}}</view><view class="bottom"><view class="price">消耗 {{item.pointsPrice}} 积分</view><button class="redeem" bindtap="redeem" data-item="{{item}}">兑换</button></view><view class="stock">剩余 {{item.stock}} 件</view></view></view><view wx:if="{{!items.length}}" class="empty-state"><view class="empty-title">暂无可兑换好礼</view><view class="empty-desc">商家正在准备中</view></view></view>
