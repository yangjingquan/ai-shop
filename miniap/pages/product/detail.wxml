<view wx:if="{{ product }}" class="detail page-shell">
  <swiper class="banner" autoplay circular indicator-dots>
    <swiper-item wx:for="{{ banners }}" wx:key="*this">
      <image src="{{ item }}" mode="aspectFill" />
    </swiper-item>
    <swiper-item wx:if="{{ banners.length === 0 }}">
      <view class="banner-empty">
        <image class="empty-icon" src="/assets/icons/empty.png" mode="aspectFit" />
        <text>暂无图片</text>
      </view>
    </swiper-item>
  </swiper>

  <view class="info card">
    <view class="price-block">
      <view class="price">¥ {{ seckillMode ? seckillPriceText : (product.salePriceText || product.minPrice) }}</view>
      <view wx:if="{{ product.hasOriginalPrice }}" class="original-price">¥ {{ product.originalPriceText }}</view>
    </view>
    <view wx:if="{{seckillMode}}" class="seckill-panel">
      <view class="seckill-panel-head"><text>{{product.seckillStatus === 0 ? '即将开始' : product.seckillStatus === 1 ? '秒杀中' : '已结束'}}</text><text>{{product.seckillStartText}} - {{product.seckillEndText}}</text></view>
      <view class="seckill-panel-row"><text>{{seckillLimitText}}</text><text class="seckill-stock">{{seckillRemainingText}}</text></view>
      <view class="seckill-panel-tip">秒杀商品不支持使用优惠券，售完即止</view>
    </view>
    <view wx:if="{{pointsEarnText && !seckillMode}}" class="points-earn-tip">积分权益 · {{pointsEarnText}}<text wx:if="{{memberDayActive}}">，当前商品双倍积分</text></view>
    <view wx:if="{{product.isGroupBuy === 1}}" class="group-buy-panel">
      <view class="group-buy-head"><view class="group-buy-price">¥{{product.groupBuyPriceText}}</view><view class="group-buy-meta">{{product.groupBuyRequiredText}}</view></view>
      <view wx:if="{{groupBuyGroups.length}}" class="active-group-title">正在进行的团</view>
      <view class="group-row" wx:for="{{groupBuyGroups}}" wx:key="id">
        <view class="group-row-info"><view>{{item.leaderText}} <text class="group-progress">{{item.paidCount}}/{{item.requiredCount}}人</text></view><view class="group-row-time">还差{{item.remainingCount}}人 · {{item.expireText}}截止</view></view>
        <button size="mini" data-groupid="{{item.id}}" bindtap="joinGroup">去参团</button>
      </view>
      <view wx:if="{{!groupBuyGroups.length}}" class="group-empty">暂无进行中的团，快来发起第一团</view>
    </view>
    <view class="name">{{ product.name }}</view>
    <view wx:if="{{ product.subtitle }}" class="subtitle">{{ product.subtitle }}</view>
    <view class="meta">
      <text wx:if="{{seckillMode}}">{{product.seckillSoldText}}</text>
      <block wx:else>
        <text>销量 {{ product.totalSales || 0 }}</text>
        <text class="dot">·</text>
        <text>库存 {{ product.totalStock || 0 }}</text>
      </block>
    </view>
    <view wx:if="{{product.bundle}}" class="bundle-entry" bindtap="openBundle">
      <view class="bundle-entry-copy"><view class="bundle-entry-title">推荐搭配，一起买更省</view><view class="bundle-entry-desc">单买合计 ¥{{product.bundle.originalAmountText}}，套餐立减 ¥{{product.bundle.discountAmountText}}</view></view>
      <image class="icon icon-sm arrow" src="/assets/icons/arrow-right.png" mode="aspectFit" />
    </view>
  </view>

  <view class="desc card">
    <view class="desc-title section-title">商品详情</view>
    <view wx:if="{{ product.description }}" class="desc-body">
      <rich-text nodes="{{ product.description }}" />
    </view>
    <view wx:else class="desc-empty">
      <image class="empty-icon" src="/assets/icons/empty.png" mode="aspectFit" />
      <text>暂无详情</text>
    </view>
  </view>

  <view class="bottom-bar {{product.isGroupBuy === 1 ? 'has-group-buy' : ''}} {{seckillMode ? 'has-seckill' : ''}}">
    <button class="cart-tab" bindtap="onCartTab">
      <image class="btn-icon" src="/assets/icons/cart.png" mode="aspectFit" />
      <text>购物车</text>
    </button>
    <button wx:if="{{!seckillMode}}" class="action add-cart" data-action="cart" bindtap="openSku">加入购物车</button>
    <button class="action buy-now" data-action="buy" bindtap="openSku">{{seckillMode ? '立即抢购' : '立即购买'}}</button>
    <button wx:if="{{product.isGroupBuy === 1}}" class="action group-buy" bindtap="openGroupBuySku">发起团购</button>
  </view>

  <view wx:if="{{ skuOpen }}" class="sku-mask" bindtap="closeSku">
    <view class="sku-popup" catchtap="noop">
      <view class="sku-head">
        <image
          class="sku-img"
          src="{{ (selectedSku && selectedSku.image) || product.mainImage }}"
          mode="aspectFill"
          bindtap="previewSkuImage"
          data-url="{{ (selectedSku && selectedSku.image) || product.mainImage }}"
        />
        <view class="sku-meta">
          <view class="price">¥ {{ selectedSku ? selectedSku.priceText : (seckillMode ? seckillPriceText : product.salePriceText) }}</view>
          <view
            wx:if="{{ selectedSku ? selectedSku.hasOriginalPrice : product.hasOriginalPrice }}"
            class="original-price sku-original-price"
          >¥ {{ selectedSku ? selectedSku.originalPriceText : product.originalPriceText }}</view>
          <view class="text">{{ selectedSkuText || '请选择规格' }}</view>
          <view wx:if="{{ selectedSku }}" class="stock">{{seckillMode ? seckillRemainingText : '库存 ' + selectedSku.stock}}</view>
        </view>
        <view class="close" catchtap="closeSku">
          <image class="icon" src="/assets/icons/close.png" mode="aspectFit" />
        </view>
      </view>

      <scroll-view class="sku-body" scroll-y>
        <view wx:for="{{ product.specs }}" wx:key="id" wx:for-item="spec" wx:for-index="si" class="spec-group">
          <view class="spec-name">{{ spec.name }}</view>
          <view class="spec-values">
            <view
              wx:for="{{ spec.values }}"
              wx:key="id"
              wx:for-item="v"
              class="val {{ selectedValueIds[si] === v.id ? 'active' : '' }}"
              bindtap="onSelectVal"
              data-spec-index="{{ si }}"
              data-val-id="{{ v.id }}"
            >
              {{ v.value }}
            </view>
          </view>
        </view>

        <view class="qty-row">
          <text class="label">数量</text>
          <view class="qty">
            <view class="qty-btn" bindtap="onQtyMinus"><image class="icon icon-sm" src="/assets/icons/minus.png" mode="aspectFit" /></view>
            <text class="qty-num">{{ qty }}</text>
            <view class="qty-btn" bindtap="onQtyPlus"><image class="icon icon-sm" src="/assets/icons/plus.png" mode="aspectFit" /></view>
          </view>
        </view>
      </scroll-view>

      <button class="confirm-btn" bindtap="onConfirm" disabled="{{addingCart}}">
        {{addingCart ? '处理中...' : '确定'}}
      </button>
    </view>
  </view>
</view>

<view wx:elif="{{ !loading }}" class="empty-state page-shell">
  <image class="empty-icon" src="/assets/icons/empty.png" mode="aspectFit" />
  <view class="empty-title">商品不存在</view>
</view>
