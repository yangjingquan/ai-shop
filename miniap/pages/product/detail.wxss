.detail {
  padding-bottom: 180rpx;
  background: #F6F6F8;
}
.banner {
  width: auto;
  height: 640rpx;
  margin: 0 32rpx;
  background: #fff;
  border-radius: 0 0 32rpx 32rpx;
  overflow: hidden;
}
.banner image {
  width: 100%;
  height: 100%;
}
.banner-empty {
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  color: #9A9EA8;
  background: linear-gradient(135deg, #EDEEF2, #D5D8E0);
}
.info {
  margin: 20rpx 32rpx 0;
  padding: 28rpx 32rpx;
  background: #fff;
  border-radius: 32rpx;
  box-shadow: 0 8rpx 24rpx rgba(20, 22, 28, 0.04);
}
.info .price {
  color: #FF4A1C;
  font-size: 60rpx;
  font-weight: 800;
  font-family: 'DIN Alternate', 'Roboto Condensed', sans-serif;
}
.info .original-price {
  margin-top: 6rpx;
  color: #9A9EA8;
  font-size: 26rpx;
  font-weight: 400;
  text-decoration: line-through;
}
.info .name {
  margin-top: 16rpx;
  font-size: 38rpx;
  font-weight: 900;
  color: #15161C;
  line-height: 1.4;
}
.info .subtitle {
  margin-top: 10rpx;
  font-size: 26rpx;
  color: #5B5F6B;
  line-height: 1.5;
}
.info .meta {
  margin-top: 16rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 24rpx;
  color: #9A9EA8;
}
.bundle-entry { margin-top:20rpx; padding:24rpx 28rpx; display:flex; align-items:center; gap:16rpx; border-radius:28rpx; background:#15161C; color:#fff; }.bundle-entry-copy { flex:1; min-width:0; }.bundle-entry-title { color:#fff; font-size:28rpx; font-weight:800; }.bundle-entry-desc { margin-top:6rpx; color:rgba(255,255,255,0.7); font-size:22rpx; }.bundle-entry .arrow { color:#FFD23F; opacity:1; }
.group-buy-panel {
  margin-top: 20rpx;
  padding: 24rpx;
  border-radius: 28rpx;
  background: linear-gradient(145deg, #E7F0FF, #fff);
}
.seckill-panel { margin-top: 20rpx; padding: 28rpx; border-radius: 28rpx; color: #fff; background: linear-gradient(135deg, #FF4A1C, #FF8A00); box-shadow: 0 12rpx 28rpx rgba(255, 74, 28, 0.24); }
.seckill-panel-head, .seckill-panel-row { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.seckill-panel-head text:first-child { font-size: 36rpx; font-weight: 900; }
.seckill-panel-head text:last-child { font-size: 24rpx; opacity: .9; }
.seckill-panel-row { margin-top: 20rpx; font-size: 26rpx; }
.seckill-stock { font-size: 32rpx; font-weight: 900; }
.seckill-panel-tip { margin-top: 16rpx; padding-top: 16rpx; border-top: 2rpx solid rgba(255,255,255,.25); font-size: 22rpx; opacity: .9; }
.points-earn-tip { margin-top:20rpx; padding:20rpx 24rpx; border-radius:24rpx; color:#B07A00; background:linear-gradient(90deg,#FFF6D6,#FFF); font-size:24rpx; line-height:1.5; font-weight:600; }
.group-buy-price {
  color: #3D7BFF;
  font-size: 44rpx;
  font-weight: 900;
  font-family: 'DIN Alternate', 'Roboto Condensed', sans-serif;
}
.group-buy-head { display: flex; align-items: baseline; justify-content: space-between; }.active-group-title { margin-top: 24rpx; color: #15161C; font-size: 28rpx; font-weight: 800; }.group-empty { margin-top: 20rpx; color: #9A9EA8; font-size: 24rpx; }.group-row-info { flex: 1; min-width: 0; }.group-progress { margin-left: 12rpx; color: #3D7BFF; font-weight: 800; }.group-row-time { margin-top: 6rpx; color: #9A9EA8; font-size: 22rpx; }
.group-buy-meta {
  margin-top: 10rpx;
  color: #5B5F6B;
  font-size: 24rpx;
}
.group-row {
  margin-top: 16rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: #333;
  font-size: 26rpx;
}
.group-row button {
  margin: 0;
  background: #ef5523;
  color: #fff;
  border-radius: 8rpx;
}
.dot {
  color: #d6dae0;
}

.sku-row {
  margin: 16rpx 24rpx 0;
  padding: 28rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.sku-label {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 12rpx;
  color: #1f2329;
  font-size: 28rpx;
}
.sku-label text {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.sku-label .icon,
.arrow {
  opacity: 0.58;
}

.desc {
  margin: 16rpx 24rpx 0;
  padding: 26rpx 28rpx;
}
.desc-title {
  margin-bottom: 18rpx;
}
.desc-body {
  overflow: hidden;
  font-size: 26rpx;
  color: #1f2329;
  line-height: 1.7;
  overflow-wrap: anywhere;
}
.desc-empty {
  min-height: 220rpx;
  color: #9aa0a6;
  font-size: 26rpx;
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
}
.engagement-summary{display:flex;align-items:center;gap:24rpx;margin-top:24rpx;padding-top:20rpx;border-top:1rpx solid #f0ece7;color:#61656d;font-size:24rpx}.engagement-summary text{color:#f35422}.favorite-entry{margin-left:auto;padding-left:22rpx;border-left:1rpx solid #eee7e1;color:#f35422}.engagement-card{margin-top:20rpx}.section-more{float:right;color:#9aa0a6;font-size:24rpx;font-weight:400}.review-preview,.question-preview{padding:20rpx 0;border-bottom:1rpx solid #f4f1ed;font-size:26rpx;color:#34373d;line-height:1.6}.review-preview:last-child,.question-preview:last-child{border-bottom:0}.stars{color:#f35422;margin-right:16rpx}.review-user{color:#8d9299}.merchant-reply{margin-top:8rpx;padding:12rpx 14rpx;background:#faf7f3;color:#6e6256;font-size:24rpx;border-radius:10rpx}.purchased{margin-left:8rpx;color:#f35422;font-size:22rpx}

.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: rgba(255, 255, 255, 0.96);
  border-top: 1rpx solid #eef0f3;
  padding: 18rpx 24rpx;
  padding-bottom: calc(18rpx + env(safe-area-inset-bottom));
  display: grid;
  grid-template-columns: 124rpx minmax(0, 1fr) minmax(0, 1fr);
  align-items: center;
  gap: 14rpx;
  box-shadow: 0 -8rpx 28rpx rgba(15, 23, 42, 0.06);
  box-sizing: border-box;
}
.bottom-bar.has-group-buy {
  grid-template-columns: 124rpx minmax(0, 1fr) minmax(0, 1fr);
}
.bottom-bar.has-seckill { grid-template-columns: 124rpx minmax(0, 1fr); }
.bottom-bar button {
  width: 100%;
  min-width: 0;
  margin: 0;
  padding: 0;
  border-radius: 18rpx;
  height: 88rpx;
  line-height: normal;
  font-size: 28rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  overflow: hidden;
  white-space: nowrap;
}
.bottom-bar button::after,
.confirm-btn::after {
  border: none;
}
.cart-tab {
  flex-direction: column;
  gap: 4rpx;
  background: #fff;
  color: #9aa0a6;
  font-size: 22rpx;
  line-height: 1.1;
  box-shadow: none;
}
.action {
  color: #111318;
  font-size: 28rpx;
  font-weight: 800;
}
.add-cart {
  background: #ffef68;
}
.buy-now {
  background: #ff5a1f;
  color: #fff;
}
.group-buy {
  background: #ef5523;
  color: #fff;
}
.btn-icon {
  width: 32rpx;
  height: 32rpx;
  opacity: 0.72;
}

.sku-mask {
  position: fixed;
  inset: 0;
  background: rgba(31, 35, 41, 0.48);
  z-index: 100;
  display: flex;
  align-items: flex-end;
}
.sku-popup {
  width: 100%;
  max-width: 100vw;
  background: #fff;
  border-radius: 28rpx 28rpx 0 0;
  max-height: 82vh;
  display: flex;
  flex-direction: column;
  padding-bottom: env(safe-area-inset-bottom);
  box-sizing: border-box;
  overflow: hidden;
}
.sku-head {
  display: flex;
  padding: 44rpx 32rpx 28rpx;
  border-bottom: 1rpx solid #eef0f3;
  position: relative;
}
.sku-img {
  width: 160rpx;
  height: 160rpx;
  flex: 0 0 160rpx;
  border-radius: 16rpx;
  background: #f8f5f0;
  box-shadow: 0 8rpx 24rpx rgba(15, 23, 42, 0.1);
  margin-top: 0;
}
.sku-meta {
  flex: 1;
  min-width: 0;
  margin-left: 24rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
}
.sku-meta .price {
  color: #ef5523;
  font-size: 38rpx;
  font-weight: 700;
}
.sku-meta .original-price {
  margin-top: 4rpx;
  color: #9aa0a6;
  font-size: 24rpx;
  font-weight: 500;
  text-decoration: line-through;
}
.sku-meta .text {
  font-size: 26rpx;
  color: #1f2329;
  margin-top: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.sku-meta .stock {
  font-size: 24rpx;
  color: #9aa0a6;
  margin-top: 6rpx;
}
.sku-head .close {
  position: absolute;
  top: 16rpx;
  right: 20rpx;
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.sku-head .close .icon {
  opacity: 0.52;
}

.sku-body {
  flex: 1;
  width: 100%;
  min-width: 0;
  padding: 20rpx 32rpx;
  max-height: 52vh;
  box-sizing: border-box;
}
.spec-group {
  margin-bottom: 28rpx;
}
.spec-name {
  font-size: 26rpx;
  color: #1f2329;
  font-weight: 600;
  margin-bottom: 16rpx;
}
.spec-values {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.val {
  padding: 13rpx 28rpx;
  border-radius: 12rpx;
  border: 1rpx solid transparent;
  background: #f8f5f0;
  color: #1f2329;
  font-size: 26rpx;
}
.val.active {
  background: #fff7f0;
  color: #ef5523;
  border-color: #ef5523;
  font-weight: 600;
}
.val.disabled {
  background: #f3eee8;
  color: #b7b0aa;
  opacity: .62;
}

.qty-row {
  width: 100%;
  min-width: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  padding: 18rpx 0 8rpx;
  box-sizing: border-box;
  overflow: hidden;
}
.qty-row .label {
  flex: 0 0 auto;
  font-size: 28rpx;
  color: #1f2329;
  font-weight: 600;
}
.qty {
  flex: 0 0 196rpx;
  width: 196rpx;
  max-width: 196rpx;
  min-width: 0;
  display: grid;
  grid-template-columns: 56rpx 60rpx 56rpx;
  align-items: center;
  column-gap: 12rpx;
  box-sizing: border-box;
}
.qty-btn {
  width: 56rpx;
  height: 56rpx;
  background: #f8f5f0;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}
.qty-btn .icon {
  opacity: 0.68;
}
.qty-num {
  width: 60rpx;
  min-width: 0;
  text-align: center;
  font-size: 28rpx;
  color: #1f2329;
  overflow: hidden;
  text-overflow: ellipsis;
}

.confirm-btn {
  width: calc(100% - 48rpx);
  height: 92rpx;
  line-height: normal;
  margin: 18rpx 24rpx 28rpx;
  padding: 0;
  background: #ff5a1f;
  color: #fff;
  border-radius: 18rpx;
  font-size: 32rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
}

.member-day-tip {
  margin-top: 18rpx;
  padding: 14rpx 18rpx;
  border-radius: 14rpx;
  color: #ef5523;
  background: #fff3e7;
  font-size: 24rpx;
  font-weight: 600;
}

.detail { background: #f8f5f0; padding-bottom: 184rpx; }
.banner { height: 680rpx; margin: 0; border-radius: 0 0 32rpx 32rpx; }
.info, .desc { margin: 14rpx 20rpx 0; border-radius: 24rpx; box-shadow: none; }
.info { padding: 28rpx 24rpx; }
.info .price { color: #ef5523; font-size: 54rpx; font-weight: 900; }
.info .name { color: #201f1c; font-size: 36rpx; line-height: 1.28; }
.service-row { display: flex; flex-wrap: wrap; gap: 10rpx; margin-top: 18rpx; padding: 14rpx 16rpx; border-radius: 14rpx; color: #796e65; background: #f8f2ec; font-size: 20rpx; }
.bundle-entry { border-radius: 18rpx; }
.desc { padding: 26rpx 24rpx; }
.bottom-bar { border-top-color: #eee6dc; box-shadow: 0 -8rpx 28rpx rgba(47,31,16,.08); }
.bottom-bar .action { border-radius: 38rpx; }
.bottom-bar .buy-now, .confirm-btn { background: linear-gradient(100deg, #f4511e, #ff7a1a); }
.bottom-bar .add-cart { color: #e94d1b; background: #fff0e7; }
.sku-popup { border-radius: 32rpx 32rpx 0 0; }
.confirm-btn { border-radius: 46rpx; }
