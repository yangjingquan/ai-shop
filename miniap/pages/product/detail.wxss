.detail {
  padding-bottom: 168rpx;
  background: #f7f4ed;
}
.banner {
  width: auto;
  height: 640rpx;
  margin: 0 24rpx;
  background: #fff;
  border-radius: 0 0 20rpx 20rpx;
  overflow: hidden;
}
.banner image {
  width: 100%;
  height: 100%;
}
.banner-empty {
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  color: #9aa0a6;
  background: #f6f7f9;
}
.info {
  margin: 20rpx 24rpx 0;
  padding: 26rpx 28rpx;
}
.info .price {
  color: #ff6600;
  font-size: 46rpx;
  font-weight: 700;
}
.info .original-price {
  margin-top: 4rpx;
  color: #9aa0a6;
  font-size: 24rpx;
  font-weight: 500;
  text-decoration: line-through;
}
.info .name {
  margin-top: 14rpx;
  font-size: 34rpx;
  font-weight: 700;
  color: #1f2329;
  line-height: 1.45;
}
.info .subtitle {
  margin-top: 10rpx;
  font-size: 26rpx;
  color: #646a73;
  line-height: 1.5;
}
.info .meta {
  margin-top: 16rpx;
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: 24rpx;
  color: #9aa0a6;
}
.group-buy-panel {
  margin-top: 18rpx;
  padding: 20rpx;
  border-radius: 8rpx;
  background: #fff7f0;
}
.group-buy-price {
  color: #ff4b43;
  font-size: 34rpx;
  font-weight: 700;
}
.group-buy-meta {
  margin-top: 8rpx;
  color: #666;
  font-size: 24rpx;
}
.group-row {
  margin-top: 16rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: #333;
  font-size: 26rpx;
}
.group-row button {
  margin: 0;
  background: #ff6600;
  color: #fff;
  border-radius: 8rpx;
}
.dot {
  color: #d6dae0;
}

.sku-row {
  margin: 16rpx 24rpx 0;
  padding: 28rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.sku-label {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 12rpx;
  color: #1f2329;
  font-size: 28rpx;
}
.sku-label text {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.sku-label .icon,
.arrow {
  opacity: 0.58;
}

.desc {
  margin: 16rpx 24rpx 0;
  padding: 26rpx 28rpx;
}
.desc-title {
  margin-bottom: 18rpx;
}
.desc-body {
  font-size: 26rpx;
  color: #1f2329;
  line-height: 1.7;
}
.desc-empty {
  min-height: 220rpx;
  color: #9aa0a6;
  font-size: 26rpx;
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
}

.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: rgba(255, 255, 255, 0.96);
  border-top: 1rpx solid #eef0f3;
  padding: 18rpx 24rpx;
  padding-bottom: calc(18rpx + env(safe-area-inset-bottom));
  display: grid;
  grid-template-columns: 124rpx minmax(0, 1fr) minmax(0, 1fr);
  align-items: center;
  gap: 14rpx;
  box-shadow: 0 -8rpx 28rpx rgba(15, 23, 42, 0.06);
  box-sizing: border-box;
}
.bottom-bar.has-group-buy {
  grid-template-columns: 124rpx minmax(0, 1fr) minmax(0, 1fr) minmax(0, 1fr);
}
.bottom-bar button {
  width: 100%;
  min-width: 0;
  margin: 0;
  padding: 0;
  border-radius: 18rpx;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 28rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  overflow: hidden;
  white-space: nowrap;
}
.bottom-bar button::after,
.confirm-btn::after {
  border: none;
}
.cart-tab {
  flex-direction: column;
  gap: 4rpx;
  background: #fff;
  color: #9aa0a6;
  font-size: 22rpx;
  line-height: 1.1;
  box-shadow: none;
}
.action {
  color: #111318;
  font-size: 28rpx;
  font-weight: 800;
}
.add-cart {
  background: #ffef68;
}
.buy-now {
  background: #ff5a1f;
  color: #fff;
}
.group-buy {
  background: #ff6600;
  color: #fff;
}
.btn-icon {
  width: 32rpx;
  height: 32rpx;
  opacity: 0.72;
}

.sku-mask {
  position: fixed;
  inset: 0;
  background: rgba(31, 35, 41, 0.48);
  z-index: 100;
  display: flex;
  align-items: flex-end;
}
.sku-popup {
  width: 100%;
  max-width: 100vw;
  background: #fff;
  border-radius: 28rpx 28rpx 0 0;
  max-height: 82vh;
  display: flex;
  flex-direction: column;
  padding-bottom: env(safe-area-inset-bottom);
  box-sizing: border-box;
  overflow: hidden;
}
.sku-head {
  display: flex;
  padding: 44rpx 32rpx 28rpx;
  border-bottom: 1rpx solid #eef0f3;
  position: relative;
}
.sku-img {
  width: 160rpx;
  height: 160rpx;
  flex: 0 0 160rpx;
  border-radius: 16rpx;
  background: #f6f7f9;
  box-shadow: 0 8rpx 24rpx rgba(15, 23, 42, 0.1);
  margin-top: 0;
}
.sku-meta {
  flex: 1;
  min-width: 0;
  margin-left: 24rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
}
.sku-meta .price {
  color: #ff6600;
  font-size: 38rpx;
  font-weight: 700;
}
.sku-meta .original-price {
  margin-top: 4rpx;
  color: #9aa0a6;
  font-size: 24rpx;
  font-weight: 500;
  text-decoration: line-through;
}
.sku-meta .text {
  font-size: 26rpx;
  color: #1f2329;
  margin-top: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.sku-meta .stock {
  font-size: 24rpx;
  color: #9aa0a6;
  margin-top: 6rpx;
}
.sku-head .close {
  position: absolute;
  top: 16rpx;
  right: 20rpx;
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.sku-head .close .icon {
  opacity: 0.52;
}

.sku-body {
  flex: 1;
  width: 100%;
  min-width: 0;
  padding: 20rpx 32rpx;
  max-height: 52vh;
  box-sizing: border-box;
}
.spec-group {
  margin-bottom: 28rpx;
}
.spec-name {
  font-size: 26rpx;
  color: #1f2329;
  font-weight: 600;
  margin-bottom: 16rpx;
}
.spec-values {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.val {
  padding: 13rpx 28rpx;
  border-radius: 12rpx;
  border: 1rpx solid transparent;
  background: #f6f7f9;
  color: #1f2329;
  font-size: 26rpx;
}
.val.active {
  background: #fff7f0;
  color: #ff6600;
  border-color: #ff6600;
  font-weight: 600;
}

.qty-row {
  width: 100%;
  min-width: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  padding: 18rpx 0 8rpx;
  box-sizing: border-box;
  overflow: hidden;
}
.qty-row .label {
  flex: 0 0 auto;
  font-size: 28rpx;
  color: #1f2329;
  font-weight: 600;
}
.qty {
  flex: 0 0 196rpx;
  width: 196rpx;
  max-width: 196rpx;
  min-width: 0;
  display: grid;
  grid-template-columns: 56rpx 60rpx 56rpx;
  align-items: center;
  column-gap: 12rpx;
  box-sizing: border-box;
}
.qty-btn {
  width: 56rpx;
  height: 56rpx;
  background: #f6f7f9;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}
.qty-btn .icon {
  opacity: 0.68;
}
.qty-num {
  width: 60rpx;
  min-width: 0;
  text-align: center;
  font-size: 28rpx;
  color: #1f2329;
  overflow: hidden;
  text-overflow: ellipsis;
}

.confirm-btn {
  width: 520rpx;
  height: 92rpx;
  line-height: 92rpx;
  margin: 18rpx auto 28rpx;
  padding: 0;
  background: #ff5a1f;
  color: #fff;
  border-radius: 46rpx;
  font-size: 32rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
}
