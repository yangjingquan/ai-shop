.address-page {
  min-height: 100vh;
  padding: 0 32rpx calc(160rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: #F6F6F8;
}

.address-list {
  padding-top: 24rpx;
}

.addr-card {
  margin-bottom: 20rpx;
  padding: 28rpx;
}

.addr-top {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
}

.receiver {
  font-size: 32rpx;
  font-weight: 800;
  color: #15161C;
}

.phone {
  font-size: 26rpx;
  color: #5B5F6B;
}

.addr-text {
  margin: 12rpx 0 20rpx;
  font-size: 26rpx;
  color: #5B5F6B;
  line-height: 1.55;
}

.actions {
  display: flex;
  flex-wrap: wrap;
  gap: 32rpx;
  padding-top: 20rpx;
  border-top: 2rpx solid #ECEDF0;
  font-size: 26rpx;
  color: #5B5F6B;
}

.action-danger {
  color: #FF4A1C;
}

.action-default {
  margin-left: auto;
}

.address-empty {
  margin-top: 48rpx;
  padding: 48rpx 28rpx;
}

.address-bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  flex-direction: column;
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  background: #fff;
  box-shadow: 0 -12rpx 40rpx rgba(0, 0, 0, 0.06);
  box-sizing: border-box;
}

.address-add-btn {
  width: 100%;
  height: 96rpx;
  font-size: 32rpx;
  font-weight: 700;
  border-radius: 48rpx;
  background: linear-gradient(90deg, #FF4A1C, #FF8A00);
  color: #fff;
  box-shadow: 0 12rpx 28rpx rgba(255, 74, 28, 0.28);
}
