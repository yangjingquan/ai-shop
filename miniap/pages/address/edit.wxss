.page {
  padding: 24rpx;
}
.form-group {
  padding: 0 24rpx;
  overflow: hidden;
}
.row {
  display: flex;
  align-items: center;
  min-height: 104rpx;
  border-bottom: 1rpx solid #ECEDF0;
}
.row:last-child {
  border-bottom: none;
}
.row.col {
  flex-direction: column;
  align-items: stretch;
  padding: 24rpx 0;
}
.col-head {
  display: flex;
  align-items: center;
}
.field-icon {
  width: 30rpx;
  height: 30rpx;
  margin-right: 12rpx;
  opacity: 0.58;
}
.label {
  width: 142rpx;
  font-size: 28rpx;
  color: #15161C;
  font-weight: 500;
}
.input {
  flex: 1;
  font-size: 28rpx;
  color: #15161C;
}
.value {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  color: #15161C;
}
.placeholder {
  color: #9A9EA8;
}
.arrow {
  width: 28rpx;
  height: 28rpx;
  opacity: 0.38;
}
.textarea {
  width: 100%;
  margin-top: 18rpx;
  font-size: 28rpx;
  min-height: 140rpx;
  color: #15161C;
  line-height: 1.5;
}
.submit-btn {
  margin-top: 48rpx;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: normal;
  background: linear-gradient(90deg, #FF4A1C, #FF8A00);
  color: #fff;
  border-radius: 48rpx;
  font-size: 32rpx;
  font-weight: 700;
  box-sizing: border-box;
  box-shadow: 0 12rpx 28rpx rgba(255, 74, 28, 0.28);
}
