<view class="address-page page-shell">
  <view class="address-list">
    <block wx:for="{{ list }}" wx:key="id">
      <view class="addr-card card" bindtap="onSelect" data-id="{{ item.id }}">
        <view class="addr-top">
          <text class="receiver">{{ item.receiver }}</text>
          <text class="phone">{{ item.phone }}</text>
          <text wx:if="{{ item.isDefault }}" class="tag tag-solid">默认</text>
        </view>
        <view class="addr-text">{{ item.region }} {{ item.detail }}</view>
        <view class="actions">
          <text class="action" catchtap="onEdit" data-id="{{ item.id }}">✎ 编辑</text>
          <text class="action action-danger" catchtap="onDelete" data-id="{{ item.id }}">🗑 删除</text>
          <text wx:if="{{ !item.isDefault }}" class="action action-default" catchtap="onSetDefault" data-id="{{ item.id }}">◎ 设默认</text>
        </view>
      </view>
    </block>
  </view>

  <view wx:if="{{ list.length === 0 }}" class="empty-state2 card address-empty">
    <view class="empty-state2-symbol">址</view>
    <text class="empty-state2-title">暂无地址</text>
    <text class="empty-state2-desc">点击下方添加收货地址</text>
  </view>

  <view class="address-bottom-bar">
    <button class="btn btn-primary btn-block address-add-btn" bindtap="onAdd">＋ 新增地址</button>
  </view>
</view>
