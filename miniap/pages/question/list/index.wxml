<view class="page-shell"><view class="ask-card"><textarea value="{{content}}" maxlength="500" placeholder="向商家提问" bindinput="input"/><view class="ask-actions"><text bindtap="toggle">{{anonymous?'☑':'☐'}} 匿名提问</text><button size="mini" bindtap="ask">提交</button></view></view><view wx:for="{{items}}" wx:key="id" class="card row"><view>{{item.content}} <text wx:if="{{item.purchased}}" class="tag">已购</text></view><view wx:if="{{item.answer}}" class="reply">商家：{{item.answer}}</view><view wx:else class="pending">等待商家回复</view></view></view>
