.question-page {
  min-height: 100vh;
  padding: 28rpx 0 48rpx;
  background: #fff;
}

.question-body {
  padding: 0 32rpx;
}

.ask-card {
  margin-bottom: 20rpx;
  padding: 28rpx;
}

.ask-textarea {
  min-height: 160rpx;
}

.ask-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 20rpx;
}

.ask-submit {
  height: 60rpx;
  padding: 0 36rpx;
  font-size: 26rpx;
}

.qa-card {
  margin-bottom: 20rpx;
  padding: 28rpx;
}

.qa-question {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
}

.qa-content {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  font-weight: 700;
  color: #15161C;
  line-height: 1.45;
}

.qa-answer {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  margin-top: 16rpx;
}

.qa-answer-text {
  flex: 1;
  font-size: 26rpx;
  color: #5B5F6B;
  line-height: 1.55;
}

.qa-pending {
  margin-top: 16rpx;
}
