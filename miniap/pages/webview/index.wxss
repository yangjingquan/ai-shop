.webview-placeholder {
  min-height: 100vh;
  padding: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.placeholder-card {
  width: 100%;
  min-height: 560rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  border: 4rpx dashed #D5D8E0;
  text-align: center;
}

.placeholder-title {
  font-size: 32rpx;
  font-weight: 800;
  color: #15161C;
}

.placeholder-desc {
  font-size: 24rpx;
  color: #9A9EA8;
  line-height: 1.5;
}
