.coupon-page {
  min-height: 100vh;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
}

.coupon-chips {
  display: flex;
  flex-direction: row;
  gap: 16rpx;
  margin-top: 24rpx;
  padding-bottom: 8rpx;
  white-space: nowrap;
}

.coupon-chips .hero-chip {
  flex: none;
}

.coupon-body {
  margin-top: 8rpx;
}

.coupon-card {
  display: flex;
  align-items: stretch;
  margin-bottom: 20rpx;
  border-radius: 32rpx;
  background: #fff;
  box-shadow: 0 8rpx 36rpx rgba(20, 22, 28, 0.04);
  overflow: hidden;
  position: relative;
}

.coupon-card::before,
.coupon-card::after {
  content: '';
  position: absolute;
  left: 176rpx;
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  background: #F6F6F8;
}

.coupon-card::before {
  top: -16rpx;
}

.coupon-card::after {
  bottom: -16rpx;
}

.coupon-card-off {
  opacity: 0.82;
}

.coupon-left {
  width: 192rpx;
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(160deg, #FF4A1C, #FF8A00);
  color: #fff;
  font-weight: 900;
}

.coupon-card-off .coupon-left {
  background: #C9CCD3;
}

.coupon-yuan {
  font-size: 28rpx;
  margin-right: 4rpx;
}

.coupon-amount {
  font-size: 64rpx;
  line-height: 1;
}

.coupon-mid {
  flex: 1;
  min-width: 0;
  padding: 24rpx 16rpx 24rpx 20rpx;
}

.coupon-name {
  font-size: 28rpx;
  font-weight: 800;
  color: #15161C;
}

.coupon-line {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #9A9EA8;
}

.coupon-expiry {
  margin-top: 6rpx;
  font-size: 22rpx;
  font-weight: 700;
  color: #FF4A1C;
}

.coupon-reason {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #9A9EA8;
}

.coupon-action {
  display: flex;
  align-items: center;
  padding-right: 20rpx;
}

.coupon-action .btn-sm {
  height: 60rpx;
  padding: 0 24rpx;
  font-size: 24rpx;
  pointer-events: none;
}
