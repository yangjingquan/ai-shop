.topic-page { min-height: 100vh; padding-bottom: 40rpx; color: #2d2722; background: #f8f5f0; }
.topic-loading, .topic-empty { min-height: 70vh; display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 36rpx; text-align: center; }
.loading-label { margin-top: 20rpx; color: #897e73; font-size: 24rpx; }
.loading-spinner { width: 48rpx; height: 48rpx; border: 5rpx solid #eadfd4; border-top-color: #ef5523; border-radius: 50%; animation: spin .8s linear infinite; }
@keyframes spin { to { transform: rotate(360deg); } }
.topic-content { padding-bottom: 28rpx; }
.topic-cover, .topic-cover-placeholder { display: block; width: 100%; height: 420rpx; object-fit: cover; }
.topic-cover-placeholder { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 16rpx; color: #fff; background: linear-gradient(135deg, #3b2a20, #c86736); }
.topic-cover-kicker { font-size: 22rpx; letter-spacing: 3rpx; opacity: .8; }
.topic-cover-title { max-width: 80%; font-size: 42rpx; text-align: center; font-weight: 800; }
.topic-intro { position: relative; margin: -28rpx 24rpx 0; padding: 28rpx; border-radius: 18rpx; background: #fff; box-shadow: 0 10rpx 28rpx rgba(39, 27, 16, .08); }
.topic-title { font-size: 38rpx; line-height: 1.3; font-weight: 850; }
.topic-summary { margin-top: 10rpx; color: #786e65; font-size: 24rpx; line-height: 1.65; }
.topic-block { margin: 18rpx 24rpx 0; padding: 26rpx; border-radius: 16rpx; background: #fff; }
.block-title { margin-bottom: 14rpx; font-size: 30rpx; line-height: 1.4; font-weight: 800; }
.block-body { color: #554d45; font-size: 26rpx; line-height: 1.8; white-space: pre-wrap; }
.content-image { display: block; width: 100%; max-height: 660rpx; margin: 8rpx 0 16rpx; border-radius: 12rpx; }
.product-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14rpx; }
.product-card { min-width: 0; padding: 12rpx; border: 1rpx solid #eee7e0; border-radius: 12rpx; background: #fff; }
.topic-product-image, .product-placeholder { display: block; width: 100%; height: 230rpx; border-radius: 8rpx; background: #f1ece6; }
.topic-product-image { object-fit: contain; }
.product-name { overflow: hidden; margin-top: 12rpx; font-size: 24rpx; text-overflow: ellipsis; white-space: nowrap; }
.product-price { margin-top: 8rpx; color: #e75220; font-size: 28rpx; font-weight: 800; }
.products-empty { padding: 30rpx; color: #92877d; text-align: center; font-size: 23rpx; }
.button-block { padding: 6rpx; }
.topic-button, .home-button { height: 78rpx; display: flex; align-items: center; justify-content: center; margin: 0; border: 0; border-radius: 14rpx; color: #fff; background: #e95d25; font-size: 27rpx; font-weight: 700; }
.home-button { width: 320rpx; margin-top: 32rpx; }
.empty-title { font-size: 32rpx; font-weight: 800; }
.empty-copy { margin-top: 12rpx; color: #81776e; font-size: 24rpx; line-height: 1.6; }
.topic-end { margin-top: 30rpx; color: #aa9e92; text-align: center; font-size: 21rpx; }
