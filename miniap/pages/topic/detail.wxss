.topic-page {
  min-height: 100vh;
  padding-bottom: 48rpx;
}

.topic-state {
  min-height: 70vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 48rpx 32rpx;
  text-align: center;
}

.loading-label {
  margin-top: 20rpx;
  color: #9A9EA8;
  font-size: 24rpx;
}

.loading-spinner {
  width: 48rpx;
  height: 48rpx;
  border: 5rpx solid #ECEDF0;
  border-top-color: #FF4A1C;
  border-radius: 50%;
  animation: topic-spin 0.8s linear infinite;
}

@keyframes topic-spin {
  to { transform: rotate(360deg); }
}

.topic-home-btn {
  margin-top: 28rpx;
  min-width: 240rpx;
}

.topic-banner {
  display: block;
  width: calc(100% - 64rpx);
  height: 440rpx;
  margin: 0 32rpx;
  border-radius: 44rpx;
  object-fit: cover;
}

.topic-banner-placeholder {
  position: relative;
  overflow: hidden;
  background: linear-gradient(135deg, #2B2E3A, #FF4A1C);
}

.topic-banner-blob {
  position: absolute;
  right: -60rpx;
  top: -60rpx;
  width: 360rpx;
  height: 360rpx;
  border-radius: 100rpx;
  background: rgba(255, 255, 255, 0.12);
  transform: rotate(20deg);
}

.topic-banner-inner {
  position: absolute;
  left: 36rpx;
  bottom: 36rpx;
  color: #fff;
}

.topic-banner-title {
  margin-top: 12rpx;
  font-size: 48rpx;
  font-weight: 900;
  line-height: 1.2;
}

.topic-intro {
  position: relative;
  margin: -56rpx 32rpx 0;
  padding: 32rpx;
  z-index: 1;
}

.topic-title {
  font-size: 48rpx;
  font-weight: 900;
  line-height: 1.25;
  color: #15161C;
}

.topic-summary {
  margin-top: 12rpx;
  font-size: 28rpx;
  line-height: 1.7;
  color: #5B5F6B;
}

.topic-block {
  margin: 20rpx 32rpx 0;
  padding: 28rpx;
}

.block-title {
  margin-bottom: 12rpx;
  font-size: 32rpx;
  font-weight: 800;
  color: #15161C;
}

.block-body {
  font-size: 28rpx;
  line-height: 1.8;
  color: #5B5F6B;
  white-space: pre-wrap;
}

.content-image {
  display: block;
  width: 100%;
  max-height: 660rpx;
  margin: 16rpx 0;
  border-radius: 24rpx;
}

.product-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 20rpx;
}

.product-card {
  min-width: 0;
}

.topic-product-image {
  display: block;
  width: 100%;
  height: 260rpx;
  border-radius: 24rpx;
}

.product-name {
  margin-top: 12rpx;
  font-size: 26rpx;
  font-weight: 700;
  color: #15161C;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.product-price {
  margin-top: 8rpx;
  font-size: 32rpx;
}

.products-empty {
  padding: 32rpx;
  text-align: center;
  font-size: 24rpx;
  color: #9A9EA8;
}

.topic-cta {
  width: 100%;
}

.button-block {
  padding: 0;
}
