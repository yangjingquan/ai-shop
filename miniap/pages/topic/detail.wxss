.topic-page {
  min-height: 100vh;
  background: #F6F6F8;
}

.topic-state {
  min-height: 70vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 48rpx 32rpx;
  text-align: center;
}

.loading-label {
  margin-top: 20rpx;
  color: #9A9EA8;
  font-size: 24rpx;
}

.loading-spinner {
  width: 48rpx;
  height: 48rpx;
  border: 5rpx solid #ECEDF0;
  border-top-color: #FF4A1C;
  border-radius: 50%;
  animation: topic-spin 0.8s linear infinite;
}

@keyframes topic-spin {
  to { transform: rotate(360deg); }
}

.topic-home-btn {
  margin-top: 28rpx;
  min-width: 240rpx;
}

.topic-content {
  padding: 24rpx 24rpx 0;
  box-sizing: border-box;
}

.topic-cover-card {
  border-radius: 32rpx;
  overflow: hidden;
  background: #fff;
  box-shadow: 0 8rpx 36rpx rgba(20, 22, 28, 0.06);
}

.topic-cover-media {
  position: relative;
  width: 100%;
  padding-top: 56.25%;
  overflow: hidden;
  background: #ECEDF0;
}

.topic-cover-image,
.topic-cover-placeholder {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.topic-cover-placeholder {
  background: linear-gradient(135deg, #2B2E3A, #FF4A1C);
}

.topic-cover-blob {
  position: absolute;
  right: -60rpx;
  top: -60rpx;
  width: 360rpx;
  height: 360rpx;
  border-radius: 100rpx;
  background: rgba(255, 255, 255, 0.12);
  transform: rotate(20deg);
}

.topic-cover-shade {
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, rgba(21, 22, 28, 0.08) 0%, rgba(21, 22, 28, 0.55) 72%, rgba(21, 22, 28, 0.72) 100%);
  pointer-events: none;
}

.topic-cover-copy {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1;
  padding: 28rpx 32rpx 32rpx;
  color: #fff;
  box-sizing: border-box;
}

.topic-cover-title {
  margin-top: 8rpx;
  font-size: 44rpx;
  font-weight: 900;
  line-height: 1.2;
  letter-spacing: -0.5rpx;
}

.topic-cover-summary {
  margin-top: 12rpx;
  font-size: 26rpx;
  line-height: 1.55;
  color: rgba(255, 255, 255, 0.9);
  display: -webkit-box;
  overflow: hidden;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.topic-body {
  margin-top: 32rpx;
}

.topic-block {
  margin-top: 20rpx;
  padding: 28rpx;
  box-sizing: border-box;
}

.topic-block:first-child {
  margin-top: 0;
}

.block-title {
  margin-bottom: 12rpx;
  font-size: 32rpx;
  font-weight: 800;
  color: #15161C;
}

.block-body {
  font-size: 28rpx;
  line-height: 1.8;
  color: #5B5F6B;
  white-space: pre-wrap;
}

.content-image {
  display: block;
  width: 100%;
  max-height: 660rpx;
  margin: 16rpx 0;
  border-radius: 24rpx;
}

.topic-products-head {
  margin: 0 0 20rpx;
}

.products-block {
  padding-bottom: 8rpx;
}

.topic-product-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 20rpx;
}

.topic-product-card {
  min-width: 0;
  overflow: hidden;
  border-radius: 28rpx;
  background: #fff;
  box-shadow: 0 8rpx 24rpx rgba(20, 22, 28, 0.04);
}

.topic-product-media {
  position: relative;
  width: 100%;
  padding-top: 100%;
  background: #fff;
}

.topic-product-image {
  position: absolute;
  inset: 0;
  display: block;
  width: 100%;
  height: 100%;
}

.topic-product-info {
  padding: 18rpx 20rpx 22rpx;
  background: #fff;
}

.topic-product-name {
  min-height: 72rpx;
  color: #15161C;
  font-size: 26rpx;
  line-height: 36rpx;
  font-weight: 700;
  overflow: hidden;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.topic-product-foot {
  margin-top: 14rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.topic-product-price {
  flex: 1;
  min-width: 0;
  font-size: 34rpx;
  color: #FF4A1C;
}

.topic-product-add {
  flex-shrink: 0;
  width: 52rpx;
  height: 52rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  color: #FF4A1C;
  background: #FFF1EB;
  font-size: 36rpx;
  line-height: 1;
  font-weight: 500;
}

.products-empty {
  padding: 32rpx 16rpx;
  text-align: center;
  font-size: 24rpx;
  color: #9A9EA8;
}

.topic-cta {
  width: 100%;
}

.button-block {
  padding: 0;
}

.topic-bottom-spacer {
  width: 100%;
  height: 24rpx;
  height: calc(24rpx + constant(safe-area-inset-bottom));
  height: calc(24rpx + env(safe-area-inset-bottom));
  flex-shrink: 0;
}
