<view class="page-shell"><view class="card"><view class="title">为商品评分</view><view class="stars"><text wx:for="{{[1,2,3,4,5]}}" wx:key="*this" data-value="{{item}}" bindtap="pick" class="{{item<=rating?'active':''}}">★</text></view><textarea value="{{content}}" maxlength="1000" placeholder="分享一下你的使用感受吧" bindinput="input"/><view class="check" bindtap="toggle">{{anonymous?'☑':'☐'}} 匿名评价</view><button class="primary-btn" loading="{{submitting}}" bindtap="submit">发布评价</button></view></view>
