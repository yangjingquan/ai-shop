.review-edit-page {
  min-height: 100vh;
  padding: 32rpx 0 48rpx;
  background: #fff;
}

.review-edit-body {
  padding: 0 32rpx;
}

.review-form {
  padding: 40rpx 32rpx 36rpx;
  text-align: center;
}

.form-title {
  font-size: 36rpx;
  font-weight: 800;
  color: #15161C;
}

.star-row {
  margin: 24rpx 0 28rpx;
  font-size: 76rpx;
  letter-spacing: 16rpx;
  line-height: 1;
}

.star {
  color: #D5D8E0;
}

.star-on {
  color: #FFD23F;
}

.review-textarea {
  margin-top: 8rpx;
  text-align: left;
}

.review-form .check-row {
  justify-content: flex-start;
  margin: 28rpx 0 32rpx;
}

.submit-btn {
  margin-top: 8rpx;
}
