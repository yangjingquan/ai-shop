.promotion-page{min-height:100vh;padding:24rpx 24rpx 160rpx;background:#f7f4ed;box-sizing:border-box}.hero{padding:42rpx 32rpx 38rpx;border-radius:20rpx;color:#fff;background:linear-gradient(135deg,#ff7b34,#ff4b16);box-shadow:0 16rpx 30rpx rgba(239,86,21,.22)}.hero-kicker{font-size:19rpx;letter-spacing:.12em;opacity:.82}.hero-title{margin-top:10rpx;font-size:56rpx;line-height:1;font-weight:950}.hero-desc{margin-top:14rpx;font-size:24rpx;font-weight:700;opacity:.9}.activity-list{margin-top:20rpx}.activity-card{margin-bottom:16rpx;padding:26rpx}.activity-head{display:flex;align-items:flex-start;justify-content:space-between}.activity-name{color:#17191f;font-size:30rpx;font-weight:900}.activity-type{margin-top:8rpx;color:#a66b48;font-size:22rpx;font-weight:700}.priority{padding:7rpx 12rpx;border-radius:10rpx;color:#e85a1d;background:#fff0e7;font-size:20rpx;font-weight:800}.rules{display:flex;flex-wrap:wrap;gap:12rpx;margin-top:22rpx}.rule{padding:12rpx 16rpx;border-radius:12rpx;color:#e85318;background:#fff4ec;font-size:24rpx;font-weight:850}.activity-note{margin-top:20rpx;color:#8b8e97;font-size:21rpx}.empty{margin-top:20rpx;padding:48rpx;text-align:center;color:#8b8e97;font-size:25rpx}.shop-btn{position:fixed;right:24rpx;bottom:calc(24rpx + env(safe-area-inset-bottom));left:24rpx;height:84rpx;margin:0;border-radius:18rpx;color:#fff;background:#ff5b17;font-size:30rpx;font-weight:900;line-height:84rpx}
