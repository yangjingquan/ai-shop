.promotion-page {
  min-height: 100vh;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
}

.activity-card {
  margin-bottom: 20rpx;
  padding: 28rpx;
}

.activity-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.activity-name {
  font-size: 32rpx;
  font-weight: 800;
  color: #15161C;
}

.rules {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin: 24rpx 0 16rpx;
}

.rule-pill {
  padding: 12rpx 24rpx;
  border-radius: 20rpx;
  background: linear-gradient(90deg, #FF4A1C, #FF8A00);
  color: #fff;
  font-size: 26rpx;
  font-weight: 800;
}

.activity-note {
  font-size: 24rpx;
  color: #9A9EA8;
}

.empty-card {
  padding: 48rpx 28rpx;
  text-align: center;
}

.empty-card-text {
  font-size: 26rpx;
  color: #9A9EA8;
}

.promotion-cta {
  margin-top: 24rpx;
}
