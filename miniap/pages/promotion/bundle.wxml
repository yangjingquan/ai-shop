<view class="bundle-page page-shell" wx:if="{{bundle}}">
  <view class="bundle-banner"><image class="banner-icon" src="/assets/icons/package.png" mode="aspectFit" /><view><view class="banner-title">{{bundle.name}}</view><view class="banner-subtitle">自由选择搭配，固定套餐优惠</view></view></view>
  <view class="section card">
    <view class="section-title"><text class="title-mark"></text>主商品</view>
    <view class="product-row main-row"><image class="product-img" src="{{bundle.mainProductImage}}" mode="aspectFill" /><view class="product-copy"><view class="product-name">{{bundle.mainProductName}}</view><view class="sku-label">选择规格</view><scroll-view scroll-x class="sku-scroll"><view class="sku-list"><view wx:for="{{bundle.mainSkus}}" wx:key="id" class="sku-chip {{mainSkuId === item.id ? 'active' : ''}}" data-skuid="{{item.id}}" bindtap="chooseMainSku">{{item.specText || '默认规格'}}</view></view></scroll-view></view></view>
  </view>
  <view class="section card">
    <view class="section-title"><text class="title-mark"></text>自由选择 <text class="section-tip">可取消非必选商品</text></view>
    <view wx:for="{{bundle.items}}" wx:key="productId" wx:for-index="itemIndex" class="item-row {{item.checked ? '' : 'unchecked'}}">
      <view class="check-box {{item.checked ? 'checked' : ''}}" data-index="{{itemIndex}}" bindtap="toggleItem"><image wx:if="{{item.checked}}" src="/assets/icons/check-primary.png" mode="aspectFit" /></view>
      <image class="item-img" src="{{item.mainImage}}" mode="aspectFill" />
      <view class="item-copy"><view class="product-name">{{item.productName}}</view><view class="item-price">¥{{item.skus[0].price}}</view><scroll-view scroll-x class="sku-scroll"><view class="sku-list"><view wx:for="{{item.skus}}" wx:key="id" wx:for-index="skuIndex" class="sku-chip small {{item.selectedSkuId === item.id ? 'active' : ''}}" data-index="{{itemIndex}}" data-skuid="{{item.id}}" bindtap="chooseItemSku">{{item.specText || '默认规格'}}</view></view></scroll-view></view>
    </view>
  </view>
  <view class="price-card card" wx:if="{{preview}}"><view><view class="price-label">套餐价</view><view class="single-price">单买合计 ¥{{preview.originalAmount}}</view></view><view class="price-right"><view class="bundle-price">¥{{preview.payAmount}}</view><view class="saving">已省 ¥{{preview.bundleDiscountAmount}}</view></view></view>
  <view class="bottom-bar"><button class="cart-btn" data-action="cart" bindtap="submit" disabled="{{submitting}}">加入购物车</button><button class="buy-btn" data-action="buy" bindtap="submit" disabled="{{submitting}}">去结算</button></view>
</view>
<view wx:elif="{{!loading}}" class="empty-state page-shell"><view class="empty-title">套餐已下架</view><view class="empty-desc">返回商品详情页重新查看</view></view>
