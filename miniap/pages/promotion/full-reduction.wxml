<view class="promotion-page page-shell">
  <view class="page-hero page-hero-primary">
    <view class="hero-blob"></view>
    <view class="hero-kicker">SHOP MORE · SAVE MORE</view>
    <view class="hero-heading">满减满折</view>
    <view class="hero-desc">多买多省，优惠自动计算</view>
  </view>

  <view class="page-body">
    <view wx:if="{{activities.length}}" class="activity-list">
      <view wx:for="{{activities}}" wx:key="id" class="activity-card card">
        <view class="activity-head">
          <view>
            <view class="activity-name">{{item.name}}</view>
            <text class="tag">{{item.activityType === 'FULL_DISCOUNT' ? '满折活动' : '满减活动'}}</text>
          </view>
          <text class="st-pill st-pill-gray">优先级 {{item.priority}}</text>
        </view>
        <view class="rules">
          <view wx:for="{{item.rules}}" wx:key="*this" class="rule-pill">{{item}}</view>
        </view>
        <view class="activity-note">适用商品以结算页实时计算结果为准</view>
      </view>
    </view>

    <view wx:elif="{{!loading}}" class="empty-card card">
      <text class="empty-card-text">当前暂无可参与活动</text>
    </view>

    <button class="btn btn-primary btn-lg btn-block promotion-cta" bindtap="goCart">去购物车凑单</button>
  </view>
</view>
