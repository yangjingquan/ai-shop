.bundle-page { padding: 20rpx 24rpx 156rpx; background: #f7f4ed; }.bundle-banner { display:flex; align-items:center; gap:18rpx; padding:24rpx 26rpx; border-radius:18rpx; background:linear-gradient(135deg,#fff1dc,#fff8f0); color:#ff5b1a; }.banner-icon { width:64rpx; height:64rpx; padding:14rpx; box-sizing:border-box; border-radius:18rpx; background:#ff6a24; }.banner-title { font-size:32rpx; font-weight:800; }.banner-subtitle { margin-top:6rpx; color:#b26a3e; font-size:23rpx; }.section { margin-top:18rpx; padding:24rpx; }.section-title { display:flex; align-items:center; gap:10rpx; margin-bottom:18rpx; }.title-mark { width:6rpx; height:30rpx; border-radius:6rpx; background:#ff5a1f; }.section-tip { margin-left:auto; color:#9aa0a6; font-size:22rpx; font-weight:400; }.product-row,.item-row { display:flex; align-items:center; gap:18rpx; padding:18rpx 0; border-bottom:1rpx solid #f0f1f3; }.product-img { width:150rpx; height:150rpx; border-radius:16rpx; background:#f6f7f9; }.item-img { width:112rpx; height:112rpx; border-radius:14rpx; background:#f6f7f9; }.product-copy,.item-copy { flex:1; min-width:0; }.product-name { color:#1f2329; font-size:28rpx; font-weight:600; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }.sku-label { margin-top:12rpx; color:#9aa0a6; font-size:23rpx; }.sku-scroll { width:100%; white-space:nowrap; margin-top:10rpx; }.sku-list { display:flex; gap:12rpx; }.sku-chip { display:inline-flex; align-items:center; min-height:54rpx; padding:0 22rpx; border-radius:12rpx; background:#f6f7f9; color:#646a73; font-size:24rpx; }.sku-chip.active { color:#ff6600; background:#fff1e6; border:1rpx solid #ff6600; }.sku-chip.small { min-height:44rpx; padding:0 16rpx; font-size:22rpx; }.item-price { margin-top:8rpx; color:#ff6600; font-size:28rpx; font-weight:700; }.check-box { width:52rpx; height:42rpx; flex:0 0 52rpx; display:flex; align-items:center; justify-content:center; border:2rpx solid #c9cdd3; border-radius:10rpx; color:#fff; font-size:18rpx; box-sizing:border-box; }.check-box.checked { border-color:#ff5a1f; background:#ff5a1f; }.unchecked { opacity:.56; }.price-card { margin-top:18rpx; padding:24rpx; display:flex; align-items:center; justify-content:space-between; background:#fff8f1; border:1rpx solid #ffd5b4; }.price-label { color:#1f2329; font-size:30rpx; font-weight:700; }.single-price { margin-top:10rpx; color:#646a73; font-size:24rpx; text-decoration:line-through; }.price-right { text-align:right; }.bundle-price { color:#ff5a1f; font-size:42rpx; font-weight:800; }.saving { margin-top:6rpx; color:#2b9b46; font-size:23rpx; }.bottom-bar { position:fixed; left:0; right:0; bottom:0; display:flex; gap:14rpx; padding:18rpx 24rpx calc(18rpx + env(safe-area-inset-bottom)); background:rgba(255,255,255,.98); border-top:1rpx solid #eef0f3; box-shadow:0 -8rpx 28rpx rgba(15,23,42,.06); }.bottom-bar button { flex:1; height:88rpx; border-radius:18rpx; font-size:28rpx; font-weight:700; }.cart-btn { color:#ff6600; background:#fff1e5; }.buy-btn { color:#fff; background:#ff5a1f; }
