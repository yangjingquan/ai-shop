.bundle-page {
  min-height: 100vh;
  padding: 24rpx 32rpx calc(180rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.bundle-banner {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 28rpx;
  border-radius: 32rpx;
  background: linear-gradient(135deg, #FFF1EB, #fff);
  margin-bottom: 20rpx;
}

.banner-icon {
  width: 72rpx;
  height: 72rpx;
}

.banner-title {
  font-size: 34rpx;
  font-weight: 800;
  color: #15161C;
}

.banner-subtitle {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #9A9EA8;
}

.section {
  margin-bottom: 20rpx;
  padding: 28rpx;
}

.section-title {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 20rpx;
  font-size: 32rpx;
  font-weight: 800;
  color: #15161C;
}

.title-mark {
  width: 8rpx;
  height: 32rpx;
  border-radius: 4rpx;
  background: #FF4A1C;
}

.section-tip {
  margin-left: auto;
  font-size: 24rpx;
  font-weight: 400;
  color: #9A9EA8;
}

.product-row {
  display: flex;
  gap: 20rpx;
}

.product-img,
.item-img {
  width: 144rpx;
  height: 144rpx;
  border-radius: 24rpx;
  flex: none;
  background: #F6F6F8;
}

.product-copy,
.item-copy {
  flex: 1;
  min-width: 0;
}

.product-name {
  font-size: 28rpx;
  font-weight: 700;
  color: #15161C;
}

.sku-label {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #9A9EA8;
}

.sku-scroll {
  margin-top: 12rpx;
  white-space: nowrap;
}

.sku-list {
  display: inline-flex;
  gap: 12rpx;
}

.sku-chip {
  display: inline-flex;
  align-items: center;
  height: 68rpx;
  padding: 0 28rpx;
  border-radius: 34rpx;
  background: #F6F6F8;
  font-size: 26rpx;
  color: #15161C;
}

.sku-chip.active {
  background: #FFF1EB;
  color: #FF4A1C;
  font-weight: 800;
  box-shadow: inset 0 0 0 3rpx #FF4A1C;
}

.sku-chip.small {
  height: 60rpx;
  font-size: 24rpx;
}

.item-row {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding: 20rpx 0;
  border-bottom: 2rpx solid #F6F6F8;
}

.item-row:last-child {
  border-bottom: 0;
}

.item-row.unchecked {
  opacity: 0.55;
}

.check-box {
  width: 40rpx;
  height: 40rpx;
  border-radius: 10rpx;
  border: 2rpx solid #C8CBD2;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  margin-top: 8rpx;
}

.check-box.checked {
  background: #FFF1EB;
  border-color: #FF4A1C;
}

.check-box image {
  width: 24rpx;
  height: 24rpx;
}

.item-price {
  margin-top: 8rpx;
  color: #FF4A1C;
  font-weight: 800;
}

.price-card {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  padding: 28rpx;
}

.price-label {
  font-size: 24rpx;
  color: #9A9EA8;
}

.single-price {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #9A9EA8;
  text-decoration: line-through;
}

.bundle-price {
  font-size: 48rpx;
  font-weight: 900;
  color: #FF4A1C;
}

.saving {
  margin-top: 6rpx;
  text-align: right;
  font-size: 24rpx;
  color: #16C47F;
  font-weight: 700;
}

.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  gap: 16rpx;
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  background: #fff;
  box-shadow: 0 -12rpx 40rpx rgba(0, 0, 0, 0.06);
}

.cart-btn,
.buy-btn {
  flex: 1;
  height: 92rpx;
  margin: 0;
  border-radius: 46rpx;
  font-size: 30rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.cart-btn {
  background: #fff;
  color: #15161C;
  border: 2rpx solid #ECEDF0;
}

.buy-btn {
  background: linear-gradient(90deg, #FF4A1C, #FF8A00);
  color: #fff;
  border: 0;
}

.cart-btn::after,
.buy-btn::after {
  border: 0;
}
