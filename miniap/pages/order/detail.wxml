<view class="detail-page" wx:if="{{order}}">
  <view class="address-card card">
    <view class="pin">⌖</view>
    <view class="address-info">
      <view class="receiver-line">{{order.address.receiver}} {{order.address.phone}}</view>
      <view class="address-text">{{order.address.region}} {{order.address.detail}}</view>
    </view>
  </view>

  <view class="items-card card">
    <view class="section-head">
      <view class="merchant-title"><text>{{order.merchantName || '潮选商城'}}</text><text wx:if="{{seckillEnabled && order.orderType === 2}}" class="seckill-order-tag">秒杀订单</text></view>
      <text class="status-text s{{order.status}}">{{order.statusText}}</text>
    </view>

    <view wx:if="{{groupBuyEnabled && order.orderType === 1}}" class="group-info">
      <view>团购进度：{{order.groupBuyProgress}}</view>
      <view wx:if="{{order.groupBuyExpireText}}">有效期至：{{order.groupBuyExpireText}}</view>
      <view wx:if="{{order.groupBuyStatusText}}">团购状态：{{order.groupBuyStatusText}}</view>
      <view wx:if="{{order.status === 7}}">拼团未成团，退款状态请见下方</view>
    </view>
    <view wx:if="{{groupBuyEnabled && order.orderType === 1 && order.groupBuyStatus === 1}}" class="group-result formed-result">
      <view class="group-result-title">✓ 已成团</view><view class="group-result-desc">商品将按正常订单流程发货</view>
    </view>
    <view wx:if="{{groupBuyEnabled && order.orderType === 1 && (order.groupBuyStatus === 2 || order.groupBuyStatus === 3)}}" class="group-result failed-result">
      <view class="group-result-title">× {{order.groupBuyStatus === 3 ? '退款已完成' : '退款处理中'}}</view><view class="group-result-desc">{{order.refundStatusText || '退款状态请稍后刷新查看'}}</view>
    </view>
    <view wx:if="{{order.refundStatusText}}" class="refund-status">{{order.refundStatusText}}</view>
    <view wx:if="{{order.refundReturnShipNo}}" class="refund-status">退货物流：{{order.refundReturnShipCompany}} {{order.refundReturnShipNo}}</view>
    <view wx:if="{{order.refundEvidenceUrls && order.refundEvidenceUrls.length}}" class="refund-evidence">
      <view class="refund-evidence-title">退款凭证</view>
      <view class="refund-evidence-list">
        <image wx:for="{{order.refundEvidenceUrls}}" wx:key="*this" class="refund-evidence-image" src="{{item}}" mode="aspectFill" data-url="{{item}}" bindtap="previewRefundEvidence" />
      </view>
    </view>

    <view
      class="goods"
      wx:for="{{order.items}}"
      wx:key="skuId"
      data-productid="{{item.productId}}"
      bindtap="goProductDetail"
    >
      <image class="thumb" src="{{item.mainImage}}" mode="aspectFill" />
      <view class="goods-info">
        <view class="goods-name">{{item.productName}}</view>
        <view class="goods-spec">{{item.specText}}</view>
        <view class="goods-service">7天无理由退换</view>
      </view>
      <view class="goods-price">
        <text>¥{{item.unitPriceText}}</text>
        <text class="qty">x{{item.quantity}}</text>
      </view>
    </view>
  </view>

  <view wx:if="{{repurchaseEnabled && repurchaseCoupon}}" class="repurchase-card card">
    <view class="repurchase-head"><view><view class="repurchase-title">本单赠送复购券</view><view class="repurchase-sub">下次下单可直接抵扣</view></view><view class="repurchase-state">{{repurchaseCoupon.available ? repurchaseCoupon.expiryText : (repurchaseCoupon.unavailableReason || repurchaseCoupon.statusText)}}</view></view>
    <view class="repurchase-content"><view class="repurchase-price"><text>¥</text>{{repurchaseCoupon.amountText}}</view><view class="repurchase-condition">满{{repurchaseCoupon.thresholdText}}元可用</view><view class="repurchase-action {{repurchaseCoupon.available ? '' : 'disabled'}}" bindtap="goUseRepurchaseCoupon">{{repurchaseCoupon.available ? '去使用' : repurchaseCoupon.statusText}}</view></view>
  </view>

  <view wx:if="{{repurchaseEnabled && repurchaseRecommendations.length}}" class="repurchase-recommend card">
    <view class="recommend-heading"><text>为你推荐</text><text>同类好物，使用复购券更优惠</text></view>
    <view class="recommend-list"><view wx:for="{{repurchaseRecommendations}}" wx:key="id" class="recommend-product" data-productid="{{item.id}}" bindtap="goRepurchaseProduct"><image src="{{item.mainImage}}" mode="aspectFill"/><view class="recommend-product-info"><view>{{item.name}}</view><text>¥{{item.minPriceText}}</text></view><view class="recommend-buy">去选购</view></view></view>
  </view>

  <view class="amount-card card">
    <view class="amount-row">
      <text>商品金额</text>
      <text>¥{{order.totalAmountText}}</text>
    </view>
    <view class="amount-row">
      <text>运费</text>
      <text>¥{{order.freightAmountText}}</text>
    </view>
    <view class="amount-row" wx:if="{{order.discountAmount > 0}}">
      <text>优惠金额</text>
      <text>-¥{{order.discountAmountText}}</text>
    </view>
    <view class="amount-row" wx:if="{{order.couponName}}">
      <text>{{order.couponName}}</text>
      <text>-¥{{order.couponDiscountAmountText}}</text>
    </view>
    <view class="divider"></view>
    <view class="amount-row total">
      <text>{{order.totalLabel}}</text>
      <text>¥{{order.payAmountText}}</text>
    </view>
  </view>

  <view class="order-info card">
    <view class="section-head">
      <text>订单信息</text>
      <text class="muted">复制</text>
    </view>
    <view class="info-row" bindtap="copyOrderNo">
      <text>订单号</text>
      <text>{{order.orderNo}}（点击复制）</text>
    </view>
    <view class="info-row">
      <text>创建时间</text>
      <text>{{order.createdAt}}</text>
    </view>
    <view class="info-row" wx:if="{{order.payTime}}">
      <text>支付时间</text>
      <text>{{order.payTime}}</text>
    </view>
    <view class="info-row" wx:if="{{order.shipTime}}">
      <text>发货时间</text>
      <text>{{order.shipTime}}</text>
    </view>
    <view class="info-row" wx:if="{{order.shipCompany}}">
      <text>物流公司</text>
      <text>{{order.shipCompany}}</text>
    </view>
    <view class="info-row" wx:if="{{order.shipNo}}">
      <text>物流单号</text>
      <text>{{order.shipNo}}</text>
    </view>
    <view class="info-row" wx:if="{{order.finishTime}}">
      <text>完成时间</text>
      <text>{{order.finishTime}}</text>
    </view>
    <view class="info-row" wx:if="{{order.cancelTime}}">
      <text>取消时间</text>
      <text>{{order.cancelTime}}</text>
    </view>
  </view>

  <view wx:if="{{order.shipNo}}" class="logistics-card card">
    <view class="section-head">
      <text>物流跟踪</text>
      <text class="logistics-refresh" bindtap="refreshLogistics">{{logisticsLoading ? '查询中...' : '刷新'}}</text>
    </view>
    <view class="logistics-summary" bindtap="viewLogistics">
      <text class="logistics-state">{{order.logistics.stateText || '点击查看物流轨迹'}}</text>
      <text class="logistics-last">{{order.logistics.lastContent || (order.shipCompany + ' ' + order.shipNo)}}</text>
    </view>
    <view wx:if="{{order.logistics.error}}" class="logistics-error">{{order.logistics.error}}</view>
    <view wx:if="{{order.logistics && order.logistics.traces && order.logistics.traces.length}}" class="logistics-traces">
      <view wx:for="{{order.logistics.traces}}" wx:key="acceptTime" class="logistics-trace">
        <view class="trace-dot"></view>
        <view class="trace-content">
          <view class="trace-station">{{item.acceptStation}}</view>
          <view class="trace-time">{{item.acceptTime}}</view>
        </view>
      </view>
    </view>
    <view wx:elif="{{order.logistics}}" class="logistics-empty">暂无物流轨迹</view>
  </view>

  <view class="actions" wx:if="{{order.status === 0}}">
    <view class="btn" catchtap="cancelOrder">取消订单</view>
    <view class="btn primary" catchtap="payOrder">去支付</view>
  </view>
  <view class="actions" wx:elif="{{order.status === 1}}">
    <view class="btn" catchtap="contactMerchant">联系商家</view>
    <view class="btn dark" catchtap="remindShip">提醒发货</view>
    <view wx:if="{{order.canRefund}}" class="btn" catchtap="refundApply">申请退款</view>
  </view>
  <view class="actions" wx:elif="{{order.status === 5 && groupBuyEnabled}}">
    <button class="btn dark share-btn" open-type="share">邀请参团</button>
    <view class="btn" catchtap="goGroup">查看拼团</view>
  </view>
  <view class="actions" wx:elif="{{order.status === 6}}">
    <view wx:if="{{groupBuyEnabled}}" class="btn" catchtap="goGroup">查看拼团</view>
    <view wx:if="{{order.canRefund}}" class="btn" catchtap="refundApply">申请退款</view>
  </view>
  <view class="actions" wx:elif="{{order.status === 2}}">
    <view class="btn" catchtap="viewLogistics">查看物流</view>
    <view class="btn primary" catchtap="confirmReceive">确认收货</view>
    <view wx:if="{{order.canRefund}}" class="btn" catchtap="refundApply">申请退款</view>
    <view wx:if="{{order.refundStatus === 5}}" class="btn primary" catchtap="submitReturnShipment">填写退货物流</view>
  </view>
  <view class="actions" wx:elif="{{order.status === 3}}">
    <view class="btn" catchtap="viewLogistics">查看物流</view>
    <view class="btn dark" catchtap="buyAgain">再来一单</view>
    <view wx:if="{{order.canRefund}}" class="btn" catchtap="refundApply">申请退款</view>
    <view wx:if="{{order.refundStatus === 5}}" class="btn primary" catchtap="submitReturnShipment">填写退货物流</view>
    <view class="btn danger" catchtap="deleteOrder">删除订单</view>
  </view>
  <view class="actions" wx:elif="{{order.status === 7}}">
    <view wx:if="{{groupBuyEnabled}}" class="btn" catchtap="goGroup">查看拼团</view>
    <view wx:if="{{order.canRefund}}" class="btn primary" catchtap="refundApply">重新申请退款</view>
    <view wx:if="{{order.refundStatus === 5}}" class="btn primary" catchtap="submitReturnShipment">填写退货物流</view>
  </view>
  <view class="actions" wx:elif="{{order.status === 4}}">
    <view class="btn dark" catchtap="buyAgain">再来一单</view>
    <view wx:if="{{order.canRefund}}" class="btn primary" catchtap="refundApply">重新申请退款</view>
    <view class="btn danger" catchtap="deleteOrder">删除订单</view>
  </view>
</view>

<view class="loading-text" wx:else>加载中...</view>
