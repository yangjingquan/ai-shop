<view class="detail-page" wx:if="{{order}}">
  <view class="address-card card">
    <view class="pin">⌖</view>
    <view class="address-info">
      <view class="receiver-line">{{order.address.receiver}} {{order.address.phone}}</view>
      <view class="address-text">{{order.address.region}} {{order.address.detail}}</view>
    </view>
  </view>

  <view class="items-card card">
    <view class="section-head">
      <text>{{order.merchantName || '潮选商城'}}</text>
      <text class="status-text s{{order.status}}">{{order.statusText}}</text>
    </view>

    <view wx:if="{{order.orderType === 1}}" class="group-info">
      <view>团购进度：{{order.groupBuyProgress}}</view>
      <view wx:if="{{order.groupBuyExpireText}}">有效期至：{{order.groupBuyExpireText}}</view>
      <view wx:if="{{order.status === 7}}">拼团失败，等待商家处理退款</view>
    </view>
    <view wx:if="{{order.refundStatusText}}" class="refund-status">{{order.refundStatusText}}</view>

    <view
      class="goods"
      wx:for="{{order.items}}"
      wx:key="skuId"
      data-productid="{{item.productId}}"
      bindtap="goProductDetail"
    >
      <image class="thumb" src="{{item.mainImage}}" mode="aspectFill" />
      <view class="goods-info">
        <view class="goods-name">{{item.productName}}</view>
        <view class="goods-spec">{{item.specText}}</view>
        <view class="goods-service">7天无理由退换</view>
      </view>
      <view class="goods-price">
        <text>¥{{item.unitPriceText}}</text>
        <text class="qty">x{{item.quantity}}</text>
      </view>
    </view>
  </view>

  <view class="amount-card card">
    <view class="amount-row">
      <text>商品金额</text>
      <text>¥{{order.totalAmountText}}</text>
    </view>
    <view class="amount-row">
      <text>运费</text>
      <text>¥{{order.freightAmountText}}</text>
    </view>
    <view class="amount-row" wx:if="{{order.discountAmount > 0}}">
      <text>优惠金额</text>
      <text>-¥{{order.discountAmountText}}</text>
    </view>
    <view class="divider"></view>
    <view class="amount-row total">
      <text>{{order.totalLabel}}</text>
      <text>¥{{order.payAmountText}}</text>
    </view>
  </view>

  <view class="order-info card">
    <view class="section-head">
      <text>订单信息</text>
      <text class="muted">复制</text>
    </view>
    <view class="info-row">
      <text>订单号</text>
      <text>{{order.orderNo}}</text>
    </view>
    <view class="info-row">
      <text>创建时间</text>
      <text>{{order.createdAt}}</text>
    </view>
    <view class="info-row" wx:if="{{order.payTime}}">
      <text>支付时间</text>
      <text>{{order.payTime}}</text>
    </view>
    <view class="info-row" wx:if="{{order.shipTime}}">
      <text>发货时间</text>
      <text>{{order.shipTime}}</text>
    </view>
    <view class="info-row" wx:if="{{order.shipCompany}}">
      <text>物流公司</text>
      <text>{{order.shipCompany}}</text>
    </view>
    <view class="info-row" wx:if="{{order.shipNo}}">
      <text>物流单号</text>
      <text>{{order.shipNo}}</text>
    </view>
    <view class="info-row" wx:if="{{order.finishTime}}">
      <text>完成时间</text>
      <text>{{order.finishTime}}</text>
    </view>
    <view class="info-row" wx:if="{{order.cancelTime}}">
      <text>取消时间</text>
      <text>{{order.cancelTime}}</text>
    </view>
  </view>

  <view class="actions" wx:if="{{order.status === 0}}">
    <view class="btn" catchtap="cancelOrder">取消订单</view>
    <view class="btn primary" catchtap="payOrder">去支付</view>
  </view>
  <view class="actions" wx:elif="{{order.status === 1}}">
    <view class="btn" catchtap="showTodo" data-title="联系商家功能开发中">联系商家</view>
    <view class="btn dark" catchtap="showTodo" data-title="提醒发货功能开发中">提醒发货</view>
    <view wx:if="{{order.canRefund}}" class="btn" catchtap="refundApply">申请退款</view>
  </view>
  <view class="actions" wx:elif="{{order.status === 5}}">
    <button class="btn dark share-btn" open-type="share">邀请参团</button>
    <view class="btn" catchtap="goGroup">查看拼团</view>
  </view>
  <view class="actions" wx:elif="{{order.status === 6}}">
    <view class="btn" catchtap="goGroup">查看拼团</view>
    <view wx:if="{{order.canRefund}}" class="btn" catchtap="refundApply">申请退款</view>
  </view>
  <view class="actions" wx:elif="{{order.status === 2}}">
    <view class="btn" catchtap="viewLogistics">查看物流</view>
    <view class="btn primary" catchtap="confirmReceive">确认收货</view>
    <view wx:if="{{order.canRefund}}" class="btn" catchtap="refundApply">申请退款</view>
  </view>
  <view class="actions" wx:elif="{{order.status === 3}}">
    <view class="btn" catchtap="viewLogistics">查看物流</view>
    <view class="btn dark" catchtap="buyAgain">再来一单</view>
    <view wx:if="{{order.canRefund}}" class="btn" catchtap="refundApply">申请退款</view>
  </view>
  <view class="actions" wx:elif="{{order.status === 7}}">
    <view class="btn" catchtap="goGroup">查看拼团</view>
    <view wx:if="{{order.refundStatus === 2}}" class="btn primary" catchtap="refundApply">重新申请退款</view>
  </view>
</view>

<view class="loading-text" wx:else>加载中...</view>
