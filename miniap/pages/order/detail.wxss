.detail-page {
  min-height: 100vh;
  padding: 16rpx 24rpx 56rpx;
  background: #f7f4ed;
  color: #17191f;
}

.card {
  margin-top: 16rpx;
  padding: 24rpx;
  border-radius: 18rpx;
  background: #fff;
  box-shadow: 0 14rpx 30rpx rgba(50, 44, 36, 0.06);
}

.address-card {
  display: flex;
  align-items: center;
  padding: 20rpx 22rpx;
}

.pin {
  width: 54rpx;
  height: 54rpx;
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 18rpx;
  border-radius: 14rpx;
  color: #17191f;
  background: #c7ff6b;
  font-size: 28rpx;
  font-weight: 900;
}

.address-info {
  flex: 1;
  min-width: 0;
}

.receiver-line {
  color: #17191f;
  font-size: 28rpx;
  line-height: 34rpx;
  font-weight: 900;
}

.address-text {
  margin-top: 6rpx;
  color: #676a73;
  font-size: 23rpx;
  line-height: 30rpx;
  font-weight: 700;
}

.section-head {
  min-height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
  color: #17191f;
  font-size: 24rpx;
  font-weight: 900;
}

.status-text {
  margin-left: 18rpx;
  color: #ff4b43;
  font-size: 23rpx;
  font-weight: 900;
}

.s0,
.s1,
.s2 {
  color: #ff4b43;
}

.s3,
.s4,
.muted {
  color: #8b8e97;
}

.status-text.s5 { color: #f59e0b; }
.status-text.s6 { color: #16a34a; }
.status-text.s7 { color: #dc2626; }

.group-info { margin-top: 16rpx; padding: 20rpx; border-radius: 8rpx; background: #fff7ed; color: #7c2d12; font-size: 26rpx; line-height: 1.6; }

.goods {
  min-height: 144rpx;
  display: flex;
  align-items: center;
  margin-bottom: 18rpx;
}

.goods:last-child {
  margin-bottom: 0;
}

.thumb {
  width: 144rpx;
  height: 144rpx;
  flex: 0 0 auto;
  border-radius: 16rpx;
  background: #f1f3f5;
}

.goods-info {
  flex: 1;
  min-width: 0;
  padding: 0 20rpx;
}

.goods-name {
  color: #17191f;
  font-size: 26rpx;
  line-height: 34rpx;
  font-weight: 900;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.goods-spec,
.goods-service {
  margin-top: 8rpx;
  color: #8b8e97;
  font-size: 22rpx;
  line-height: 30rpx;
  font-weight: 700;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.goods-price {
  align-self: flex-end;
  min-width: 108rpx;
  padding-bottom: 4rpx;
  text-align: right;
  color: #17191f;
  font-size: 25rpx;
  font-weight: 950;
}

.goods-price .qty {
  display: block;
  margin-top: 8rpx;
  color: #8b8e97;
  font-size: 20rpx;
  font-weight: 800;
}

.amount-card {
  overflow: hidden;
}

.amount-row {
  min-height: 50rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: #61646d;
  font-size: 24rpx;
  font-weight: 800;
}

.amount-row text:last-child {
  color: #17191f;
  font-size: 26rpx;
  font-weight: 900;
}

.divider {
  height: 1rpx;
  margin: 16rpx 0;
  background: rgba(23, 25, 31, 0.06);
}

.amount-row.total {
  color: #17191f;
  font-size: 26rpx;
  font-weight: 900;
}

.amount-row.total text:last-child {
  color: #ff4b43;
  font-size: 38rpx;
  font-weight: 950;
}

.share-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 0 24rpx;
  border: 0;
  line-height: 64rpx;
}

.order-info {
  padding: 24rpx;
}

.info-row {
  min-height: 46rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  color: #8b8e97;
  font-size: 23rpx;
  line-height: 32rpx;
  font-weight: 800;
}

.info-row text:last-child {
  flex: 1;
  min-width: 0;
  text-align: right;
  color: #17191f;
  font-weight: 850;
  word-break: break-all;
}

.actions {
  display: flex;
  justify-content: flex-end;
  align-items: center;
  padding: 24rpx 0 0;
}

.btn {
  height: 64rpx;
  min-width: 0;
  flex: 0 0 auto;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  margin-left: 16rpx;
  padding: 0 28rpx;
  border-radius: 16rpx;
  color: #17191f;
  background: #e9e5dc;
  border: 1rpx solid rgba(23, 25, 31, 0.06);
  box-shadow: 0 8rpx 18rpx rgba(50, 44, 36, 0.08);
  font-size: 24rpx;
  line-height: 64rpx;
  font-weight: 900;
  white-space: nowrap;
}

.btn.primary {
  color: #fff;
  background: #ff4b43;
}

.btn.dark {
  color: #fff;
  background: #17191f;
}

.loading-text {
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f7f4ed;
  color: #9aa0a6;
  font-size: 24rpx;
}
