.detail-page {
  min-height: 100vh;
  padding: 16rpx 24rpx 56rpx;
  background: #f7f4ed;
  color: #17191f;
}

.card {
  margin-top: 16rpx;
  padding: 24rpx;
  border-radius: 18rpx;
  background: #fff;
  box-shadow: 0 14rpx 30rpx rgba(50, 44, 36, 0.06);
}

.repurchase-card { border: 1rpx solid #ffd8bc; background: linear-gradient(135deg, #fffaf6, #fff2e8); }
.repurchase-head, .repurchase-content { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.repurchase-title { color: #2d241f; font-size: 27rpx; font-weight: 900; }.repurchase-sub { margin-top: 7rpx; color: #9b745c; font-size: 21rpx; }.repurchase-state { color: #e45d1b; font-size: 21rpx; font-weight: 700; text-align: right; }
.repurchase-content { margin-top: 20rpx; }.repurchase-price { color: #f15e17; font-size: 52rpx; line-height: 1; font-weight: 950; }.repurchase-price text { margin-right: 4rpx; font-size: 25rpx; }.repurchase-condition { flex: 1; color: #754b32; font-size: 23rpx; font-weight: 700; }.repurchase-action { min-width: 104rpx; height: 54rpx; display: flex; align-items: center; justify-content: center; border-radius: 16rpx; color: #fff; background: #ff6600; font-size: 23rpx; font-weight: 800; }.repurchase-action.disabled { color: #9298a0; background: #edf0f2; }
.repurchase-recommend { padding-bottom: 18rpx; }.recommend-heading { display: flex; align-items: baseline; justify-content: space-between; gap: 14rpx; color: #17191f; font-size: 27rpx; font-weight: 900; }.recommend-heading text:last-child { color: #a07860; font-size: 20rpx; font-weight: 700; text-align: right; }.recommend-list { margin-top: 16rpx; }.recommend-product { display: flex; align-items: center; min-height: 114rpx; padding: 12rpx 0; border-top: 1rpx solid rgba(23,25,31,.06); }.recommend-product image { width: 96rpx; height: 96rpx; border-radius: 14rpx; background: #f1f3f5; }.recommend-product-info { flex: 1; min-width: 0; margin-left: 16rpx; color: #292d34; font-size: 24rpx; font-weight: 850; }.recommend-product-info view { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }.recommend-product-info text { display: block; margin-top: 12rpx; color: #ff4b43; font-size: 25rpx; font-weight: 950; }.recommend-buy { margin-left: 12rpx; color: #e45d1b; font-size: 22rpx; font-weight: 800; }

.address-card {
  display: flex;
  align-items: center;
  padding: 20rpx 22rpx;
}

.pin {
  width: 54rpx;
  height: 54rpx;
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 18rpx;
  border-radius: 14rpx;
  color: #17191f;
  background: #c7ff6b;
  font-size: 28rpx;
  font-weight: 900;
}

.address-info {
  flex: 1;
  min-width: 0;
}

.receiver-line {
  color: #17191f;
  font-size: 28rpx;
  line-height: 34rpx;
  font-weight: 900;
}

.address-text {
  margin-top: 6rpx;
  color: #676a73;
  font-size: 23rpx;
  line-height: 30rpx;
  font-weight: 700;
}

.section-head {
  min-height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
  color: #17191f;
  font-size: 24rpx;
  font-weight: 900;
}

.merchant-title { display: flex; align-items: center; gap: 12rpx; min-width: 0; }
.seckill-order-tag { padding: 4rpx 10rpx; border-radius: 8rpx; color: #ff551b; background: #fff0e8; font-size: 20rpx; }

.status-text {
  margin-left: 18rpx;
  color: #ff4b43;
  font-size: 23rpx;
  font-weight: 900;
}

.s0,
.s1,
.s2 {
  color: #ff4b43;
}

.s3,
.s4,
.muted {
  color: #8b8e97;
}

.status-text.s5 { color: #f59e0b; }
.status-text.s6 { color: #16a34a; }
.status-text.s7 { color: #dc2626; }

.group-info { margin-top: 16rpx; padding: 20rpx; border-radius: 8rpx; background: #fff7ed; color: #7c2d12; font-size: 26rpx; line-height: 1.6; }
.group-result { margin-top: 16rpx; padding: 20rpx; border-radius: 14rpx; }
.formed-result { background: #edfff2; color: #159447; }
.failed-result { background: #fff2ef; color: #d83b30; }
.group-result-title { font-size: 28rpx; font-weight: 900; }
.group-result-desc { margin-top: 6rpx; color: #737780; font-size: 23rpx; }
.refund-evidence { margin-top: 16rpx; padding: 18rpx; border-radius: 8rpx; background: #f8fafc; }
.refund-evidence-title { color: #61646d; font-size: 23rpx; font-weight: 800; }
.refund-evidence-list { display: flex; gap: 12rpx; margin-top: 12rpx; flex-wrap: wrap; }
.refund-evidence-image { width: 112rpx; height: 112rpx; border-radius: 8rpx; background: #f1f3f5; }

.goods {
  min-height: 144rpx;
  display: flex;
  align-items: center;
  margin-bottom: 18rpx;
}

.goods:last-child {
  margin-bottom: 0;
}

.thumb {
  width: 144rpx;
  height: 144rpx;
  flex: 0 0 auto;
  border-radius: 16rpx;
  background: #f1f3f5;
}

.goods-info {
  flex: 1;
  min-width: 0;
  padding: 0 20rpx;
}

.goods-name {
  color: #17191f;
  font-size: 26rpx;
  line-height: 34rpx;
  font-weight: 900;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.goods-spec,
.goods-service {
  margin-top: 8rpx;
  color: #8b8e97;
  font-size: 22rpx;
  line-height: 30rpx;
  font-weight: 700;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.goods-price {
  align-self: flex-end;
  min-width: 108rpx;
  padding-bottom: 4rpx;
  text-align: right;
  color: #17191f;
  font-size: 25rpx;
  font-weight: 950;
}

.goods-price .qty {
  display: block;
  margin-top: 8rpx;
  color: #8b8e97;
  font-size: 20rpx;
  font-weight: 800;
}

.amount-card {
  overflow: hidden;
}

.logistics-card { padding-bottom: 20rpx; }
.logistics-refresh { color: #2563eb; font-size: 23rpx; }
.logistics-summary { padding: 16rpx; border-radius: 12rpx; background: #f5f8ff; }
.logistics-state { display: block; color: #17191f; font-size: 26rpx; font-weight: 900; }
.logistics-last { display: block; margin-top: 8rpx; color: #61646d; font-size: 23rpx; line-height: 32rpx; }
.logistics-error { margin-top: 12rpx; color: #b42318; font-size: 23rpx; line-height: 32rpx; }
.logistics-traces { margin-top: 18rpx; padding-left: 10rpx; }
.logistics-trace { display: flex; position: relative; padding: 0 0 22rpx 28rpx; }
.logistics-trace:not(:last-child)::before { content: ''; position: absolute; left: 7rpx; top: 18rpx; bottom: 0; width: 2rpx; background: #d9dee8; }
.trace-dot { position: absolute; left: 0; top: 8rpx; width: 16rpx; height: 16rpx; border-radius: 50%; background: #aeb7c7; }
.logistics-trace:first-child .trace-dot { background: #2563eb; box-shadow: 0 0 0 6rpx #e7efff; }
.trace-content { flex: 1; min-width: 0; }
.trace-station { color: #343842; font-size: 24rpx; line-height: 34rpx; }
.trace-time { margin-top: 6rpx; color: #8b8e97; font-size: 21rpx; }
.logistics-empty { padding: 24rpx 0 8rpx; color: #8b8e97; text-align: center; font-size: 23rpx; }

.amount-row {
  min-height: 50rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: #61646d;
  font-size: 24rpx;
  font-weight: 800;
}

.amount-row text:last-child {
  color: #17191f;
  font-size: 26rpx;
  font-weight: 900;
}

.divider {
  height: 1rpx;
  margin: 16rpx 0;
  background: rgba(23, 25, 31, 0.06);
}

.amount-row.total {
  color: #17191f;
  font-size: 26rpx;
  font-weight: 900;
}

.amount-row.total text:last-child {
  color: #ff4b43;
  font-size: 38rpx;
  font-weight: 950;
}

.share-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 0 24rpx;
  border: 0;
  line-height: normal;
}

.order-info {
  padding: 24rpx;
}

.info-row {
  min-height: 46rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  color: #8b8e97;
  font-size: 23rpx;
  line-height: 32rpx;
  font-weight: 800;
}

.info-row text:last-child {
  flex: 1;
  min-width: 0;
  text-align: right;
  color: #17191f;
  font-weight: 850;
  word-break: break-all;
}

.actions {
  display: flex;
  justify-content: flex-end;
  align-items: center;
  padding: 24rpx 0 0;
}

.btn {
  height: 64rpx;
  min-width: 0;
  flex: 0 0 auto;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  margin-left: 16rpx;
  padding: 0 28rpx;
  border-radius: 18rpx;
  color: #17191f;
  background: #e9e5dc;
  border: 1rpx solid rgba(23, 25, 31, 0.06);
  box-shadow: 0 8rpx 18rpx rgba(50, 44, 36, 0.08);
  font-size: 24rpx;
  line-height: normal;
  font-weight: 900;
  white-space: nowrap;
}

.btn.primary {
  color: #fff;
  background: #ff4b43;
}

.btn.danger {
  color: #fff;
  background: #ff4b43;
}

.btn.dark {
  color: #fff;
  background: #17191f;
}

.loading-text {
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f7f4ed;
  color: #9aa0a6;
  font-size: 24rpx;
}
