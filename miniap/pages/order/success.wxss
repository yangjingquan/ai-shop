.success-page { min-height: 100vh; padding: 42rpx 24rpx 60rpx; background: #f7f4ed; color: #1f2329; box-sizing: border-box; }
.success-head { text-align: center; }
.success-icon { width: 96rpx; height: 96rpx; margin: 0 auto; border-radius: 50%; color: #fff; background: #2fb26b; font-size: 64rpx; line-height: 96rpx; font-weight: 900; }
.success-title { margin-top: 18rpx; font-size: 40rpx; font-weight: 800; letter-spacing: 1rpx; }
.success-subtitle { margin-top: 10rpx; color: #8b8e97; font-size: 24rpx; }
.order-action { margin-top: 34rpx; }
.order-btn { width: 100%; height: 84rpx; margin: 0; padding: 0; border-radius: 18rpx; color: #fff; background: #ff6600; font-size: 29rpx; font-weight: 700; box-shadow: 0 10rpx 20rpx rgba(255, 102, 0, .16); }
.card { margin-top: 20rpx; padding: 26rpx; border: 1rpx solid #eef0f3; border-radius: 16rpx; background: #fff; box-shadow: 0 8rpx 24rpx rgba(15, 23, 42, .04); }
.points-reward-card { display: flex; align-items: center; min-height: 100rpx; box-sizing: border-box; border-color: #ffe0c5; background: #fffaf5; }
.repurchase-card { border-color: #ffd7b5; background: linear-gradient(135deg, #fff9f3, #fff1e5); }
.repurchase-top { display: flex; align-items: center; gap: 12rpx; }
.repurchase-badge { padding: 5rpx 12rpx; border-radius: 10rpx; color: #fff; background: #ff6600; font-size: 20rpx; font-weight: 700; }
.repurchase-title { color: #2d241f; font-size: 29rpx; font-weight: 800; }
.repurchase-main { display: flex; align-items: center; margin-top: 18rpx; }
.repurchase-yuan, .repurchase-amount { color: #f15e17; font-weight: 900; }.repurchase-yuan { font-size: 28rpx; }.repurchase-amount { font-size: 64rpx; line-height: 1; }
.repurchase-info { margin-left: 18rpx; color: #754b32; font-size: 24rpx; font-weight: 650; }.repurchase-expiry { margin-top: 8rpx; color: #e45d1b; font-size: 21rpx; }
.repurchase-btn { width: 100%; height: 68rpx; margin: 20rpx 0 0; padding: 0; border-radius: 16rpx; color: #fff; background: #ff6600; font-size: 25rpx; font-weight: 700; }.repurchase-btn[disabled] { color: #9298a0; background: #edf0f2; }
.reward-icon, .invite-icon { flex: 0 0 auto; display: flex; align-items: center; justify-content: center; width: 60rpx; height: 60rpx; border-radius: 50%; color: #ff6600; background: #fff0e3; font-size: 27rpx; font-weight: 700; }
.points-reward-copy { flex: 1; min-width: 0; margin-left: 18rpx; }
.points-reward-title { color: #2d241f; font-size: 29rpx; font-weight: 700; }
.points-reward-desc { margin-top: 8rpx; color: #a36c49; font-size: 22rpx; }
.points-action { display: flex; align-items: center; gap: 6rpx; margin-left: 18rpx; color: #ff6600; font-size: 24rpx; font-weight: 600; white-space: nowrap; }
.action-arrow { font-size: 32rpx; font-weight: 400; line-height: 1; }
.invite-card { background: #fff; }
.invite-heading { display: flex; align-items: center; }
.invite-copy { min-width: 0; margin-left: 18rpx; }
.invite-title { color: #2d241f; font-size: 29rpx; font-weight: 700; }
.invite-desc { margin-top: 8rpx; color: #8b8e97; font-size: 22rpx; line-height: 1.45; }
.tier-preview { display: flex; gap: 12rpx; margin-top: 22rpx; }
.tier { flex: 1; padding: 12rpx 6rpx; border-radius: 12rpx; color: #8b6a53; background: #fff7ef; text-align: center; font-size: 20rpx; }
.tier text { display: block; }
.tier text:first-child { color: #e45d1b; font-size: 26rpx; font-weight: 700; }
.invite-btn { width: 100%; height: 68rpx; margin: 20rpx 0 0; padding: 0; border: 1rpx solid #ffd1b0; border-radius: 16rpx; color: #e45d1b; background: #fffaf5; font-size: 25rpx; font-weight: 600; }
.footer-actions { margin-top: 22rpx; text-align: center; }
.order-detail-link, .text-btn { display: block; margin: 0 auto; padding: 0; color: #7d838d; background: transparent; font-size: 24rpx; line-height: 1.5; }
.order-detail-link { margin-bottom: 16rpx; color: #ff6600; }
