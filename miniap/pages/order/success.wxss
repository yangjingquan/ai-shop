.success-page {
  min-height: 100vh;
  padding: 48rpx 32rpx 64rpx;
  background: #F6F6F8;
  box-sizing: border-box;
}

.success-head {
  text-align: center;
  padding: 32rpx 0 40rpx;
}

.success-icon {
  width: 120rpx;
  height: 120rpx;
  margin: 0 auto 24rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #16C47F, #7ADB5A);
  color: #fff;
  font-size: 64rpx;
  font-weight: 900;
  line-height: 120rpx;
}

.success-title {
  font-size: 44rpx;
  font-weight: 900;
  color: #15161C;
}

.success-subtitle {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #5B5F6B;
}

.order-action {
  margin-bottom: 24rpx;
}

.order-btn {
  width: 100%;
  height: 96rpx;
  margin: 0;
  border-radius: 48rpx;
  background: linear-gradient(90deg, #FF4A1C, #FF8A00);
  color: #fff;
  font-size: 32rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 12rpx 28rpx rgba(255, 74, 28, 0.28);
}

.order-btn::after {
  border: 0;
}

.repurchase-card,
.points-reward-card,
.lottery-entry,
.invite-card {
  margin-bottom: 20rpx;
  padding: 28rpx;
}

.repurchase-top {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.repurchase-badge {
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  background: #FFD23F;
  color: #15161C;
  font-size: 22rpx;
  font-weight: 800;
}

.repurchase-title {
  font-size: 30rpx;
  font-weight: 800;
}

.repurchase-main {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-top: 20rpx;
}

.repurchase-info {
  flex: 1;
  min-width: 0;
}

.repurchase-yuan {
  font-size: 28rpx;
  color: #FF4A1C;
}

.repurchase-amount {
  font-size: 56rpx;
  font-weight: 900;
  color: #FF4A1C;
}

.repurchase-expiry {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #9A9EA8;
}

.repurchase-btn {
  width: 100%;
  height: 72rpx;
  margin-top: 20rpx;
  border-radius: 36rpx;
  background: #FF4A1C;
  color: #fff;
  font-size: 28rpx;
  font-weight: 700;
}

.points-reward-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.points-reward-copy {
  flex: 1;
  min-width: 0;
}

.reward-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 24rpx;
  background: #FFF6D6;
  color: #B07A00;
  font-size: 36rpx;
  font-weight: 900;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
}

.points-reward-title {
  font-size: 28rpx;
  font-weight: 800;
}

.points-reward-desc {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #9A9EA8;
}

.points-action {
  margin-left: auto;
  color: #FF4A1C;
  font-weight: 700;
}

.lottery-entry {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.lottery-entry-copy {
  flex: 1;
  min-width: 0;
}

.lottery-entry-image {
  width: 112rpx;
  height: 112rpx;
  border-radius: 28rpx;
  flex: none;
}

.lottery-entry-kicker {
  font-size: 20rpx;
  font-weight: 800;
  letter-spacing: 4rpx;
  color: #7B5CFF;
}

.lottery-entry-title {
  font-size: 30rpx;
  font-weight: 800;
}

.lottery-entry-desc {
  font-size: 24rpx;
  color: #9A9EA8;
}

.lottery-entry-arrow {
  margin-left: auto;
  color: #7B5CFF;
  font-weight: 700;
}

.invite-heading {
  display: flex;
  gap: 16rpx;
}

.invite-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 24rpx;
  background: #E6FBF2;
  color: #16C47F;
  font-size: 32rpx;
  font-weight: 900;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
}

.tier-preview {
  display: flex;
  gap: 12rpx;
  margin-top: 20rpx;
}

.tier {
  flex: 1;
  padding: 16rpx;
  border-radius: 20rpx;
  background: #F6F6F8;
  text-align: center;
  font-size: 22rpx;
}

.invite-btn {
  width: 100%;
  height: 88rpx;
  margin-top: 20rpx;
  border-radius: 44rpx;
  background: #15161C;
  color: #fff;
  font-size: 28rpx;
  font-weight: 700;
}

.footer-actions {
  margin-top: 32rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.text-btn,
.order-detail-link {
  background: transparent;
  color: #5B5F6B;
  font-size: 26rpx;
}

.text-btn::after,
.order-detail-link::after {
  border: 0;
}
