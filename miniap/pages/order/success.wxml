<view class="success-page">
  <view class="success-head">
    <view class="success-icon">✓</view>
    <view class="success-title">支付成功</view>
    <view class="success-subtitle">订单已提交，商家将尽快为你发货</view>
  </view>

  <view class="order-action">
    <button wx:if="{{groupId}}" class="order-btn" bindtap="goGroup">查看拼团</button>
    <button wx:else class="order-btn" bindtap="goOrder">查看订单</button>
  </view>

  <view wx:if="{{repurchaseEnabled && repurchaseCoupon}}" class="repurchase-card card">
    <view class="repurchase-top"><view class="repurchase-badge">购后礼</view><view class="repurchase-title">本单复购券已到账</view></view>
    <view class="repurchase-main"><view><text class="repurchase-yuan">¥</text><text class="repurchase-amount">{{repurchaseCoupon.amountText}}</text></view><view class="repurchase-info"><view>满{{repurchaseCoupon.thresholdText}}元可用</view><view class="repurchase-expiry">{{repurchaseCoupon.available ? repurchaseCoupon.expiryText : (repurchaseCoupon.unavailableReason || repurchaseCoupon.statusText)}}</view></view></view>
    <button class="repurchase-btn" disabled="{{!repurchaseCoupon.available}}" bindtap="goUseRepurchaseCoupon">{{repurchaseCoupon.available ? '去使用' : repurchaseCoupon.statusText}}</button>
  </view>

  <view wx:if="{{pointsEnabled}}" class="points-reward-card card" bindtap="goPointsMall">
    <view class="reward-icon">积</view>
    <view class="points-reward-copy">
      <view class="points-reward-title">{{pointsEarned > 0 ? '本单积分已到账' : '积分到账后可兑换好礼'}}</view>
      <view class="points-reward-desc">{{pointsEarned > 0 ? ('本单获得 ' + pointsEarned + ' 积分') : '签到、下单都能积攒积分'}}</view>
    </view>
    <view class="points-action"><text>去兑换</text><text class="action-arrow">›</text></view>
  </view>

  <view wx:if="{{campaign}}" class="invite-card card">
    <view class="invite-heading">
      <view class="invite-icon">邀</view>
      <view class="invite-copy">
        <view class="invite-title">邀请好友，继续得券</view>
        <view class="invite-desc">好友完成首单后，可按邀请阶梯获得店铺券</view>
      </view>
    </view>
    <view class="tier-preview">
      <view wx:for="{{campaign.tiers}}" wx:key="inviteCount" class="tier">
        <text>{{item.inviteCount}} 人</text>
        <text>可得券</text>
      </view>
    </view>
    <button class="invite-btn" bindtap="goInvite">去邀请好友</button>
  </view>

  <view class="footer-actions">
    <button wx:if="{{groupId}}" class="order-detail-link" bindtap="goOrder">查看订单详情</button>
    <button class="text-btn" bindtap="goHome">返回商城</button>
  </view>
</view>
