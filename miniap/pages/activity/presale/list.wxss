.presale-list {
  min-height: 100vh;
  padding: 0 32rpx 64rpx;
  box-sizing: border-box;
}

.presale-hero {
  margin: 0 -32rpx;
  padding-left: 32rpx;
  padding-right: 32rpx;
}

.hero-subline {
  margin-top: 8rpx;
  font-size: 28rpx;
  font-weight: 700;
  opacity: 0.92;
}

.section-title {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
  margin: 32rpx 0 20rpx;
  font-size: 34rpx;
  font-weight: 800;
  color: #15161C;
}

.section-sub {
  font-size: 22rpx;
  font-weight: 600;
  color: #9A9EA8;
}

.activity-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.activity-card {
  padding: 28rpx;
}

.activity-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.activity-kicker {
  font-size: 20rpx;
  font-weight: 800;
  letter-spacing: 4rpx;
  color: #7B5CFF;
}

.activity-name {
  margin-top: 8rpx;
  font-size: 32rpx;
  font-weight: 800;
  color: #15161C;
}

.activity-desc {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #9A9EA8;
}

.phase-chip {
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: #EDE6FF;
  color: #7B5CFF;
  font-size: 22rpx;
  font-weight: 700;
  flex: none;
}

.activity-schedule {
  display: flex;
  gap: 16rpx;
  margin-top: 20rpx;
  padding: 20rpx;
  border-radius: 24rpx;
  background: #F6F6F8;
}

.schedule-item {
  flex: 1;
  min-width: 0;
}

.schedule-item + .schedule-item {
  padding-left: 16rpx;
  border-left: 2rpx solid #ECEDF0;
}

.schedule-label {
  font-size: 22rpx;
  color: #9A9EA8;
}

.schedule-time {
  margin-top: 6rpx;
  font-size: 24rpx;
  font-weight: 700;
  color: #15161C;
}

.product-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-top: 20rpx;
}

.product-item {
  display: flex;
  align-items: center;
  padding: 16rpx;
  border-radius: 24rpx;
  background: #F6F6F8;
}

.product-image {
  width: 132rpx;
  height: 132rpx;
  border-radius: 24rpx;
  flex: none;
}

.product-content {
  flex: 1;
  min-width: 0;
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  min-height: 132rpx;
  padding: 4rpx 0;
}

.product-label {
  font-size: 22rpx;
  color: #9A9EA8;
  font-weight: 700;
}

.product-name {
  margin-top: 6rpx;
  font-size: 28rpx;
  font-weight: 800;
  color: #15161C;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.product-action {
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: #7B5CFF;
  font-size: 24rpx;
  font-weight: 700;
}

.product-action .arrow {
  font-size: 36rpx;
}

.activity-foot {
  display: flex;
  justify-content: space-between;
  margin-top: 20rpx;
  padding-top: 16rpx;
  border-top: 2rpx solid #ECEDF0;
  font-size: 22rpx;
  color: #9A9EA8;
}

.loading-text {
  padding: 48rpx;
  text-align: center;
  color: #9A9EA8;
}
