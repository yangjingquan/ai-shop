page { background:#f8f5f0; }.presale-list { min-height:100vh; padding:24rpx 28rpx 64rpx; box-sizing:border-box; background:#f8f5f0; color:#17191f; }.hero { padding:34rpx 30rpx; border-radius:24rpx; color:#fff; background:linear-gradient(135deg,#211311,#ff5a1f 58%,#ffaf43); box-shadow:0 18rpx 40rpx rgba(230,77,24,.2); }.hero-kicker { font-size:19rpx; letter-spacing:.14em; opacity:.75; }.hero-title { margin-top:20rpx; font-size:48rpx; line-height:1.15; font-weight:950; }.hero-title text { font-size:24rpx; font-weight:700; opacity:.9; }.hero-desc { margin-top:18rpx; font-size:23rpx; opacity:.85; }.section-title { display:flex; align-items:baseline; gap:16rpx; margin:30rpx 4rpx 16rpx; font-size:32rpx; font-weight:950; }.section-sub { color:#9b806a; font-size:20rpx; font-weight:600; }.activity-list { display:flex; flex-direction:column; gap:18rpx; }.activity-card { overflow:hidden; padding:24rpx; border:0; border-radius:22rpx; background:#fff; box-shadow:0 14rpx 32rpx rgba(54,44,32,.08); }.activity-head { display:flex; align-items:flex-start; justify-content:space-between; gap:16rpx; }.activity-heading { min-width:0; flex:1; }.activity-kicker { color:#e45d1b; font-size:18rpx; font-weight:800; letter-spacing:.12em; }.activity-name { overflow:hidden; margin-top:6rpx; color:#2d241f; font-size:30rpx; font-weight:950; text-overflow:ellipsis; white-space:nowrap; }.activity-desc { overflow:hidden; margin-top:8rpx; color:#9b806a; font-size:20rpx; line-height:28rpx; text-overflow:ellipsis; white-space:nowrap; }.phase-chip { flex:0 0 auto; width:max-content; padding:6rpx 12rpx; border-radius:999rpx; color:#e45d1b; background:#fff0e4; font-size:19rpx; font-weight:800; }.activity-schedule { display:flex; gap:10rpx; margin-top:18rpx; padding:14rpx 16rpx; border-radius:14rpx; background:#fff8f1; }.schedule-item { display:flex; min-width:0; flex:1; flex-direction:column; gap:6rpx; }.schedule-item + .schedule-item { padding-left:16rpx; border-left:1rpx solid #f1dfd0; }.schedule-label { color:#a6856c; font-size:18rpx; }.schedule-time { overflow:hidden; color:#5d5149; font-size:20rpx; font-weight:800; text-overflow:ellipsis; white-space:nowrap; }.product-list { display:flex; flex-direction:column; gap:12rpx; margin-top:18rpx; }.product-item { display:flex; align-items:center; min-height:132rpx; padding:12rpx; border:1rpx solid #fff0e3; border-radius:16rpx; background:#fff8f1; box-sizing:border-box; }.product-image { width:132rpx; height:132rpx; flex:0 0 auto; border-radius:12rpx; background:#f1f3f5; }.product-content { display:flex; flex:1; min-width:0; height:132rpx; margin-left:18rpx; flex-direction:column; justify-content:space-between; padding:6rpx 0; box-sizing:border-box; }.product-label { color:#b08c73; font-size:18rpx; font-weight:700; }.product-name { overflow:hidden; margin-top:6rpx; color:#3b3029; font-size:25rpx; font-weight:900; line-height:34rpx; text-overflow:ellipsis; white-space:nowrap; }.product-action { display:flex; align-items:center; justify-content:space-between; color:#e45d1b; font-size:20rpx; font-weight:800; }.product-action .arrow { margin-left:auto; color:#e45d1b; font-size:34rpx; line-height:20rpx; }.activity-foot { display:flex; align-items:center; justify-content:space-between; gap:12rpx; margin-top:18rpx; padding-top:14rpx; border-top:1rpx solid #f5eee8; color:#9b806a; font-size:18rpx; }.activity-foot text:first-child { overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }.loading-text { padding:50rpx; color:#9aa0a6; text-align:center; font-size:24rpx; }
