page { background:#f7f4ed; }.presale-list { min-height:100vh; padding:24rpx 28rpx 64rpx; box-sizing:border-box; background:#f7f4ed; color:#17191f; }.hero { padding:34rpx 30rpx; border-radius:24rpx; color:#fff; background:linear-gradient(135deg,#211311,#ff5a1f 58%,#ffaf43); box-shadow:0 18rpx 40rpx rgba(230,77,24,.2); }.hero-kicker { font-size:19rpx; letter-spacing:.14em; opacity:.75; }.hero-title { margin-top:20rpx; font-size:48rpx; line-height:1.15; font-weight:950; }.hero-title text { font-size:24rpx; font-weight:700; opacity:.9; }.hero-desc { margin-top:18rpx; font-size:23rpx; opacity:.85; }.section-title { display:flex; align-items:baseline; gap:16rpx; margin:30rpx 4rpx 16rpx; font-size:32rpx; font-weight:950; }.section-sub { color:#9b806a; font-size:20rpx; font-weight:600; }.activity-card { display:flex; overflow:hidden; margin-bottom:20rpx; padding:0; border:0; border-radius:22rpx; background:#fff; box-shadow:0 14rpx 32rpx rgba(54,44,32,.08); }.activity-image { width:218rpx; min-height:310rpx; background:#f1f3f5; }.activity-content { flex:1; min-width:0; padding:24rpx 22rpx 20rpx; }.activity-name { color:#2d241f; font-size:30rpx; font-weight:950; }.activity-desc { margin-top:9rpx; color:#9b806a; font-size:21rpx; line-height:30rpx; }.phase-chip { width:max-content; margin-top:16rpx; padding:6rpx 12rpx; border-radius:999rpx; color:#e45d1b; background:#fff0e4; font-size:20rpx; font-weight:800; }.product-preview { margin-top:16rpx; }.product-preview-name { overflow:hidden; color:#5d5149; font-size:21rpx; font-weight:800; text-overflow:ellipsis; white-space:nowrap; }.sku-preview { margin-top:8rpx; padding:16rpx 14rpx; border-radius:14rpx; background:#fff8f1; }.sku-preview + .sku-preview { margin-top:10rpx; }.sku-label { color:#e45d1b; font-size:21rpx; font-weight:800; }.deposit { margin-left:8rpx; color:#f04b18; font-size:34rpx; font-weight:950; }.sku-note { margin-left:8rpx; color:#9b806a; font-size:19rpx; }.sku-balance { margin-top:8rpx; color:#6e6158; font-size:20rpx; }.activity-foot { display:flex; justify-content:space-between; gap:12rpx; margin-top:20rpx; color:#9b806a; font-size:19rpx; }.arrow { color:#e45d1b; font-weight:800; }.loading-text { padding:50rpx; color:#9aa0a6; text-align:center; font-size:24rpx; }
