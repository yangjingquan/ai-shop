<view class="presale-list page-shell">
  <view class="hero"><view class="hero-kicker">NEW PRODUCT PRE-SALE</view><view class="hero-title">新品预售<br/><text>定金膨胀，提前锁定心仪好物</text></view><view class="hero-desc">先付定金锁定需求，尾款支付后按计划发货</view></view>
  <view class="section-title"><text>正在预售</text><text class="section-sub">定金 · 尾款 · 发货全程透明</text></view>
  <view wx:if="{{activities.length}}" class="activity-list"><view wx:for="{{activities}}" wx:key="id" class="activity-card card" data-id="{{item.id}}" bindtap="open"><image class="activity-image" src="{{item.cover}}" mode="aspectFill"/><view class="activity-content"><view class="activity-name">{{item.name}}</view><view class="activity-desc">{{item.description || '新品预售，限量锁定'}}</view><view class="phase-chip">{{item.phaseText}}</view><view class="sku-preview" wx:for="{{item.skus}}" wx:for-item="sku" wx:key="id"><view><text class="sku-label">定金</text><text class="deposit">¥{{sku.depositText}}</text><text class="sku-note">抵 ¥{{sku.depositDeductionAmount}}</text></view><view class="sku-balance">尾款 ¥{{sku.balanceText}}</view></view><view class="activity-foot"><text>预计 {{item.expectedShipAt}} 发货</text><text class="arrow">查看详情</text></view></view></view></view>
  <view wx:elif="{{!loading}}" class="empty-state"><image class="empty-icon" src="/assets/icons/empty.png" mode="aspectFit"/><view class="empty-title">暂无进行中的预售</view><view class="empty-desc">关注首页，下一款新品即将到来</view></view>
  <view wx:if="{{loading}}" class="loading-text">加载中...</view>
</view>
