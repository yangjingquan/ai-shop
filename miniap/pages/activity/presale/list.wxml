<view class="presale-list page-shell">
  <view class="hero"><view class="hero-kicker">NEW PRODUCT PRE-SALE</view><view class="hero-title">新品预售<br/><text>定金膨胀，提前锁定心仪好物</text></view><view class="hero-desc">先付定金锁定需求，尾款支付后按计划发货</view></view>
  <view class="section-title"><text>正在预售</text><text class="section-sub">定金 · 尾款 · 发货全程透明</text></view>
  <view wx:if="{{activities.length}}" class="activity-list"><view wx:for="{{activities}}" wx:key="id" class="activity-card card"><view class="activity-head"><view class="activity-heading"><view class="activity-kicker">新品预售</view><view class="activity-name">{{item.name}}</view><view class="activity-desc">{{item.description || '先付定金锁定需求，尾款支付后按计划发货'}}</view></view><view class="phase-chip">{{item.phaseText}}</view></view><view class="product-list"><view wx:for="{{item.productGroups}}" wx:for-item="product" wx:key="cardKey" class="product-item" data-id="{{product.activityId}}" data-product-id="{{product.productId}}" bindtap="open"><image class="product-image" src="{{product.cover}}" mode="aspectFill"/><view class="product-content"><view><view class="product-label">主产品</view><view class="product-name">{{product.productName}}</view></view><view class="product-action"><text>查看详情</text><text class="arrow">›</text></view></view></view></view><view class="activity-foot"><text>预计 {{item.expectedShipAt}} 发货</text><text>共 {{item.productGroups.length}} 个主产品</text></view></view></view>
  <view wx:elif="{{!loading}}" class="empty-state"><image class="empty-icon" src="/assets/icons/empty.png" mode="aspectFit"/><view class="empty-title">暂无进行中的预售</view><view class="empty-desc">关注首页，下一款新品即将到来</view></view>
  <view wx:if="{{loading}}" class="loading-text">加载中...</view>
</view>
