.confirm-page { min-height: 100vh; padding: 18rpx 24rpx 150rpx; background: #f7f4ed; color: #17191f; }
.card { margin-top: 16rpx; padding: 24rpx; border-radius: 18rpx; background: #fff; box-shadow: 0 14rpx 30rpx rgba(50,44,36,.06); }
.goods-card { display: flex; align-items: center; position: relative; padding: 20rpx; }
.goods-image { width: 150rpx; height: 150rpx; flex: 0 0 auto; border-radius: 16rpx; background: #f1f3f5; }
.goods-info { min-width: 0; flex: 1; margin-left: 18rpx; padding-right: 74rpx; }
.goods-name { color: #17191f; font-size: 27rpx; line-height: 36rpx; font-weight: 900; }
.goods-spec { margin-top: 8rpx; color: #8b8e97; font-size: 22rpx; }
.goods-price { margin-top: 18rpx; color: #ff4b43; font-size: 25rpx; font-weight: 900; }
.goods-price text { display: block; margin-top: 7rpx; color: #8b8e97; font-size: 21rpx; font-weight: 700; }
.quantity-control { position: absolute; right: 20rpx; bottom: 22rpx; display: flex; align-items: center; gap: 14rpx; color: #17191f; font-size: 25rpx; font-weight: 900; }
.quantity-btn { width: 42rpx; height: 42rpx; display: flex; align-items: center; justify-content: center; border-radius: 12rpx; background: #f3f4f6; font-size: 30rpx; }.quantity-btn image { width: 22rpx; height: 22rpx; }
.address-card { display: flex; align-items: center; padding: 20rpx 22rpx; }
.address-icon { width: 54rpx; height: 54rpx; display: flex; align-items: center; justify-content: center; flex: 0 0 auto; margin-right: 18rpx; padding: 12rpx; box-sizing: border-box; border-radius: 14rpx; background: #c7ff6b; }
.address-info { min-width: 0; flex: 1; }.receiver-line { color: #17191f; font-size: 28rpx; font-weight: 900; }.address-text { margin-top: 6rpx; color: #676a73; font-size: 23rpx; line-height: 30rpx; font-weight: 700; }.address-empty { flex: 1; color: #8b8e97; font-size: 25rpx; font-weight: 800; }.arrow { width: 28rpx; height: 28rpx; margin-left: 14rpx; }
.section-title { margin-bottom: 16rpx; color: #17191f; font-size: 27rpx; font-weight: 900; }.amount-row { min-height: 50rpx; display: flex; align-items: center; justify-content: space-between; color: #61646d; font-size: 24rpx; font-weight: 800; }.amount-row text:last-child { color: #17191f; font-size: 26rpx; font-weight: 900; }.amount-row .discount { color: #ff4b43; }.divider { height: 1rpx; margin: 16rpx 0; background: rgba(23,25,31,.06); }.amount-row.total { color: #17191f; font-size: 26rpx; }.amount-row.total text:last-child { color: #ff4b43; font-size: 38rpx; font-weight: 950; }.amount-note { margin-top: 12rpx; padding: 14rpx 16rpx; border-radius: 12rpx; background: #fff5ed; color: #9a5a32; font-size: 21rpx; line-height: 32rpx; }
.rule-line { position: relative; margin-top: 12rpx; padding-left: 26rpx; color: #676a73; font-size: 22rpx; line-height: 32rpx; }.rule-line::before { content: ''; position: absolute; left: 0; top: 12rpx; width: 10rpx; height: 10rpx; border-radius: 50%; background: #ff6b1a; }.agreement { display: flex; align-items: center; margin-top: 24rpx; color: #343842; font-size: 23rpx; font-weight: 800; }.checkbox { width: 34rpx; height: 34rpx; display: flex; align-items: center; justify-content: center; margin-right: 10rpx; border: 2rpx solid #d0d5dc; border-radius: 10rpx; }.checkbox image { width: 22rpx; height: 22rpx; }.checkbox.checked { border-color: #ff5b18; background: #ff5b18; }
.bottom-bar { position: fixed; left: 0; right: 0; bottom: 0; z-index: 10; display: flex; align-items: center; justify-content: space-between; padding: 18rpx 24rpx calc(18rpx + env(safe-area-inset-bottom)); background: rgba(255,255,255,.96); box-shadow: 0 -8rpx 26rpx rgba(30,30,30,.08); }.bottom-label { color: #61646d; font-size: 23rpx; }.bottom-price { margin-left: 8rpx; color: #ff4b43; font-size: 38rpx; font-weight: 950; }.submit-btn { width: 300rpx; height: 78rpx; margin: 0; border: 0; border-radius: 39rpx; color: #fff; background: linear-gradient(90deg, #ff9e08, #ff4b43); font-size: 27rpx; font-weight: 900; line-height: 78rpx; }.submit-btn::after { border: 0; }.submit-btn[disabled] { opacity: .55; }.loading-text { padding: 100rpx 0; color: #8b8e97; text-align: center; font-size: 25rpx; }
