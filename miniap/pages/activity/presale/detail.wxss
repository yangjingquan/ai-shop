.presale-detail {
  min-height: 100vh;
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
  background: #F6F6F8;
  color: #15161C;
}

.cover {
  display: block;
  width: 100%;
  height: 600rpx;
  background: #ECEDF0;
}

.card {
  margin: 20rpx 32rpx 0;
  padding: 28rpx;
  border-radius: 32rpx;
  background: #fff;
  box-shadow: 0 8rpx 36rpx rgba(20, 22, 28, 0.04);
}

.info-card {
  position: relative;
  margin-top: -68rpx;
  border-radius: 44rpx;
  z-index: 1;
}

.tag {
  display: inline-block;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  background: #EDE6FF;
  color: #7B5CFF;
  font-size: 22rpx;
  font-weight: 800;
}

.title {
  margin-top: 16rpx;
  font-size: 40rpx;
  font-weight: 900;
  line-height: 1.25;
  color: #15161C;
}

.desc {
  margin-top: 8rpx;
  font-size: 26rpx;
  line-height: 1.55;
  color: #5B5F6B;
}

.price-panel {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  margin-top: 24rpx;
  padding: 24rpx 28rpx;
  border-radius: 32rpx;
  background: linear-gradient(90deg, #6A4CFF, #FF5CA8);
  color: #fff;
}

.price-label {
  display: block;
  font-size: 22rpx;
  opacity: 0.88;
}

.price {
  display: block;
  margin-top: 4rpx;
  font-size: 56rpx;
  font-weight: 900;
  line-height: 1;
}

.inflation {
  flex: 1;
  text-align: right;
  padding-left: 24rpx;
  border-left: 2rpx solid rgba(255, 255, 255, 0.35);
}

.inflation-title {
  display: block;
  font-size: 26rpx;
  font-weight: 800;
}

.inflation-desc {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  opacity: 0.9;
}

.balance-row {
  display: flex;
  justify-content: space-between;
  margin-top: 20rpx;
  font-size: 24rpx;
  color: #5B5F6B;
}

.balance-final {
  font-weight: 800;
  color: #15161C;
}

.card-header {
  margin-bottom: 20rpx;
  font-size: 32rpx;
  font-weight: 800;
  color: #15161C;
}

.product-group {
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 2rpx solid #ECEDF0;
}

.product-group:first-of-type {
  margin-top: 0;
  padding-top: 0;
  border-top: 0;
}

.product-header {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.product-image {
  width: 104rpx;
  height: 104rpx;
  border-radius: 24rpx;
  flex: none;
  background: #F6F6F8;
}

.product-meta {
  flex: 1;
  min-width: 0;
}

.product-name {
  overflow: hidden;
  font-size: 28rpx;
  font-weight: 800;
  color: #15161C;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.product-sub {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #9A9EA8;
}

.sku-options {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-top: 20rpx;
}

.sku-option {
  padding: 20rpx 24rpx;
  border-radius: 24rpx;
  background: #F6F6F8;
  color: #15161C;
}

.sku-spec {
  display: block;
  font-size: 26rpx;
  font-weight: 700;
}

.sku-price {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #5B5F6B;
}

.sku-option.active {
  background: #EDE6FF;
  box-shadow: inset 0 0 0 3rpx #7B5CFF;
}

.sku-option.active .sku-spec {
  color: #7B5CFF;
}

.timeline {
  margin-top: 8rpx;
}

.timeline-item {
  display: flex;
  gap: 20rpx;
  position: relative;
  padding-bottom: 28rpx;
}

.timeline-item:not(:last-child)::before {
  content: '';
  position: absolute;
  left: 10rpx;
  top: 28rpx;
  bottom: 0;
  width: 4rpx;
  background: #ECEDF0;
}

.dot {
  width: 24rpx;
  height: 24rpx;
  margin-top: 4rpx;
  border-radius: 50%;
  background: #D5D8E0;
  flex: none;
  z-index: 1;
}

.timeline-item.active .dot {
  background: #7B5CFF;
  box-shadow: 0 0 0 8rpx #EDE6FF;
}

.timeline-label {
  display: block;
  font-size: 28rpx;
  font-weight: 800;
  color: #15161C;
}

.timeline-time {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #9A9EA8;
}

.rule {
  position: relative;
  padding-left: 28rpx;
  margin-top: 12rpx;
  font-size: 26rpx;
  line-height: 1.55;
  color: #5B5F6B;
}

.rule::before {
  content: '';
  position: absolute;
  left: 4rpx;
  top: 14rpx;
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #7B5CFF;
}

.rule-strong {
  color: #15161C;
  font-weight: 700;
}

.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 10;
  display: flex;
  align-items: center;
  gap: 20rpx;
  height: calc(156rpx + env(safe-area-inset-bottom));
  padding: 0 32rpx env(safe-area-inset-bottom);
  background: #fff;
  box-shadow: 0 -12rpx 40rpx rgba(0, 0, 0, 0.06);
  box-sizing: border-box;
}

.bottom-amount {
  margin-right: auto;
}

.bottom-label {
  display: block;
  font-size: 24rpx;
  color: #5B5F6B;
}

.bottom-price {
  display: block;
  margin-top: 4rpx;
  font-size: 44rpx;
  font-weight: 900;
  color: #7B5CFF;
}

.primary-btn {
  flex: none;
  min-width: 280rpx;
  height: 92rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 48rpx;
  border-radius: 46rpx;
  background: linear-gradient(90deg, #6A4CFF, #FF5CA8);
  color: #fff;
  font-size: 30rpx;
  font-weight: 800;
}

.loading-state {
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #F6F6F8;
}

.loading-text {
  font-size: 28rpx;
  color: #9A9EA8;
}
