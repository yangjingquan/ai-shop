page{background:#f8f5f0}.presale-detail{min-height:100vh;padding-bottom:150rpx;background:#f8f5f0;color:#17191f}.cover{width:100%;height:520rpx;display:block;background:#eee}.card{margin:18rpx 24rpx 0;padding:24rpx;border-radius:20rpx;background:#fff;box-shadow:0 12rpx 30rpx rgba(50,44,36,.06)}.info-card{margin-top:-34rpx;position:relative}.tag{width:max-content;padding:7rpx 12rpx;border-radius:999rpx;color:#e45d1b;background:#fff0e4;font-size:21rpx;font-weight:800}.title{margin-top:14rpx;color:#2d241f;font-size:38rpx;font-weight:950}.desc{margin-top:9rpx;color:#8f7867;font-size:23rpx;line-height:32rpx}.price-panel{display:flex;align-items:center;justify-content:space-between;gap:20rpx;margin-top:24rpx;padding:20rpx;border-radius:16rpx;background:linear-gradient(135deg,#fff7ed,#fff0df)}.price-label{display:block;color:#9b806a;font-size:22rpx}.price{display:block;margin-top:4rpx;color:#ef4f16;font-size:58rpx;line-height:1;font-weight:950}.inflation{padding-left:20rpx;border-left:1rpx solid #ffd3b1;color:#e45d1b;font-size:23rpx;font-weight:900}.inflation text{display:block}.inflation text+text{margin-top:10rpx;color:#8f6048;font-size:21rpx;font-weight:700}.balance-row{display:flex;justify-content:space-between;margin-top:16rpx;color:#7d6d61;font-size:23rpx}.balance-row text:last-child{color:#e45d1b;font-weight:800}.card-title{color:#2d241f;font-size:28rpx;font-weight:900}.product-group{margin-top:20rpx;padding-top:20rpx;border-top:1rpx solid #f0e7df}.product-group:first-of-type{padding-top:0;border-top:0}.product-header{display:flex;align-items:center;gap:18rpx}.product-image{width:112rpx;height:112rpx;flex:0 0 auto;border-radius:16rpx;background:#f1f3f5}.product-meta{min-width:0;flex:1}.product-name{overflow:hidden;color:#2d241f;font-size:27rpx;font-weight:900;text-overflow:ellipsis;white-space:nowrap}.product-sub{margin-top:8rpx;color:#9b806a;font-size:21rpx}.sku-options{display:flex;flex-wrap:wrap;gap:12rpx;margin-top:18rpx}.sku-option{padding:14rpx 18rpx;border:1rpx solid #eee2d7;border-radius:12rpx;color:#6d625b;background:#fffaf5;font-size:23rpx}.sku-option text{display:block;margin-top:6rpx;color:#e45d1b;font-size:20rpx}.sku-option.active{border-color:#ef5523;color:#e45d1b;background:#fff0e4}.timeline{margin-top:18rpx}.timeline-item{display:flex;position:relative;min-height:78rpx;padding-left:38rpx}.timeline-item:not(:last-child)::before{content:'';position:absolute;left:9rpx;top:18rpx;bottom:0;width:2rpx;background:#f0d7c4}.dot{position:absolute;left:0;top:9rpx;width:20rpx;height:20rpx;border-radius:50%;background:#e8d9ce}.timeline-item.active .dot{background:#ef5523;box-shadow:0 0 0 7rpx #fff0e4}.timeline-item text{display:block}.timeline-item text:first-child{color:#44372f;font-size:24rpx;font-weight:800}.timeline-item text:last-child{margin-top:7rpx;color:#9b806a;font-size:20rpx}.rule{margin-top:12rpx;color:#7d6d61;font-size:22rpx;line-height:32rpx}.rule.strong{color:#e45d1b;font-weight:700}.bottom{position:fixed;z-index:10;left:0;right:0;bottom:0;display:flex;align-items:center;gap:18rpx;padding:18rpx 24rpx calc(18rpx + env(safe-area-inset-bottom));background:#fff;box-shadow:0 -8rpx 24rpx rgba(50,44,36,.08)}.bottom-amount{min-width:150rpx}.bottom-amount text{display:block;color:#9b806a;font-size:20rpx}.bottom-amount text:last-child{margin-top:4rpx;color:#ef4f16;font-size:38rpx;font-weight:950}.primary-btn{flex:1;height:88rpx;display:flex;align-items:center;justify-content:center;border-radius:18rpx;color:#fff;background:#ef5523;font-size:30rpx;font-weight:800}.loading-text{padding:160rpx 0;color:#9aa0a6;text-align:center;font-size:24rpx}
