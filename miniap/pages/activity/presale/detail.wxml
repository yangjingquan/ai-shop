<view wx:if="{{activity && selectedSku}}" class="presale-detail page-shell">
  <image class="cover" src="{{activity.cover}}" mode="aspectFill" />

  <view class="info-card card">
    <view class="tag">新品预售 · {{activity.phaseText}}</view>
    <view class="title">{{activity.name}}</view>
    <view class="desc">{{activity.description || '先付定金锁定需求，尾款支付后按计划发货'}}</view>

    <view class="price-panel">
      <view class="price-panel-left">
        <text class="price-label">定金</text>
        <text class="price">¥{{selectedSku.depositText}}</text>
      </view>
      <view class="inflation">
        <text class="inflation-title">定金膨胀</text>
        <text class="inflation-desc">付 ¥{{selectedSku.depositText}} → 抵 ¥{{selectedSku.deductionText}}</text>
      </view>
    </view>

    <view class="balance-row">
      <text>尾款 ¥{{selectedSku.balanceText}}</text>
      <text class="balance-final">最终实付 ¥{{selectedSku.finalText}}</text>
    </view>
  </view>

  <view class="product-groups card">
    <view class="card-header"><text>选择规格</text></view>
    <view wx:for="{{productGroups}}" wx:for-item="product" wx:key="productId" class="product-group">
      <view class="product-header">
        <image class="product-image" src="{{product.mainImage}}" mode="aspectFill" />
        <view class="product-meta">
          <view class="product-name">{{product.productName}}</view>
          <view class="product-sub">该主产品可选 {{product.skus.length}} 个 SKU</view>
        </view>
      </view>
      <view class="sku-options">
        <view
          wx:for="{{product.skus}}"
          wx:for-item="sku"
          wx:key="id"
          data-sku-id="{{sku.id}}"
          class="sku-option {{selectedSku.id === sku.id ? 'active' : ''}}"
          bindtap="selectSku"
        >
          <text class="sku-spec">{{sku.specText || '默认规格'}}</text>
          <text class="sku-price">定金 ¥{{sku.depositText}} · 尾款 ¥{{sku.balanceText}}</text>
        </view>
      </view>
    </view>
  </view>

  <view class="timeline-card card">
    <view class="card-header"><text>预售时间</text></view>
    <view class="timeline">
      <view class="timeline-item active">
        <view class="dot"></view>
        <view class="timeline-copy">
          <text class="timeline-label">支付定金</text>
          <text class="timeline-time">{{activity.depositStartAt}} - {{activity.depositEndAt}}</text>
        </view>
      </view>
      <view class="timeline-item">
        <view class="dot"></view>
        <view class="timeline-copy">
          <text class="timeline-label">支付尾款</text>
          <text class="timeline-time">{{activity.balanceStartAt}} - {{activity.balanceEndAt}}</text>
        </view>
      </view>
      <view class="timeline-item">
        <view class="dot"></view>
        <view class="timeline-copy">
          <text class="timeline-label">预计发货</text>
          <text class="timeline-time">{{activity.expectedShipAt}}</text>
        </view>
      </view>
    </view>
  </view>

  <view class="rule-card card">
    <view class="card-header"><text>购买须知</text></view>
    <view class="rule">定金：¥{{selectedSku.depositText}}，可抵 ¥{{selectedSku.deductionText}} 尾款。</view>
    <view class="rule">{{activity.depositRefundRule || '尾款支付前可申请退还定金。'}}</view>
    <view class="rule">{{activity.merchantBreachRule || '商家未按期发货时可申请全额退款。'}}</view>
    <view class="rule rule-strong">预售商品不支持混合结算、改规格、转让及其他营销优惠。</view>
  </view>

  <view class="bottom-bar">
    <view class="bottom-amount">
      <text class="bottom-label">定金</text>
      <text class="bottom-price">¥{{selectedSku.depositText}}</text>
    </view>
    <view class="primary-btn" bindtap="startDeposit">{{activity.phase === 1 ? '立即支付定金' : activity.phaseText}}</view>
  </view>
</view>

<view wx:else class="loading-state">
  <text class="loading-text">{{loading ? '加载中...' : '活动不存在'}}</text>
</view>
