.seckill-page {
  width: 100%;
  min-height: 100vh;
  padding-bottom: 48rpx;
  background: #F6F6F8;
  color: #15161C;
  box-sizing: border-box;
}

.seckill-hero {
  padding-bottom: 0;
  color: #fff;
}

.seckill-hd {
  position: relative;
  z-index: 1;
  padding: 12rpx 32rpx 40rpx;
}

.seckill-kicker {
  font-size: 20rpx;
  font-weight: 800;
  letter-spacing: 5rpx;
  color: #FFD23F;
}

.hero-kicker-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.seckill-title {
  margin-top: 8rpx;
  font-size: 56rpx;
  font-weight: 900;
  line-height: 1.2;
  color: #fff;
}

.seckill-subtitle {
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.5;
  opacity: 0.88;
  color: #fff;
}

.seckill-countdown {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 28rpx;
  padding: 24rpx 28rpx;
  border-radius: 32rpx;
  background: rgba(0, 0, 0, 0.18);
}

.seckill-countdown-main {
  flex: 1;
  min-width: 0;
}

.seckill-countdown-label {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: #fff;
}

.seckill-countdown-dot {
  width: 12rpx;
  height: 12rpx;
  margin-left: 12rpx;
  border-radius: 50%;
  background: #FFD23F;
}

.seckill-countdown-value {
  display: block;
  margin-top: 8rpx;
  font-size: 52rpx;
  font-weight: 900;
  font-family: 'DIN Alternate', monospace;
  letter-spacing: 4rpx;
  color: #fff;
}

.seckill-countdown-hint {
  flex: none;
  font-size: 22rpx;
  opacity: 0.85;
  color: #fff;
  white-space: nowrap;
}

.session-chips-row {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: row;
  flex-wrap: nowrap;
  gap: 16rpx;
  padding: 0 32rpx 32rpx;
  overflow-x: auto;
  -webkit-overflow-scrolling: touch;
}

.session-chip {
  flex: 0 0 192rpx;
  width: 192rpx;
  padding: 16rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.15);
  color: #fff;
  text-align: center;
  box-sizing: border-box;
}

.session-chip-active {
  background: #fff;
  color: #FF4A1C;
}

.session-chip-name {
  display: block;
  font-size: 26rpx;
  font-weight: 700;
}

.session-chip-time {
  display: block;
  margin-top: 4rpx;
  font-size: 30rpx;
  font-weight: 900;
}

.session-chip-status {
  display: block;
  margin-top: 4rpx;
  font-size: 20rpx;
  opacity: 0.9;
}

.session-card {
  position: relative;
  z-index: 2;
  margin: -16rpx 32rpx 0;
  padding: 28rpx;
}

.session-card-head {
  margin-bottom: 12rpx;
}

.session-title-line {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
}

.session-label {
  font-size: 32rpx;
  font-weight: 800;
  color: #15161C;
}

.session-live {
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  color: #FF4A1C;
  background: #FFF1EB;
  font-size: 20rpx;
  font-weight: 700;
}

.session-range {
  display: block;
  margin-top: 8rpx;
  color: #9A9EA8;
  font-size: 24rpx;
}

.session-desc {
  display: block;
  margin-top: 12rpx;
  color: #9A9EA8;
  font-size: 24rpx;
  line-height: 1.5;
}

.seckill-product-row {
  display: flex;
  gap: 24rpx;
  padding: 24rpx 0;
  border-top: 1rpx solid #ECEDF0;
}

.seckill-product-row:first-child {
  border-top: 0;
  padding-top: 8rpx;
}

.product-image {
  width: 208rpx;
  height: 208rpx;
  flex: none;
  border-radius: 24rpx;
  background: #F6F6F8;
}

.product-content {
  flex: 1;
  min-width: 0;
}

.product-name {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: #15161C;
  line-height: 1.35;
}

.product-spec {
  display: block;
  margin-top: 6rpx;
  color: #9A9EA8;
  font-size: 24rpx;
}

.product-price-row {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
  margin-top: 8rpx;
}

.product-price {
  display: flex;
  align-items: baseline;
  color: #FF4A1C;
  font-size: 44rpx;
  font-weight: 900;
}

.currency {
  margin-right: 2rpx;
  font-size: 28rpx;
}

.product-original {
  color: #9A9EA8;
  font-size: 24rpx;
  text-decoration: line-through;
}

.stock-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 8rpx;
  font-size: 20rpx;
  color: #9A9EA8;
}

.stock-highlight {
  color: #FF4A1C;
  font-weight: 700;
}

.limit-line {
  margin-left: auto;
}

.stock-track {
  height: 12rpx;
  margin: 12rpx 0 8rpx;
  border-radius: 8rpx;
  background: #FFF1EB;
  overflow: hidden;
}

.stock-fill {
  height: 100%;
  border-radius: 8rpx;
  background: linear-gradient(90deg, #FF8A00, #FF4A1C);
}

.product-cta-row {
  display: flex;
  justify-content: flex-end;
}

.buy-pill {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 160rpx;
  height: 60rpx;
  padding: 0 28rpx;
  border-radius: 30rpx;
  color: #fff;
  background: linear-gradient(90deg, #FF4A1C, #FF8A00);
  font-size: 24rpx;
  font-weight: 700;
}

.buy-pill-disabled {
  background: #E5E6EA;
  color: #A9ACB4;
}

.empty-inner,
.empty-card {
  margin: 24rpx 32rpx 0;
  padding: 72rpx 24rpx;
  text-align: center;
  color: #9A9EA8;
}

.empty-title {
  color: #5B5F6B;
  font-size: 30rpx;
  font-weight: 700;
}

.empty-desc {
  margin-top: 12rpx;
  font-size: 24rpx;
}
