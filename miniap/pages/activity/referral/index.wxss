.referral-page {
  min-height: 100vh;
  padding-bottom: 48rpx;
}

.referral-hero .safe-line {
  display: inline-block;
  margin-top: 24rpx;
  padding: 12rpx 24rpx;
  border-radius: 40rpx;
  background: rgba(255, 255, 255, 0.18);
  font-size: 22rpx;
}

.referral-body {
  padding: 0 32rpx;
  margin-top: -16rpx;
  position: relative;
  z-index: 1;
}

.landing-card,
.progress-card,
.rule-card {
  margin-bottom: 20rpx;
  padding: 28rpx;
}

.landing-kicker {
  font-size: 20rpx;
  font-weight: 800;
  letter-spacing: 4rpx;
  color: #16C47F;
}

.landing-title {
  margin-top: 12rpx;
  font-size: 40rpx;
  font-weight: 900;
  color: #15161C;
}

.landing-desc {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #5B5F6B;
}

.landing-product {
  display: flex;
  gap: 20rpx;
  margin-top: 24rpx;
  padding: 16rpx;
  border-radius: 24rpx;
  background: #F6F6F8;
}

.landing-product image {
  width: 120rpx;
  height: 120rpx;
  border-radius: 20rpx;
}

.landing-product-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: center;
  font-weight: 700;
}

.landing-product-info text {
  margin-top: 8rpx;
  color: #FF4A1C;
  font-size: 32rpx;
  font-weight: 800;
}

.coupon-ticket {
  display: flex;
  margin-top: 24rpx;
  border-radius: 24rpx;
  overflow: hidden;
  background: linear-gradient(90deg, #FF4A1C, #FF8A00);
  color: #fff;
}

.ticket-amount {
  width: 180rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 900;
  border-right: 2rpx dashed rgba(255, 255, 255, 0.4);
}

.ticket-amount text {
  font-size: 56rpx;
}

.ticket-copy {
  flex: 1;
  padding: 24rpx;
  font-weight: 800;
}

.ticket-copy text {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  font-weight: 400;
  opacity: 0.9;
}

.progress-head {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  font-size: 26rpx;
  color: #5B5F6B;
}

.progress-number {
  color: #16C47F;
  font-size: 56rpx;
  font-weight: 900;
}

.muted {
  color: #9A9EA8;
}

.tier-list {
  margin-top: 24rpx;
}

.tier-row {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 2rpx solid #F6F6F8;
}

.tier-dot {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: #ECEDF0;
  color: #9A9EA8;
  font-size: 22rpx;
  font-weight: 800;
  text-align: center;
  line-height: 48rpx;
  flex: none;
}

.tier-row.reached .tier-dot {
  background: #16C47F;
  color: #fff;
}

.tier-copy {
  flex: 1;
  min-width: 0;
  margin-left: 16rpx;
}

.tier-copy text {
  display: block;
}

.tier-copy text:first-child {
  font-weight: 700;
  color: #15161C;
}

.tier-copy text:last-child {
  margin-top: 4rpx;
  font-size: 24rpx;
  color: #9A9EA8;
}

.tier-status {
  font-size: 22rpx;
  color: #9A9EA8;
  font-weight: 700;
}

.next-tip {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #5B5F6B;
}

.share-btn {
  margin-top: 28rpx;
  width: 100%;
}

.secondary-link {
  margin-top: 20rpx;
  text-align: center;
  color: #16C47F;
  font-size: 26rpx;
  font-weight: 600;
}

.rule-row {
  display: flex;
  gap: 16rpx;
  margin-top: 20rpx;
}

.rule-icon {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: #E6FBF2;
  color: #16C47F;
  font-size: 22rpx;
  font-weight: 800;
  text-align: center;
  line-height: 40rpx;
  flex: none;
}

.rule-row view text {
  display: block;
}

.rule-row view text:first-child {
  font-weight: 700;
  color: #15161C;
}

.rule-row view text:last-child {
  margin-top: 4rpx;
  font-size: 24rpx;
  color: #9A9EA8;
}

.foot-note {
  margin-top: 16rpx;
  font-size: 22rpx;
  color: #9A9EA8;
  line-height: 1.5;
  text-align: center;
}
