.referral-page { min-height: 100vh; padding-bottom: 44rpx; background: #f7f4ed; color: #17191f; }
.hero { position: relative; padding: 42rpx 28rpx 34rpx; text-align: center; color: #fff; background: linear-gradient(145deg, #ff6a1f, #ef421a); overflow: hidden; }
.kicker { font-size: 21rpx; letter-spacing: .16em; opacity: .82; }.title { margin-top: 12rpx; font-size: 48rpx; line-height: 1.2; font-weight: 950; }.subtitle { margin-top: 14rpx; font-size: 26rpx; opacity: .92; }.safe-line { display: inline-block; margin-top: 22rpx; padding: 10rpx 20rpx; border-radius: 30rpx; color: #fff8f2; background: rgba(255,255,255,.16); font-size: 22rpx; }.spark { position: absolute; color: #ffd4a8; font-size: 40rpx; }.spark-a { left: 52rpx; top: 34rpx; }.spark-b { right: 58rpx; top: 104rpx; font-size: 28rpx; }
.card { margin: 18rpx 24rpx 0; padding: 26rpx; border-radius: 20rpx; background: #fff; box-shadow: 0 12rpx 28rpx rgba(50,44,36,.06); box-sizing: border-box; }.progress-head { display: flex; align-items: baseline; justify-content: space-between; color: #61646d; font-size: 24rpx; }.progress-number { color: #f4511e; font-size: 58rpx; font-weight: 950; }.muted { color: #9aa0a6; }.tier-list { margin-top: 24rpx; }.tier-row { display: flex; align-items: center; min-height: 76rpx; padding: 10rpx 0; border-bottom: 1rpx solid #f1f2f4; }.tier-row:last-child { border-bottom: 0; }.tier-dot { width: 42rpx; height: 42rpx; flex: 0 0 auto; border-radius: 50%; color: #9aa0a6; background: #f2f3f5; line-height: 42rpx; text-align: center; font-size: 21rpx; font-weight: 800; }.tier-row.reached .tier-dot { color: #fff; background: #2fb26b; }.tier-copy { flex: 1; margin-left: 16rpx; }.tier-copy text { display: block; }.tier-copy text:first-child { color: #17191f; font-size: 27rpx; font-weight: 800; }.tier-copy text:last-child { margin-top: 6rpx; color: #9aa0a6; font-size: 22rpx; }.tier-status { color: #f4511e; font-size: 22rpx; }.next-tip { margin-top: 16rpx; padding: 16rpx; border-radius: 12rpx; color: #a65325; background: #fff5e9; text-align: center; font-size: 23rpx; }.primary-btn, .outline-btn { width: 100%; height: 88rpx; display: flex; align-items: center; justify-content: center; margin-top: 24rpx; padding: 0; border-radius: 18rpx; line-height: normal; font-size: 30rpx; font-weight: 800; }.primary-btn { color: #fff; background: #ff6600; }.outline-btn { color: #ff6600; background: #fff7f0; border: 1rpx solid #ffd0ae; }.share-btn { margin-top: 26rpx; }.secondary-link { margin-top: 22rpx; color: #8b8e97; text-align: center; font-size: 24rpx; }.section-title { margin-bottom: 18rpx; color: #17191f; font-size: 29rpx; font-weight: 900; }.rule-row { display: flex; gap: 16rpx; padding: 15rpx 0; }.rule-icon { width: 38rpx; height: 38rpx; flex: 0 0 auto; border-radius: 50%; color: #fff; background: #ff6a1f; line-height: 38rpx; text-align: center; font-size: 22rpx; font-weight: 900; }.rule-row view { flex: 1; }.rule-row text { display: block; }.rule-row text:first-child { color: #2b2e35; font-size: 26rpx; font-weight: 800; }.rule-row text:last-child { margin-top: 5rpx; color: #9aa0a6; font-size: 22rpx; line-height: 1.45; }.landing-card { background: linear-gradient(145deg, #fff8ef, #fff); }.landing-kicker { color: #e45d1b; font-size: 21rpx; letter-spacing: .14em; font-weight: 800; }.landing-title { margin-top: 8rpx; color: #c94712; font-size: 38rpx; font-weight: 950; }.landing-desc { margin-top: 8rpx; color: #866c57; font-size: 24rpx; }.landing-product { display: flex; align-items: center; margin-top: 22rpx; padding: 14rpx; border-radius: 16rpx; background: #fff; }.landing-product image { width: 132rpx; height: 132rpx; border-radius: 12rpx; background: #f5f5f5; }.landing-product-info { flex: 1; margin-left: 18rpx; color: #343039; font-size: 27rpx; font-weight: 800; }.landing-product-info text { display: block; margin-top: 14rpx; color: #ef5017; font-size: 32rpx; }.coupon-ticket { display: flex; align-items: center; margin-top: 22rpx; padding: 22rpx; border: 2rpx solid #ffc37d; border-radius: 16rpx; background: #fff; }.ticket-amount { color: #e84e12; font-size: 28rpx; font-weight: 900; }.ticket-amount text { margin-left: 3rpx; font-size: 62rpx; line-height: 1; }.ticket-copy { margin-left: 20rpx; color: #3c3028; font-size: 28rpx; font-weight: 800; }.ticket-copy text { display: block; margin-top: 8rpx; color: #9b806a; font-size: 21rpx; font-weight: 400; }.foot-note { padding: 28rpx 42rpx 0; color: #a19a92; font-size: 21rpx; line-height: 1.6; text-align: center; }.empty { padding: 200rpx 48rpx; color: #9aa0a6; text-align: center; font-size: 27rpx; }.empty-icon { display: grid; place-items: center; width: 110rpx; height: 110rpx; margin: 0 auto 24rpx; border-radius: 50%; color: #f15e17; background: #fff0e5; font-size: 32rpx; font-weight: 700; }
