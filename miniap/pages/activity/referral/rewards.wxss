.rewards-page {
  min-height: 100vh;
  padding-bottom: 48rpx;
}

.rewards-body {
  padding: 0 32rpx;
  margin-top: -16rpx;
  position: relative;
  z-index: 1;
}

.progress-card,
.reward-list {
  margin-bottom: 20rpx;
  padding: 28rpx;
}

.progress-track {
  height: 16rpx;
  margin-top: 20rpx;
  border-radius: 8rpx;
  background: #E6FBF2;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  border-radius: inherit;
  background: linear-gradient(90deg, #16C47F, #7ADB5A);
}

.progress-label {
  display: flex;
  justify-content: space-between;
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #9A9EA8;
}

.reward-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 0;
  border-bottom: 2rpx solid #F6F6F8;
}

.reward-row:last-child {
  border-bottom: 0;
}

.reward-amount {
  width: 120rpx;
  flex: none;
  color: #FF4A1C;
  font-size: 40rpx;
  font-weight: 900;
}

.reward-amount text {
  font-size: 24rpx;
}

.reward-copy {
  flex: 1;
  min-width: 0;
}

.reward-copy view {
  font-weight: 700;
  color: #15161C;
}

.reward-copy text {
  display: block;
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #9A9EA8;
}

.empty-inner {
  padding: 32rpx 0;
  text-align: center;
  color: #9A9EA8;
  font-size: 26rpx;
}

.foot-note {
  font-size: 22rpx;
  color: #9A9EA8;
  text-align: center;
  line-height: 1.5;
}
