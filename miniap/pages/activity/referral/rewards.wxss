.rewards-page { min-height: 100vh; padding-bottom: 42rpx; background: #f7f4ed; color: #17191f; }.reward-hero { padding: 48rpx 28rpx 40rpx; color: #fff; text-align: center; background: linear-gradient(145deg, #ff6a1f, #ef421a); }.kicker { font-size: 21rpx; letter-spacing: .16em; opacity: .8; }.title { margin-top: 14rpx; font-size: 42rpx; font-weight: 950; }.subtitle { margin-top: 10rpx; font-size: 24rpx; opacity: .88; }.card { margin: 18rpx 24rpx 0; padding: 26rpx; border-radius: 20rpx; background: #fff; box-shadow: 0 12rpx 28rpx rgba(50,44,36,.06); }.progress-title, .section-title { color: #17191f; font-size: 29rpx; font-weight: 900; }.progress-track { height: 14rpx; margin-top: 26rpx; border-radius: 16rpx; background: #f5e0d5; overflow: hidden; }.progress-fill { height: 100%; border-radius: inherit; background: #ff5a1f; }.progress-label { display: flex; justify-content: space-between; margin-top: 12rpx; color: #8b8e97; font-size: 22rpx; }.reward-list { margin-top: 18rpx; }.reward-row { display: flex; align-items: center; min-height: 104rpx; padding: 16rpx 0; border-bottom: 1rpx solid #f1f2f4; }.reward-row:last-child { border-bottom: 0; }.reward-amount { width: 136rpx; color: #ef5017; font-size: 52rpx; font-weight: 950; }.reward-amount text { margin-right: 2rpx; font-size: 23rpx; }.reward-copy { flex: 1; min-width: 0; }.reward-copy view { color: #262a31; font-size: 27rpx; font-weight: 800; }.reward-copy text { display: block; margin-top: 8rpx; color: #9aa0a6; font-size: 21rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }.use-btn { width: 118rpx; height: 56rpx; margin: 0; padding: 0; border-radius: 16rpx; color: #ff6600; background: #fff5eb; font-size: 23rpx; line-height: normal; }.empty-inner { padding: 58rpx 0 32rpx; color: #9aa0a6; text-align: center; font-size: 24rpx; }.foot-note { padding: 28rpx 42rpx 0; color: #a19a92; font-size: 21rpx; line-height: 1.6; text-align: center; }.empty { padding: 220rpx 48rpx; color: #9aa0a6; text-align: center; font-size: 27rpx; }
