<view class="rewards-page"><view class="page-head"><view class="head-title">我的奖品</view><view class="head-desc">抽中的积分、优惠券和实物都在这里</view></view><view wx:if="{{!loading && !rewards.length}}" class="empty card"><view class="empty-symbol">礼</view><view class="empty-title">还没有中奖记录</view><view class="empty-desc">去互动抽奖盲盒试试手气吧</view><button class="primary-btn" bindtap="goHome">返回首页</button></view><view wx:for="{{rewards}}" wx:key="id" class="reward-card card"><view class="reward-main"><image wx:if="{{item.image}}" class="reward-image" src="{{item.image}}" mode="aspectFit"/><view wx:else class="reward-symbol">{{item.prizeType === 'POINTS' ? '积' : item.prizeType === 'COUPON' ? '券' : item.prizeType === 'PHYSICAL' ? '礼' : '谢'}}</view><view class="reward-copy"><view class="reward-name">{{item.prizeName}}</view><view class="reward-meta">{{item.activityName}} · {{item.createdAt}}</view></view><view class="reward-status">{{item.statusText}}</view></view><view wx:if="{{item.prizeType === 'PHYSICAL' && item.status === 2}}" class="reward-action"><view class="action-tip">请填写收货地址，商家将人工处理发货</view><button class="small-btn" data-id="{{item.id}}" bindtap="fillAddress">填写地址</button></view><view wx:if="{{item.prizeType === 'PHYSICAL' && item.status >= 3 && item.orderNo}}" class="reward-action"><view class="action-tip">订单已创建，可在订单中查看物流状态</view><button class="small-btn" data-order-no="{{item.orderNo}}" bindtap="goOrder">查看订单</button></view><view wx:if="{{item.prizeType === 'COUPON' && item.couponId}}" class="reward-action"><view class="action-tip">优惠券已到账</view><button class="small-btn" bindtap="useCoupon">去使用</button></view><view wx:if="{{item.prizeType === 'POINTS'}}" class="reward-action"><view class="action-tip">积分已发放到账户</view><button class="small-btn" bindtap="usePoints">去兑换</button></view></view></view>
