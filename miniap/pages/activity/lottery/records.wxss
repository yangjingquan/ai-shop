.records-page {
  min-height: 100vh;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
}

.records-page .page-body {
  margin-top: -8rpx;
}

.record-card {
  margin-bottom: 20rpx;
  padding: 28rpx;
}

.record-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.record-time {
  font-size: 22rpx;
  color: #9A9EA8;
}

.record-name {
  margin-top: 16rpx;
  font-size: 32rpx;
  font-weight: 800;
  color: #15161C;
}

.record-meta {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #9A9EA8;
}

.record-status-row {
  margin-top: 16rpx;
}

.records-home-btn {
  width: auto;
  min-width: 240rpx;
  height: 72rpx;
  margin-top: 28rpx;
  box-shadow: 0 12rpx 28rpx rgba(255, 74, 28, 0.28);
}

.records-footer-btn {
  margin-top: 24rpx;
  width: 100%;
}
