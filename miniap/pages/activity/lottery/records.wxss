page{background:#f8f5f0}.records-page{min-height:100vh;padding:28rpx 24rpx 56rpx;color:#2d241f;background:#f8f5f0}.page-head{padding:18rpx 4rpx 20rpx}.head-title{font-size:44rpx;font-weight:900}.head-desc{margin-top:8rpx;color:#988f88;font-size:23rpx}.card{margin-top:16rpx;padding:24rpx;border-radius:18rpx;background:#fff;box-shadow:0 8rpx 24rpx rgba(15,23,42,.04)}.record-head{display:flex;justify-content:space-between;align-items:center}.record-type{color:#f15e17;font-size:23rpx;font-weight:700}.record-time{color:#9a918a;font-size:20rpx}.record-name{margin-top:15rpx;font-size:30rpx;font-weight:800}.record-meta{margin-top:8rpx;color:#aaa19a;font-size:20rpx}.record-status{margin-top:15rpx;padding-top:14rpx;border-top:1rpx solid #f0eee9;color:#55a145;font-size:22rpx}.empty{text-align:center;padding:58rpx 24rpx}.empty-symbol{width:88rpx;height:88rpx;margin:0 auto;border-radius:50%;color:#fff;background:#ffb45b;font-size:36rpx;line-height:88rpx;font-weight:800}.empty-title{margin-top:20rpx;font-size:30rpx;font-weight:800}.empty-desc{margin-top:8rpx;color:#9a918a;font-size:23rpx}.primary-btn,.outline-btn{width:100%;margin-top:28rpx}.outline-btn{height:72rpx;padding:0;border:1rpx solid #ef5523;border-radius:18rpx;color:#ef5523;background:#fff7f0;font-size:26rpx}
