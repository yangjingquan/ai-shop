.lottery-page {
  min-height: 100vh;
  padding-bottom: 48rpx;
}

.lottery-hero {
  padding-bottom: 56rpx;
}

.lottery-hero-visual {
  position: relative;
  height: 300rpx;
  margin-top: 8rpx;
  border-radius: 40rpx;
  overflow: hidden;
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.25), rgba(255, 255, 255, 0.05));
}

.hero-box-art {
  position: absolute;
  right: 40rpx;
  top: 40rpx;
  width: 220rpx;
  height: 220rpx;
  border-radius: 48rpx;
  transform: rotate(12deg);
  box-shadow: 0 16rpx 40rpx rgba(0, 0, 0, 0.15);
}

.hero-copy {
  position: absolute;
  left: 32rpx;
  bottom: 32rpx;
  color: #fff;
}

.hero-kicker {
  font-size: 20rpx;
  font-weight: 800;
  letter-spacing: 4rpx;
  color: #FFD23F;
}

.hero-title {
  margin-top: 12rpx;
  font-size: 48rpx;
  font-weight: 900;
}

.hero-subtitle {
  margin-top: 8rpx;
  font-size: 24rpx;
  opacity: 0.88;
}

.content {
  padding: 0 32rpx;
}

.chance-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: -48rpx;
  position: relative;
  z-index: 2;
  padding: 28rpx;
}

.chance-label {
  font-size: 24rpx;
  color: #9A9EA8;
}

.chance-value {
  margin-top: 8rpx;
  font-size: 68rpx;
  font-weight: 900;
  color: #7B5CFF;
  line-height: 1;
}

.chance-value text {
  font-size: 28rpx;
  font-weight: 600;
}

.chance-links {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  align-items: flex-end;
  font-size: 26rpx;
  color: #5B5F6B;
}

.prize-card,
.rule-card {
  margin-top: 20rpx;
  padding: 28rpx;
}

.card-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 20rpx;
  font-size: 32rpx;
  font-weight: 800;
  color: #15161C;
}

.card-header-link {
  justify-content: space-between;
}

.rule-more {
  font-size: 26rpx;
  font-weight: 500;
  color: #5B5F6B;
}

.prize-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
}

.prize-item {
  padding: 16rpx 8rpx;
  border-radius: 28rpx;
  background: #F6F6F8;
  text-align: center;
}

.prize-image,
.prize-symbol {
  width: 88rpx;
  height: 88rpx;
  margin: 0 auto;
  border-radius: 50%;
}

.prize-symbol {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #fff;
  color: #7B5CFF;
  font-size: 36rpx;
  font-weight: 900;
}

.prize-name {
  margin-top: 12rpx;
  font-size: 24rpx;
  font-weight: 700;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.prize-probability {
  margin-top: 6rpx;
  font-size: 20rpx;
  color: #9A9EA8;
}

.rule-line {
  position: relative;
  padding-left: 28rpx;
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #5B5F6B;
  line-height: 1.55;
}

.rule-line::before {
  content: '';
  position: absolute;
  left: 4rpx;
  top: 16rpx;
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #7B5CFF;
}

.draw-btn {
  width: 100%;
  margin-top: 28rpx;
  height: 104rpx;
  border-radius: 52rpx;
  font-size: 34rpx;
}

.draw-btn-active {
  background: linear-gradient(90deg, #7B5CFF, #FF5CA8) !important;
  color: #fff !important;
  border: 0 !important;
  box-shadow: 0 16rpx 40rpx rgba(123, 92, 255, 0.35);
}

.mask {
  position: fixed;
  z-index: 20;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
  background: rgba(21, 22, 28, 0.55);
}

.rule-dialog {
  width: 100%;
  padding: 32rpx;
}

.dialog-title {
  text-align: center;
  font-size: 36rpx;
  font-weight: 800;
}

.dialog-scroll {
  max-height: 400rpx;
  margin: 24rpx 0;
  font-size: 26rpx;
  color: #5B5F6B;
  line-height: 1.7;
  white-space: pre-wrap;
}

.draw-overlay {
  position: fixed;
  z-index: 30;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
  background: rgba(35, 16, 60, 0.78);
}

.draw-panel {
  position: relative;
  width: 100%;
  min-height: 620rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  border-radius: 56rpx;
  background: radial-gradient(circle at 50% 30%, #7B5CFF, #2a1248);
  box-shadow: 0 48rpx 120rpx rgba(16, 7, 32, 0.45);
}

.draw-panel::before {
  content: '';
  position: absolute;
  width: 420rpx;
  height: 420rpx;
  border-radius: 50%;
  background: rgba(255, 210, 63, 0.18);
  animation: drawGlow 1.05s ease-in-out infinite alternate;
}

.draw-box {
  position: relative;
  z-index: 2;
  width: 390rpx;
  height: 390rpx;
  animation: drawShake 0.78s ease-in-out infinite;
}

.draw-orbit {
  position: absolute;
  z-index: 1;
  width: 270rpx;
  height: 70rpx;
  border: 3rpx solid rgba(255, 210, 63, 0.75);
  border-left-color: transparent;
  border-right-color: transparent;
  border-radius: 50%;
  animation: drawOrbit 1.1s linear infinite;
}

.orbit-one {
  top: 220rpx;
}

.orbit-two {
  bottom: 220rpx;
  transform: rotate(162deg);
  animation-delay: -0.35s;
}

.draw-message {
  position: relative;
  z-index: 2;
  margin-top: 12rpx;
  color: #fff;
  font-size: 40rpx;
  font-weight: 900;
}

.draw-tip {
  position: relative;
  z-index: 2;
  margin-top: 14rpx;
  color: #FFD23F;
  font-size: 24rpx;
}

@keyframes drawShake {
  0%, 100% { transform: rotate(-3deg) scale(1); }
  50% { transform: rotate(4deg) scale(1.03); }
}

@keyframes drawGlow {
  from { transform: scale(0.86); opacity: 0.6; }
  to { transform: scale(1.08); opacity: 1; }
}

@keyframes drawOrbit {
  from { transform: rotate(-18deg) scale(0.84); opacity: 0.35; }
  to { transform: rotate(342deg) scale(1.1); opacity: 0.2; }
}
