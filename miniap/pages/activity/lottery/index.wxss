page{background:#f7f4ed}.lottery-page{min-height:100vh;padding-bottom:52rpx;color:#2d241f;background:#f7f4ed}.lottery-hero{position:relative;height:470rpx;overflow:hidden;background:#2b150c}.hero-image{width:100%;height:100%;display:block}.hero-shade{position:absolute;inset:0;background:linear-gradient(180deg,rgba(33,15,6,.02) 35%,rgba(33,15,6,.84) 100%)}.hero-copy{position:absolute;left:34rpx;right:34rpx;bottom:38rpx;color:#fff}.hero-kicker{color:#ffd898;font-size:19rpx;letter-spacing:2rpx}.hero-title{margin-top:12rpx;font-size:58rpx;font-weight:900;letter-spacing:3rpx}.hero-subtitle{margin-top:10rpx;color:#ffe7c8;font-size:25rpx}.content{padding:0 24rpx}.chance-card{display:flex;align-items:center;justify-content:space-between;margin-top:-30rpx;padding:24rpx 28rpx;position:relative;z-index:1;border-radius:20rpx;background:#fff;box-shadow:0 12rpx 28rpx rgba(67,34,15,.1)}.chance-label{color:#8b8e97;font-size:23rpx}.chance-value{margin-top:6rpx;color:#f15e17;font-size:48rpx;font-weight:900}.chance-value text{font-size:24rpx;font-weight:600}.reward-link{color:#ff6600;font-size:24rpx}.card{margin-top:20rpx;padding:26rpx;border-radius:18rpx;background:#fff;box-shadow:0 8rpx 24rpx rgba(15,23,42,.04)}.section-title{font-size:30rpx;font-weight:800}.section-title text{float:right;color:#9a8d83;font-size:21rpx;font-weight:400}.prize-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:12rpx;margin-top:20rpx}.prize-item{min-width:0;padding:12rpx 5rpx;border:1rpx solid #f5e5d5;border-radius:14rpx;text-align:center;background:#fffaf5}.prize-image,.prize-symbol{display:block;width:70rpx;height:70rpx;margin:0 auto;border-radius:50%;object-fit:contain}.prize-symbol{color:#fff;background:#ff7a25;font-size:34rpx;line-height:70rpx;font-weight:800}.prize-name{overflow:hidden;margin-top:8rpx;font-size:22rpx;text-overflow:ellipsis;white-space:nowrap}.prize-probability{margin-top:5rpx;color:#9a8d83;font-size:18rpx}.rule-line{margin-top:15rpx;color:#6f6660;font-size:23rpx;line-height:1.45}.draw-btn{margin-top:28rpx}.notice{margin-top:16rpx;color:#a39b94;font-size:21rpx;text-align:center}.mask{position:fixed;z-index:20;inset:0;display:flex;align-items:center;justify-content:center;padding:46rpx;background:rgba(32,19,10,.56)}.rule-dialog{width:100%;padding:30rpx;border-radius:22rpx;background:#fffaf5}.dialog-title{text-align:center;font-size:34rpx;font-weight:800}.dialog-scroll{max-height:400rpx;margin:24rpx 0;color:#70655e;font-size:25rpx;line-height:1.75;white-space:pre-wrap}.outline-btn{height:72rpx;margin:0;padding:0;border:1rpx solid #ff6600;border-radius:18rpx;color:#ff6600;background:#fff7f0;font-size:26rpx}
.chance-links{display:flex;flex-direction:column;gap:14rpx;align-items:flex-end}
