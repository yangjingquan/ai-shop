page{background:#f8f5f0}.lottery-page{min-height:100vh;padding-bottom:52rpx;color:#2d241f;background:#f8f5f0}.lottery-hero{position:relative;height:470rpx;overflow:hidden;background:#2b150c}.hero-image{width:100%;height:100%;display:block}.hero-shade{position:absolute;inset:0;background:linear-gradient(180deg,rgba(33,15,6,.02) 35%,rgba(33,15,6,.84) 100%)}.hero-copy{position:absolute;left:34rpx;right:34rpx;bottom:38rpx;color:#fff}.hero-kicker{color:#ffd898;font-size:19rpx;letter-spacing:2rpx}.hero-title{margin-top:12rpx;font-size:58rpx;font-weight:900;letter-spacing:3rpx}.hero-subtitle{margin-top:10rpx;color:#ffe7c8;font-size:25rpx}.content{padding:0 24rpx}.chance-card{display:flex;align-items:center;justify-content:space-between;margin-top:-30rpx;padding:24rpx 28rpx;position:relative;z-index:1;border-radius:20rpx;background:#fff;box-shadow:0 12rpx 28rpx rgba(67,34,15,.1)}.chance-label{color:#8b8e97;font-size:23rpx}.chance-value{margin-top:6rpx;color:#f15e17;font-size:48rpx;font-weight:900}.chance-value text{font-size:24rpx;font-weight:600}.reward-link{color:#ef5523;font-size:24rpx}.card{margin-top:20rpx;padding:26rpx;border-radius:18rpx;background:#fff;box-shadow:0 8rpx 24rpx rgba(15,23,42,.04)}.section-title{font-size:30rpx;font-weight:800}.section-title text{float:right;color:#9a8d83;font-size:21rpx;font-weight:400}.prize-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:12rpx;margin-top:20rpx}.prize-item{min-width:0;padding:12rpx 5rpx;border:1rpx solid #f5e5d5;border-radius:14rpx;text-align:center;background:#fffaf5}.prize-image,.prize-symbol{display:block;width:70rpx;height:70rpx;margin:0 auto;border-radius:50%;object-fit:contain}.prize-symbol{color:#fff;background:#ff7a25;font-size:34rpx;line-height:70rpx;font-weight:800}.prize-name{overflow:hidden;margin-top:8rpx;font-size:22rpx;text-overflow:ellipsis;white-space:nowrap}.prize-probability{margin-top:5rpx;color:#9a8d83;font-size:18rpx}.rule-line{margin-top:15rpx;color:#6f6660;font-size:23rpx;line-height:1.45}.draw-btn{margin-top:28rpx}.notice{margin-top:16rpx;color:#a39b94;font-size:21rpx;text-align:center}.mask{position:fixed;z-index:20;inset:0;display:flex;align-items:center;justify-content:center;padding:46rpx;background:rgba(32,19,10,.56)}.rule-dialog{width:100%;padding:30rpx;border-radius:22rpx;background:#fffaf5}.dialog-title{text-align:center;font-size:34rpx;font-weight:800}.dialog-scroll{max-height:400rpx;margin:24rpx 0;color:#70655e;font-size:25rpx;line-height:1.75;white-space:pre-wrap}.outline-btn{height:72rpx;margin:0;padding:0;border:1rpx solid #ef5523;border-radius:18rpx;color:#ef5523;background:#fff7f0;font-size:26rpx}
.draw-overlay{position:fixed;z-index:30;inset:0;display:flex;align-items:center;justify-content:center;padding:40rpx;background:rgba(35,16,8,.78)}.draw-panel{position:relative;width:100%;min-height:620rpx;display:flex;flex-direction:column;align-items:center;justify-content:center;overflow:hidden;border-radius:28rpx;background:#2b150c;box-shadow:0 24rpx 80rpx rgba(16,7,2,.45)}.draw-panel::before{content:'';position:absolute;width:420rpx;height:420rpx;border-radius:50%;background:rgba(255,159,44,.18);box-shadow:0 0 80rpx rgba(255,174,55,.35);animation:drawGlow 1.05s ease-in-out infinite alternate}.draw-box{position:relative;z-index:2;width:390rpx;height:390rpx;animation:drawShake .78s ease-in-out infinite;filter:drop-shadow(0 20rpx 20rpx rgba(255,113,24,.28))}.draw-panel.revealing .draw-box{animation:drawReveal .45s ease-out both}.draw-orbit{position:absolute;z-index:1;width:270rpx;height:70rpx;border:3rpx solid rgba(255,199,94,.75);border-left-color:transparent;border-right-color:transparent;border-radius:50%;transform:rotate(-18deg);animation:drawOrbit 1.1s linear infinite}.orbit-one{top:220rpx}.orbit-two{bottom:220rpx;transform:rotate(162deg);animation-delay:-.35s}.draw-message{position:relative;z-index:2;margin-top:6rpx;color:#fff7df;font-size:40rpx;font-weight:900;letter-spacing:4rpx}.draw-tip{position:relative;z-index:2;margin-top:14rpx;color:#ffd899;font-size:23rpx}@keyframes drawShake{0%,100%{transform:rotate(-3deg) scale(1)}25%{transform:rotate(3deg) scale(1.03)}50%{transform:rotate(-4deg) scale(.98)}75%{transform:rotate(4deg) scale(1.04)}}@keyframes drawGlow{from{transform:scale(.86);opacity:.6}to{transform:scale(1.08);opacity:1}}@keyframes drawOrbit{from{transform:rotate(-18deg) scale(.84);opacity:.35}50%{opacity:1}to{transform:rotate(342deg) scale(1.1);opacity:.2}}@keyframes drawReveal{0%{transform:scale(1) rotate(0);opacity:1}55%{transform:scale(1.14) rotate(-4deg);opacity:1}100%{transform:scale(.72) rotate(0);opacity:0}}
.chance-links{display:flex;flex-direction:column;gap:14rpx;align-items:flex-end}
