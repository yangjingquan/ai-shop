<view class="records-page"><view class="page-head"><view class="head-title">抽奖记录</view><view class="head-desc">{{activityName || '按活动查看历史抽奖结果'}}</view></view><view wx:if="{{!loading && !records.length}}" class="empty card"><view class="empty-symbol">签</view><view class="empty-title">暂无抽奖记录</view><view class="empty-desc">参与一次后，结果会显示在这里</view><button class="primary-btn" bindtap="goHome">返回首页</button></view><view wx:for="{{records}}" wx:key="drawNo" class="record-card card"><view class="record-head"><view class="record-type">{{item.typeText}}</view><view class="record-time">{{item.createdAt}}</view></view><view class="record-name">{{item.prize.name}}</view><view class="record-meta">抽奖编号 {{item.drawNo}}</view><view wx:if="{{item.reward}}" class="record-status">{{item.reward.statusText}}</view></view><button wx:if="{{records.length}}" class="outline-btn" bindtap="goRewards">查看我的奖品</button></view>
