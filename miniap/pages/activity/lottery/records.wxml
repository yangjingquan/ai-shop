<view class="records-page page-shell">
  <view class="page-hero page-hero-purple">
    <view class="hero-blob"></view>
    <view class="hero-kicker">RECORDS</view>
    <view class="hero-heading">抽奖记录</view>
    <view class="hero-desc">{{activityName || '按活动查看历史抽奖结果'}}</view>
  </view>

  <view class="page-body">
    <view wx:if="{{!loading && !records.length}}" class="empty-state2 card">
      <view class="empty-state2-symbol">签</view>
      <text class="empty-state2-title">暂无抽奖记录</text>
      <text class="empty-state2-desc">参与一次后，结果会显示在这里</text>
      <button class="btn btn-primary btn-sm records-home-btn" bindtap="goHome">返回首页</button>
    </view>

    <view wx:for="{{records}}" wx:key="drawNo" class="record-card card">
      <view class="record-top">
        <text class="st-pill st-pill-blue">{{item.typeText}}</text>
        <text class="record-time">{{item.createdAt}}</text>
      </view>
      <view class="record-name">{{item.prize.name}}</view>
      <view class="record-meta">抽奖编号 {{item.drawNo}}</view>
      <view wx:if="{{item.reward}}" class="record-status-row">
        <text class="st-pill st-pill-green">{{item.reward.statusText}}</text>
      </view>
    </view>

    <button wx:if="{{records.length}}" class="btn btn-ghost btn-lg records-footer-btn" bindtap="goRewards">查看我的奖品</button>
  </view>
</view>
