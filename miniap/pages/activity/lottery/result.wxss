.result-page {
  min-height: 100vh;
  padding: 32rpx;
  background: #F3EEFF;
  box-sizing: border-box;
}

.result-card {
  margin-top: 20rpx;
  padding: 60rpx 40rpx 48rpx;
  text-align: center;
  background: linear-gradient(180deg, #F3EEFF, #fff);
}

.result-kicker {
  font-size: 22rpx;
  font-weight: 800;
  letter-spacing: 6rpx;
  color: #7B5CFF;
}

.result-title {
  margin: 12rpx 0 36rpx;
  font-size: 60rpx;
  font-weight: 900;
  color: #15161C;
}

.result-image,
.result-symbol {
  width: 260rpx;
  height: 260rpx;
  margin: 0 auto;
  border-radius: 72rpx;
}

.result-symbol {
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #FFD23F, #FF8A00);
  color: #fff;
  font-size: 108rpx;
  font-weight: 900;
  box-shadow: 0 28rpx 60rpx rgba(255, 138, 0, 0.35);
}

.prize-name {
  margin-top: 32rpx;
  font-size: 36rpx;
  font-weight: 800;
  color: #15161C;
}

.prize-desc {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #9A9EA8;
}

.result-card .btn-lg {
  margin-top: 40rpx;
  width: 100%;
}

.result-again {
  margin-top: 20rpx;
}

.result-links {
  display: flex;
  justify-content: center;
  gap: 48rpx;
  margin-top: 28rpx;
  font-size: 26rpx;
  color: #5B5F6B;
}
