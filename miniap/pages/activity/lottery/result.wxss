page{background:#3b1d0f}.result-page{min-height:100vh;padding:110rpx 34rpx 60rpx;box-sizing:border-box;background:radial-gradient(circle at 50% 8%,#ff9a38 0,#6d2e12 42%,#30160d 100%)}.result-card{padding:42rpx 30rpx 32rpx;border-radius:28rpx;text-align:center;background:#fffaf3;box-shadow:0 20rpx 50rpx rgba(16,7,2,.3)}.result-kicker{color:#f19a33;font-size:20rpx;letter-spacing:3rpx}.result-title{margin-top:10rpx;color:#ed5b12;font-size:48rpx;font-weight:900}.result-image,.result-symbol{display:block;width:170rpx;height:170rpx;margin:28rpx auto 10rpx;border-radius:50%}.result-symbol{color:#fff;background:#ff7a25;font-size:78rpx;line-height:170rpx;font-weight:900}.prize-name{color:#33261f;font-size:36rpx;font-weight:800}.prize-desc{margin:14rpx 20rpx 24rpx;color:#877c73;font-size:24rpx;line-height:1.55}.primary-btn{margin-top:12rpx}.outline-btn{height:72rpx;margin:16rpx 0 0;padding:0;border:1rpx solid #ff6600;border-radius:18rpx;color:#ff6600;background:#fff7f0;font-size:26rpx}.home-link{margin-top:22rpx;color:#9b9188;font-size:23rpx}
.result-links{display:flex;justify-content:center;gap:32rpx;margin-top:22rpx;color:#9b9188;font-size:23rpx}
