page{background:#f7f4ed}.rewards-page{min-height:100vh;padding:28rpx 24rpx 56rpx;color:#2d241f;background:#f7f4ed}.page-head{padding:18rpx 4rpx 20rpx}.head-title{font-size:44rpx;font-weight:900}.head-desc{margin-top:8rpx;color:#988f88;font-size:23rpx}.card{margin-top:16rpx;padding:24rpx;border-radius:18rpx;background:#fff;box-shadow:0 8rpx 24rpx rgba(15,23,42,.04)}.reward-main{display:flex;align-items:center}.reward-image,.reward-symbol{flex:0 0 auto;width:82rpx;height:82rpx;border-radius:50%}.reward-symbol{color:#fff;background:#ff7a25;font-size:38rpx;line-height:82rpx;text-align:center;font-weight:800}.reward-copy{min-width:0;margin-left:18rpx}.reward-name{overflow:hidden;font-size:29rpx;font-weight:800;text-overflow:ellipsis;white-space:nowrap}.reward-meta{overflow:hidden;margin-top:8rpx;color:#9a918a;font-size:21rpx;text-overflow:ellipsis;white-space:nowrap}.reward-status{margin-left:auto;padding-left:12rpx;color:#55a145;font-size:22rpx;white-space:nowrap}.reward-action{display:flex;align-items:center;justify-content:space-between;gap:12rpx;margin-top:20rpx;padding-top:18rpx;border-top:1rpx solid #f0eee9}.action-tip{color:#857b73;font-size:22rpx;line-height:1.4}.small-btn{flex:0 0 auto;height:58rpx;margin:0;padding:0 18rpx;border-radius:15rpx;color:#fff;background:#ff6600;font-size:22rpx;line-height:58rpx}.empty{text-align:center;padding:58rpx 24rpx}.empty-symbol{width:88rpx;height:88rpx;margin:0 auto;border-radius:50%;color:#fff;background:#ffb45b;font-size:42rpx;line-height:88rpx;font-weight:800}.empty-title{margin-top:20rpx;font-size:30rpx;font-weight:800}.empty-desc{margin-top:8rpx;color:#9a918a;font-size:23rpx}.primary-btn{margin-top:28rpx}
