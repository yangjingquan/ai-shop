.rewards-page {
  min-height: 100vh;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
}

.reward-card {
  margin-bottom: 20rpx;
  padding: 28rpx;
}

.reward-main {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.reward-symbol-wrap {
  flex: none;
}

.reward-image,
.reward-symbol {
  width: 104rpx;
  height: 104rpx;
  border-radius: 28rpx;
}

.reward-symbol {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #EDE6FF;
  color: #7B5CFF;
  font-size: 42rpx;
  font-weight: 900;
}

.reward-copy {
  flex: 1;
  min-width: 0;
}

.reward-name {
  font-size: 30rpx;
  font-weight: 800;
  color: #15161C;
}

.reward-meta {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #9A9EA8;
}

.reward-action {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 20rpx;
  padding: 16rpx 24rpx;
  border-radius: 24rpx;
  background: #F6F6F8;
}

.action-tip {
  flex: 1;
  min-width: 0;
  font-size: 24rpx;
  color: #5B5F6B;
  line-height: 1.45;
}

.reward-action .btn-sm {
  flex: none;
  height: 60rpx;
  padding: 0 28rpx;
  font-size: 24rpx;
}

.rewards-home-btn {
  width: auto;
  min-width: 240rpx;
  height: 72rpx;
  margin-top: 28rpx;
}
