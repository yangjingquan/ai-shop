page {
  background: #f8f7f4;
}

.cart-page {
  min-height: 100vh;
  padding: 8rpx 32rpx 164rpx;
  background: #f8f7f4;
  color: #282722;
  box-sizing: border-box;
}

.cart-page.is-empty {
  padding-top: 32rpx;
  padding-bottom: 40rpx;
}

.cart-topbar {
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.cart-count {
  color: #7c7a74;
  font-size: 24rpx;
}

.cart-count-value {
  color: #38362f;
  font-weight: 600;
}

.cart-page .manage-btn {
  display: flex;
  width: auto;
  min-width: 0;
  margin: 0 -12rpx 0 0;
  padding: 16rpx 12rpx;
  background: transparent;
  color: #4d4b44;
  font-size: 25rpx;
  font-weight: 500;
  line-height: 1.4;
}

.merchant-card {
  margin-bottom: 20rpx;
  overflow: hidden;
  border-radius: 36rpx;
  background: #fff;
}
.bundle-cart-header { display:flex; align-items:center; gap:10rpx; padding:18rpx 24rpx 0; color:#4b4942; font-size:25rpx; font-weight:700; }.bundle-tag { padding:4rpx 10rpx; border-radius:8rpx; color:#ff6600; background:#fff1e5; font-size:21rpx; }.bundle-cart-tip { margin-left:auto; color:#9aa0a6; font-size:21rpx; font-weight:400; }.bundle-item-label { color:#9aa0a6; font-size:22rpx; }

.merchant-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 24rpx 24rpx 4rpx;
  font-size: 26rpx;
  font-weight: 600;
}

.swipe-wrap {
  position: relative;
  overflow: hidden;
}

.swipe-wrap + .swipe-wrap::before {
  position: absolute;
  top: 0;
  left: 28rpx;
  right: 28rpx;
  z-index: 2;
  height: 1rpx;
  background: #f3f2ee;
  content: '';
}

.delete-action {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  width: 144rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #e85f4e;
  color: #fff;
  font-size: 26rpx;
  font-weight: 500;
}

.cart-item {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  min-height: 240rpx;
  padding: 28rpx 24rpx 28rpx 8rpx;
  background: #fff;
  transition: transform 0.18s ease;
  box-sizing: border-box;
}

.item-check {
  flex: 0 0 60rpx;
  align-self: stretch;
  display: flex;
  align-items: center;
  justify-content: center;
}

.check-btn {
  flex-shrink: 0;
  width: 36rpx;
  height: 36rpx;
  border: 2rpx solid #d6d4cd;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #fff;
  box-sizing: border-box;
}

.check-btn.checked {
  border-color: #ff6600;
  background: #fff5eb;
}

.check-btn.disabled {
  border-color: #e9e7e1;
  background: #f4f3ef;
}

.check-icon {
  width: 26rpx;
  height: 26rpx;
}

.item-img {
  flex: 0 0 auto;
  width: 176rpx;
  height: 176rpx;
  border-radius: 24rpx;
  background: #f6f5f1;
}

.item-info {
  flex: 1;
  min-width: 0;
  min-height: 176rpx;
  padding-left: 22rpx;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

.item-name {
  width: 100%;
  font-size: 28rpx;
  line-height: 38rpx;
  font-weight: 600;
  overflow: hidden;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.item-spec {
  max-width: 100%;
  margin-top: 10rpx;
  padding: 5rpx 12rpx;
  border-radius: 10rpx;
  background: #f5f4f0;
  color: #807d74;
  font-size: 21rpx;
  line-height: 30rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  box-sizing: border-box;
}

.item-bottom {
  align-self: stretch;
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 6rpx 10rpx;
  margin-top: auto;
  padding-top: 16rpx;
}

.item-price {
  color: #ed620b;
  font-size: 32rpx;
  font-weight: 700;
  line-height: 44rpx;
}

.price-symbol {
  margin-right: 3rpx;
  font-size: 0.68em;
}

.qty-stepper {
  display: flex;
  align-items: center;
  flex-shrink: 0;
  margin-left: auto;
}

.qty-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 48rpx;
  height: 56rpx;
}

.qty-btn .icon {
  width: 22rpx;
  height: 22rpx;
  opacity: 0.7;
}

.qty-btn.disabled {
  opacity: 0.28;
}

.qty-num {
  min-width: 40rpx;
  padding: 0 6rpx;
  height: 40rpx;
  line-height: 40rpx;
  border-radius: 8rpx;
  background: #f6f5f1;
  color: #393730;
  text-align: center;
  font-size: 23rpx;
  font-weight: 500;
  box-sizing: border-box;
}

.is-unavailable .item-img {
  opacity: 0.55;
}

.unavailable-tip {
  margin-top: 10rpx;
  color: #bf5144;
  font-size: 22rpx;
  line-height: 30rpx;
}

.promotion-section {
  margin-top: 24rpx;
  padding: 28rpx 28rpx 24rpx;
  overflow: hidden;
  border-radius: 36rpx;
  background: #fff0e3;
}

.promotion-heading, .promotion-success, .promotion-success-copy {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.promotion-title {
  font-size: 29rpx;
  font-weight: 600;
  color: #65432b;
}

.promotion-tag {
  flex-shrink: 0;
  padding: 4rpx 12rpx;
  border: 1rpx solid #ebc7a6;
  border-radius: 8rpx;
  color: #a7571f;
  font-size: 20rpx;
  line-height: 28rpx;
}

.promotion-copy {
  margin-top: 16rpx;
  color: #6a4932;
  font-size: 27rpx;
  line-height: 44rpx;
}

.promotion-gap {
  color: #d85406;
  font-size: 40rpx;
  font-weight: 700;
}

.promotion-rule {
  margin-top: 6rpx;
  color: #986949;
  font-size: 22rpx;
  line-height: 32rpx;
}

.promotion-track {
  height: 5rpx;
  margin-top: 22rpx;
  overflow: hidden;
  border-radius: 8rpx;
  background: #efd7c2;
}

.promotion-fill {
  height: 100%;
  border-radius: 8rpx;
  background: #ff8b43;
  transition: width 0.2s ease;
}

.promotion-scroll {
  width: calc(100% + 28rpx);
  margin-top: 24rpx;
  white-space: nowrap;
}

.promotion-products {
  display: flex;
  align-items: stretch;
  padding-right: 28rpx;
}

.promotion-product {
  flex: 0 0 244rpx;
  width: 244rpx;
  margin-right: 16rpx;
  white-space: normal;
}

.promotion-product:last-child {
  margin-right: 0;
}

.promotion-product-img {
  display: block;
  width: 244rpx;
  height: 216rpx;
  border-radius: 22rpx;
  background: #fffaf5;
}

.promotion-product-name {
  height: 64rpx;
  margin-top: 14rpx;
  color: #4d3828;
  font-size: 24rpx;
  line-height: 32rpx;
  overflow: hidden;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.promotion-product-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 12rpx;
}

.promotion-product-price {
  color: #c5520c;
  font-size: 29rpx;
  font-weight: 700;
}

.promotion-product-action {
  padding: 6rpx 16rpx;
  border-radius: 24rpx;
  background: #fffaf6;
  color: #a3531e;
  font-size: 21rpx;
  line-height: 28rpx;
}

.promotion-section.is-achieved {
  padding: 24rpx 28rpx;
}

.promotion-success {
  flex-wrap: wrap;
  font-size: 25rpx;
  line-height: 36rpx;
  color: #795135;
}

.promotion-saving {
  color: #cc580e;
  font-weight: 600;
}

.guess-section {
  margin-top: 44rpx;
}

.guess-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.guess-title {
  font-size: 34rpx;
  font-weight: 600;
  line-height: 46rpx;
}

.guess-subtitle {
  margin-top: 4rpx;
  color: #8c8880;
  font-size: 22rpx;
  line-height: 32rpx;
}

.cart-page .change-btn {
  width: auto;
  min-width: 0;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin: 0 -8rpx 0 0;
  padding: 16rpx 8rpx;
  background: transparent;
  color: #817c72;
  font-size: 23rpx;
  line-height: 32rpx;
}

.refresh-icon {
  width: 26rpx;
  height: 26rpx;
}

.cart-page .change-btn.loading {
  opacity: 0.55;
}

.guess-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 20rpx;
}

.guess-card {
  overflow: hidden;
  border-radius: 28rpx;
  background: #fff;
}

.guess-image-wrap {
  position: relative;
  width: 100%;
  padding-top: 100%;
  background: #f0efeb;
}

.guess-img {
  position: absolute;
  inset: 0;
  display: block;
  width: 100%;
  height: 100%;
}

.guess-info {
  padding: 18rpx 20rpx 22rpx;
}

.guess-name {
  height: 72rpx;
  color: #3b3932;
  font-size: 25rpx;
  line-height: 36rpx;
  font-weight: 500;
  overflow: hidden;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.guess-price {
  margin-top: 14rpx;
  color: #ed620b;
  font-size: 34rpx;
  line-height: 42rpx;
  font-weight: 700;
}

/* 原生 tabBar 已占用窗口底部，不重复叠加 tabBar 和安全区高度。 */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 20;
  min-height: 128rpx;
  padding: 20rpx 32rpx;
  display: flex;
  align-items: center;
  gap: 18rpx;
  background: #fff;
  border-top: 1rpx solid #f0eeea;
  box-shadow: 0 -8rpx 32rpx rgba(42, 35, 24, 0.035);
  box-sizing: border-box;
}

.select-all {
  flex-shrink: 0;
  align-self: stretch;
  display: flex;
  align-items: center;
  gap: 10rpx;
  color: #6d6960;
  font-size: 24rpx;
}

.total-wrap {
  flex: 1;
  min-width: 0;
  text-align: right;
}

.total-label {
  display: block;
  color: #878277;
  font-size: 20rpx;
  line-height: 28rpx;
}

.total {
  display: block;
  color: #ed620b;
  font-size: 37rpx;
  line-height: 46rpx;
  font-weight: 700;
  overflow-wrap: anywhere;
}

.cart-page .checkout-btn, .cart-page .batch-delete-btn {
  display: flex;
  width: auto;
  flex-shrink: 0;
  min-width: 220rpx;
  height: 84rpx;
  margin: 0;
  padding: 0 22rpx;
  border-radius: 48rpx;
  background: #ff6600;
  color: #fff;
  font-size: 27rpx;
  line-height: 1;
  font-weight: 600;
}

.manage-count {
  flex: 1;
  color: #878277;
  font-size: 24rpx;
  text-align: right;
}

.cart-page .batch-delete-btn {
  min-width: 180rpx;
  background: #fff2ef;
  color: #c84e3c;
}

.cart-empty-card {
  padding: 72rpx 32rpx;
  border-radius: 36rpx;
  background: #fff;
  text-align: center;
}

.empty-icon {
  width: 104rpx;
  height: 104rpx;
  margin-bottom: 24rpx;
  opacity: 0.6;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 600;
}

.empty-desc {
  margin-top: 12rpx;
  color: #8c8880;
  font-size: 24rpx;
}

.cart-page .shop-btn {
  display: flex;
  width: 204rpx;
  height: 72rpx;
  margin: 32rpx auto 0;
  border-radius: 40rpx;
  background: #ff6600;
  color: #fff;
  font-size: 26rpx;
  font-weight: 500;
}

@media (max-width: 350px) {
  .cart-page {
    padding-left: 24rpx;
    padding-right: 24rpx;
  }
  .item-img {
    width: 160rpx;
    height: 160rpx;
  }
  .item-info {
    padding-left: 16rpx;
  }
  .bottom-bar {
    padding-left: 24rpx;
    padding-right: 24rpx;
    gap: 12rpx;
  }
  .cart-page .checkout-btn {
    min-width: 204rpx;
    padding: 0 14rpx;
  }
  .total {
    font-size: 34rpx;
  }
}
