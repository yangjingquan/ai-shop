.cart-page {
  min-height: 100vh;
  padding: 20rpx 24rpx 184rpx;
  background: #f7f4ed;
  box-sizing: border-box;
}

.cart-page.is-empty {
  padding-top: 0;
}

.cart-topbar {
  height: 76rpx;
  display: flex;
  align-items: center;
  justify-content: flex-end;
}

.cart-title {
  color: #17191f;
  font-size: 44rpx;
  line-height: 1;
  font-weight: 900;
  letter-spacing: 0;
}

.manage-btn {
  height: 54rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: normal;
  padding: 0 22rpx;
  border-radius: 16rpx;
  color: #5f626b;
  background: #fff;
  font-size: 24rpx;
  font-weight: 800;
  box-shadow: 0 8rpx 20rpx rgba(55, 47, 36, 0.06);
}

.cart-empty-card {
  min-height: 360rpx;
  margin-top: 24rpx;
  padding: 56rpx 32rpx;
  border-radius: 18rpx;
  background: #fff;
  box-shadow: 0 9rpx 18rpx rgba(50, 44, 36, 0.06);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.empty-icon {
  width: 96rpx;
  height: 96rpx;
  opacity: 0.78;
}

.empty-title {
  margin-top: 20rpx;
  color: #17191f;
  font-size: 32rpx;
  font-weight: 900;
}

.empty-desc {
  margin-top: 8rpx;
  color: #8b8e97;
  font-size: 22rpx;
  font-weight: 700;
}

.shop-btn {
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: normal;
  margin-top: 20rpx;
  padding: 0 32rpx;
  border-radius: 16rpx;
  color: #17191f;
  background: #c7ff6b;
  font-size: 24rpx;
  font-weight: 900;
}

.merchant-header {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 18rpx 4rpx 14rpx;
  color: #17191f;
  font-size: 28rpx;
  font-weight: 900;
}

.merchant-header .icon {
  opacity: 0.62;
}

.swipe-wrap {
  position: relative;
  overflow: hidden;
  margin-bottom: 14rpx;
  border-radius: 16rpx;
}

.delete-action {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  width: 144rpx;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  align-items: center;
  justify-content: center;
  color: #fff;
  background: #ff756d;
  font-size: 24rpx;
  font-weight: 900;
}

.delete-icon {
  width: 34rpx;
  height: 34rpx;
  filter: brightness(0) invert(1);
}

.cart-item {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  min-height: 188rpx;
  padding: 18rpx;
  border-radius: 16rpx;
  background: #fff;
  box-shadow: 0 10rpx 22rpx rgba(50, 44, 36, 0.06);
  transition: transform 0.18s ease;
  box-sizing: border-box;
}

.check-btn {
  flex: 0 0 auto;
  width: 40rpx;
  height: 40rpx;
  border: 2rpx solid #d6dae0;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #fff;
  box-sizing: border-box;
}

.check-btn.checked {
  border-color: #ff6600;
  background: #fff7f0;
}

.check-btn.disabled {
  border-color: #eef0f3;
  background: #f6f7f9;
}

.check-icon {
  width: 28rpx;
  height: 28rpx;
}

.bottom-check {
  margin-right: 10rpx;
}

.item-img {
  flex: 0 0 auto;
  width: 152rpx;
  height: 152rpx;
  margin-left: 18rpx;
  border-radius: 16rpx;
  background: #e7fbff;
}

.item-info {
  flex: 1;
  min-width: 0;
  min-height: 152rpx;
  padding-left: 18rpx;
  position: relative;
}

.item-name {
  color: #17191f;
  font-size: 27rpx;
  line-height: 34rpx;
  font-weight: 900;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.item-spec {
  margin-top: 8rpx;
  color: #8b8e97;
  font-size: 22rpx;
  font-weight: 700;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.item-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 22rpx;
}

.item-price {
  color: #ff6600;
  font-size: 30rpx;
  font-weight: 900;
}

.qty-stepper {
  height: 52rpx;
  display: grid;
  grid-template-columns: 52rpx 56rpx 52rpx;
  overflow: hidden;
  border-radius: 14rpx;
  background: #f4f2ec;
  text-align: center;
  font-size: 24rpx;
  font-weight: 900;
}

.qty-btn {
  display: flex;
  align-items: center;
  justify-content: center;
}

.qty-btn .icon {
  opacity: 0.66;
}

.qty-btn.disabled {
  opacity: 0.3;
}

.qty-num {
  height: 52rpx;
  line-height: 52rpx;
  text-align: center;
  color: #17191f;
  background: #fff;
  font-size: 24rpx;
  font-weight: 900;
}

.unavailable-tip {
  display: flex;
  align-items: center;
  gap: 8rpx;
  color: #ff4b43;
  font-size: 22rpx;
  font-weight: 700;
  margin-top: 8rpx;
}

.unavailable-tip .icon {
  opacity: 0.7;
}

.guess-section {
  margin-top: 26rpx;
}

.guess-head {
  height: 66rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.guess-title {
  color: #17191f;
  font-size: 34rpx;
  font-weight: 900;
}

.change-btn {
  height: 52rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: normal;
  padding: 0 20rpx;
  border-radius: 14rpx;
  color: #17191f;
  background: #ffef68;
  font-size: 22rpx;
  font-weight: 900;
}

.change-btn.loading {
  opacity: 0.64;
}

.guess-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
}

.guess-card {
  min-height: 140rpx;
  display: flex;
  gap: 14rpx;
  padding: 16rpx;
  border-radius: 16rpx;
  background: #fff;
  box-shadow: 0 8rpx 18rpx rgba(50, 44, 36, 0.05);
  box-sizing: border-box;
}

.guess-img {
  flex: 0 0 auto;
  width: 108rpx;
  height: 108rpx;
  border-radius: 14rpx;
  background: #f3f4f6;
}

.guess-info {
  min-width: 0;
  flex: 1;
}

.guess-name {
  color: #17191f;
  font-size: 24rpx;
  line-height: 30rpx;
  font-weight: 800;
  overflow: hidden;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.guess-price {
  margin-top: 12rpx;
  color: #ff6600;
  font-size: 26rpx;
  font-weight: 900;
}

.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 20;
  min-height: 110rpx;
  background: rgba(255, 255, 255, 0.96);
  padding: 18rpx 24rpx;
  padding-bottom: calc(18rpx + env(safe-area-inset-bottom));
  display: flex;
  align-items: center;
  box-shadow: 0 -8rpx 28rpx rgba(15, 23, 42, 0.06);
  border-top: 1rpx solid rgba(23, 25, 31, 0.06);
  box-sizing: border-box;
}

.select-all {
  display: flex;
  align-items: center;
  color: #5f626b;
  font-size: 26rpx;
  font-weight: 800;
}

.total-wrap {
  flex: 1;
  min-width: 0;
  margin: 0 18rpx;
  text-align: right;
}

.total-label {
  display: block;
  color: #8b8e97;
  font-size: 22rpx;
  font-weight: 700;
}

.total {
  display: block;
  color: #ff6600;
  font-size: 36rpx;
  line-height: 42rpx;
  font-weight: 900;
}

.checkout-btn,
.batch-delete-btn {
  height: 76rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: normal;
  margin: 0;
  border-radius: 18rpx;
  color: #fff;
  font-size: 28rpx;
  font-weight: 900;
  box-sizing: border-box;
}

.checkout-btn {
  min-width: 220rpx;
  padding: 0 32rpx;
  background: #ff6600;
}

.manage-total-spacer {
  visibility: hidden;
}

.batch-delete-btn {
  width: 220rpx;
  min-width: 220rpx;
  margin: 0;
  padding: 0 44rpx;
  background: #ff4b43;
}

.checkout-btn::after,
.batch-delete-btn::after {
  border: 0;
}
