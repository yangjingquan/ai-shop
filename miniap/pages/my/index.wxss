.my-page {
  width: 100%;
  min-height: 100vh;
  padding-top: 0;
  padding-left: 0;
  padding-right: 0;
  background: #F6F6F8;
  box-sizing: border-box;
  overflow-x: hidden;
}

.my-body {
  width: 100%;
  padding: 0 32rpx;
  box-sizing: border-box;
}

.my-hero {
  margin: 0 -32rpx;
  padding-bottom: 108rpx;
}

.my-hero-blob-left {
  left: -80rpx;
  right: auto;
  top: auto;
  bottom: 40rpx;
  width: 240rpx;
  height: 240rpx;
}

.my-profile-wrap {
  position: relative;
  z-index: 1;
  padding: 16rpx 40rpx 0;
}

.profile-main {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  width: 100%;
  padding: 16rpx 0 0;
}

.avatar-btn {
  position: relative;
  width: 136rpx;
  height: 136rpx;
  margin: 0 28rpx 0 0;
  padding: 0;
  overflow: visible;
  border-radius: 48rpx;
  background: transparent;
  line-height: 1;
}

.avatar {
  width: 136rpx;
  height: 136rpx;
  border: 6rpx solid rgba(255, 255, 255, 0.7);
  border-radius: 48rpx;
  background: linear-gradient(135deg, #FFE3D6, #fff);
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.12);
}

.profile-info { flex: 1; min-width: 0; }

.profile-kicker {
  margin-bottom: 6rpx;
  color: rgba(255, 255, 255, 0.85);
  font-size: 22rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
}

.nickname-input {
  min-height: 56rpx;
  margin-bottom: 8rpx;
  color: #fff;
  font-size: 40rpx;
  font-weight: 900;
}

.placeholder { color: rgba(255, 255, 255, 0.7); }

.member-tier {
  display: inline-flex;
  align-items: center;
  max-width: 100%;
  height: 48rpx;
  margin: 0;
  padding: 0 16rpx 0 8rpx;
  overflow: hidden;
  border-radius: 28rpx;
  background: #15161C;
  color: #fff;
  white-space: nowrap;
}

.member-tier-hover { opacity: 0.9; transform: scale(0.98); }

.member-tier-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 32rpx;
  height: 32rpx;
  margin-right: 8rpx;
  border-radius: 50%;
  background: #FFD23F;
  color: #15161C;
  font-size: 20rpx;
  font-weight: 900;
  font-style: italic;
  line-height: 1;
}

.member-tier-label {
  margin-right: 8rpx;
  color: #fff;
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.member-tier-name {
  max-width: 150rpx;
  overflow: hidden;
  font-size: 22rpx;
  font-weight: 800;
  color: #FFD23F;
  text-overflow: ellipsis;
}

.member-tier-level {
  margin-left: 8rpx;
  color: #FFD23F;
  font-size: 20rpx;
  font-weight: 700;
}

.member-tier-arrow {
  margin-left: 8rpx;
  color: rgba(255, 255, 255, 0.9);
  font-size: 32rpx;
  font-weight: 400;
  line-height: 1;
}

.profile-divider {
  width: 100%;
  height: 1rpx;
  margin-top: 28rpx;
  background: rgba(255, 255, 255, 0.25);
}

.profile-phone-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  min-height: 88rpx;
  margin-top: 32rpx;
  padding: 28rpx 0 8rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.25);
  font-size: 26rpx;
  color: #fff;
}

.phone-bound {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.phone-status-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #7CFFB2;
}

.phone-arrow {
  color: rgba(255, 255, 255, 0.85);
  font-size: 34rpx;
  font-weight: 400;
  line-height: 1;
}

.bind-btn {
  flex: 0 0 auto;
  width: auto;
  height: 60rpx;
  margin: 0 0 0 auto;
  padding: 0 28rpx;
  border: 0;
  border-radius: 30rpx;
  background: #fff;
  color: #FF4A1C;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 60rpx;
  text-align: center;
}

.bind-btn-hover {
  background: #ffede3;
  opacity: 0.88;
  transform: scale(0.98);
}

.points-card {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: stretch;
  width: 100%;
  margin: -108rpx 0 24rpx;
  overflow: hidden;
  border-radius: 40rpx;
  background: #fff;
  box-shadow: 0 20rpx 60rpx rgba(255, 74, 28, 0.12);
  box-sizing: border-box;
}

.points-card-main {
  flex: 1;
  min-width: 0;
  padding: 32rpx 36rpx;
  color: #15161C;
}

.points-card-label {
  font-size: 24rpx;
  color: #5B5F6B;
}

.points-card-value {
  margin-top: 4rpx;
  font-size: 64rpx;
  font-weight: 900;
  line-height: 1.05;
  font-family: 'DIN Alternate', 'Roboto Condensed', sans-serif;
}

.points-card-desc {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #FF4A1C;
  font-weight: 700;
}

.points-day {
  display: flex;
  flex-direction: column;
  justify-content: center;
  flex: none;
  width: 260rpx;
  padding: 32rpx 28rpx;
  background: linear-gradient(160deg, #FFD23F, #FFB400);
  color: #15161C;
  font-size: 30rpx;
  font-weight: 900;
  gap: 8rpx;
  box-sizing: border-box;
}

.points-day-desc {
  font-size: 22rpx;
  font-weight: 600;
  white-space: nowrap;
}

.service-section {
  width: 100%;
  margin-bottom: 20rpx;
  padding: 28rpx;
  box-sizing: border-box;
}

.section-heading {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.section-title {
  color: #15161C;
  font-size: 34rpx;
  font-weight: 800;
}

.section-caption {
  color: #9A9EA8;
  font-size: 24rpx;
}

.service-grid {
  display: grid;
  grid-template-columns: repeat(5, minmax(0, 1fr));
  gap: 8rpx;
}

.service-item {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
  width: 100%;
  padding: 8rpx 0 12rpx;
  color: #5B5F6B;
  font-size: 24rpx;
  line-height: 1.35;
  text-align: center;
  background: transparent;
}

.service-label {
  display: block;
  width: 100%;
}

.service-item-hover {
  opacity: 0.85;
}

.service-badge {
  position: absolute;
  top: 0;
  right: 4rpx;
  min-width: 28rpx;
  height: 28rpx;
  padding: 0 7rpx;
  border: 2rpx solid #fff;
  border-radius: 16rpx;
  background: #FF4A1C;
  color: #fff;
  font-size: 17rpx;
  line-height: 24rpx;
  text-align: center;
}

/* A single CSS-drawn icon family: 2rpx warm-orange rounded strokes in 56rpx tiles. */
.service-tile {
  width: 88rpx;
  height: 88rpx;
  margin: 0 auto 12rpx;
  border-radius: 30rpx;
  flex: none;
}

.service-icon::before,
.service-icon::after,
.service-icon view::before,
.service-icon view::after {
  position: absolute;
  display: block;
  box-sizing: border-box;
  content: '';
}

.service-icon-message::before {
  top: 16rpx;
  left: 13rpx;
  width: 30rpx;
  height: 22rpx;
  border: 3rpx solid #e65a2b;
  border-radius: 10rpx;
}
.service-icon-message::after {
  bottom: 13rpx;
  left: 19rpx;
  width: 9rpx;
  height: 9rpx;
  border-bottom: 3rpx solid #e65a2b;
  border-left: 3rpx solid #e65a2b;
  transform: rotate(-22deg);
}

.service-icon-location::before {
  top: 10rpx;
  left: 17rpx;
  width: 22rpx;
  height: 28rpx;
  border: 3rpx solid #e65a2b;
  border-radius: 14rpx 14rpx 14rpx 0;
  transform: rotate(-45deg);
}
.service-icon-location::after {
  top: 20rpx;
  left: 23rpx;
  width: 10rpx;
  height: 10rpx;
  border: 3rpx solid #e65a2b;
  border-radius: 50%;
}

.service-icon-order::before {
  top: 12rpx;
  left: 16rpx;
  width: 25rpx;
  height: 32rpx;
  border: 3rpx solid #e65a2b;
  border-radius: 5rpx;
}
.service-icon-order::after {
  top: 21rpx;
  left: 22rpx;
  width: 14rpx;
  height: 3rpx;
  border-radius: 2rpx;
  background: #e65a2b;
  box-shadow: 0 8rpx 0 #e65a2b;
}

.service-icon-coupon::before {
  top: 16rpx;
  left: 10rpx;
  width: 36rpx;
  height: 24rpx;
  border: 3rpx solid #e65a2b;
  border-radius: 6rpx;
}
.service-icon-coupon::after {
  top: 18rpx;
  left: 28rpx;
  width: 1rpx;
  height: 20rpx;
  border-left: 3rpx dashed #e65a2b;
}
.service-icon-coupon view::before,
.service-icon-coupon view::after {
  left: 24rpx;
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: #fff1e7;
}
.service-icon-coupon view::before { top: 12rpx; }
.service-icon-coupon view::after { bottom: 12rpx; }

.service-icon-gift::before {
  top: 22rpx;
  left: 13rpx;
  width: 30rpx;
  height: 22rpx;
  border: 3rpx solid #e65a2b;
  border-radius: 4rpx;
}
.service-icon-gift::after {
  top: 13rpx;
  left: 11rpx;
  width: 34rpx;
  height: 11rpx;
  border: 3rpx solid #e65a2b;
  border-radius: 4rpx;
}
.service-icon-gift view::before {
  top: 13rpx;
  left: 26rpx;
  width: 4rpx;
  height: 31rpx;
  border-radius: 2rpx;
  background: #e65a2b;
}

.asset-section {
  width: 100%;
  margin-bottom: 24rpx;
  padding: 28rpx;
  box-sizing: border-box;
}

.asset-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 20rpx;
  width: 100%;
}

.asset-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  min-height: 120rpx;
  padding: 24rpx;
  border-radius: 28rpx;
  background: #F6F6F8;
  color: #15161C;
  box-sizing: border-box;
  width: 100%;
}

.asset-thumb {
  width: 72rpx;
  height: 72rpx;
  flex: none;
  border-radius: 24rpx;
}

.asset-copy {
  flex: 1;
  min-width: 0;
}

.asset-title {
  display: block;
  font-size: 28rpx;
  font-weight: 800;
  color: #15161C;
}

.asset-desc {
  display: block;
  margin-top: 4rpx;
  font-size: 20rpx;
  color: #9A9EA8;
}

.asset-item-hover {
  opacity: 0.92;
}
.asset-icon { position: relative; flex: 0 0 auto; width: 52rpx; height: 52rpx; margin-right: 14rpx; border-radius: 16rpx; background: #fff1e7; }
.asset-icon::before, .asset-icon::after, .asset-icon view::before, .asset-icon view::after { position: absolute; box-sizing: border-box; content: ''; }
.asset-icon-favorite::before { top: 15rpx; left: 13rpx; width: 24rpx; height: 22rpx; border: 3rpx solid #e65a2b; border-top: 0; border-left: 0; border-radius: 0 4rpx 10rpx 4rpx; transform: rotate(45deg); }
.asset-icon-favorite::after { top: 13rpx; left: 14rpx; width: 14rpx; height: 14rpx; border: 3rpx solid #e65a2b; border-right: 0; border-bottom: 0; border-radius: 10rpx 10rpx 0 0; transform: rotate(45deg); }
.asset-icon-history::before { top: 11rpx; left: 11rpx; width: 28rpx; height: 28rpx; border: 3rpx solid #e65a2b; border-radius: 50%; }
.asset-icon-history::after { top: 18rpx; left: 25rpx; width: 10rpx; height: 12rpx; border-top: 3rpx solid #e65a2b; border-left: 3rpx solid #e65a2b; }
.asset-title { color: #49382d; font-size: 26rpx; font-weight: 700; line-height: 1.35; }.asset-desc { margin-top: 5rpx; color: #a6978b; font-size: 20rpx; line-height: 1.35; }.asset-arrow { margin-left: auto; color: #baaa9e; font-size: 32rpx; line-height: 1; }
