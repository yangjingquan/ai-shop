<view class="my-page page-shell">
  <view class="profile-card">
    <view class="profile-glow profile-glow-left"></view>
    <view class="profile-glow profile-glow-right"></view>
    <view class="profile-main">
      <button class="avatar-btn" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
        <image class="avatar" src="{{ avatarUrl || '/images/default-avatar.png' }}" mode="aspectFill" />
      </button>
      <view class="profile-info">
        <view class="profile-kicker">我的昵称</view>
        <input
          class="nickname-input"
          type="nickname"
          value="{{ nickname }}"
          placeholder="请输入昵称"
          placeholder-class="placeholder"
          bindinput="onNicknameInput"
          bindblur="onNicknameBlur"
        />
        <view
          wx:if="{{pointsEnabled}}"
          class="member-tier"
          hover-class="member-tier-hover"
          bindtap="goPoints"
        >
          <view class="member-tier-mark">V</view>
          <text class="member-tier-label">会员等级</text>
          <text class="member-tier-name">{{pointsProfile.levelName || '普通会员'}}</text>
          <text class="member-tier-level">Lv.{{pointsProfile.level || 1}}</text>
          <text class="member-tier-arrow">›</text>
        </view>
      </view>
    </view>
    <view class="profile-divider"></view>
    <view class="profile-phone-row">
      <view wx:if="{{ phone }}" class="phone-bound">
        <view class="phone-status-icon"></view>
        <text>已绑定手机号</text>
      </view>
      <button
        wx:else
        class="bind-btn"
        hover-class="bind-btn-hover"
        open-type="getPhoneNumber"
        bindgetphonenumber="onGetPhone"
      >绑定手机号</button>
      <view wx:if="{{ phone }}" class="phone-arrow">›</view>
    </view>
  </view>

  <view wx:if="{{pointsEnabled}}" class="points-card">
    <view class="points-card-main" bindtap="goPointsMall">
      <view class="points-card-label">我的积分</view>
      <view class="points-card-value">{{pointsProfile.balance || 0}}</view>
      <view class="points-card-desc">去积分商城兑换好礼</view>
    </view>
    <view class="points-divider"></view>
    <view class="points-day" bindtap="goMemberDay">
      <text>{{pointsProfile.memberDayActive ? '今日会员日' : '积分会员日'}}</text>
      <text class="points-day-desc" wx:if="{{pointsProfile.memberDay}}">{{pointsProfile.memberDayActive ? '双倍积分进行中' : ('每月' + pointsProfile.memberDay + '日') }} ›</text>
    </view>
  </view>

  <view class="service-section">
    <view class="section-heading">
      <view class="section-title">常用服务</view>
      <view class="section-caption">账户与订单服务</view>
    </view>
    <view class="service-grid">
      <view class="service-item" hover-class="service-item-hover" bindtap="goNotifications">
        <view class="service-icon service-icon-message"><view></view></view>
        <text>消息中心</text>
        <view wx:if="{{unreadCount > 0}}" class="service-badge">{{unreadCount > 99 ? '99+' : unreadCount}}</view>
      </view>
      <navigator class="service-item" url="/pages/address/list" hover-class="service-item-hover">
        <view class="service-icon service-icon-location"><view></view></view>
        <text>收货地址</text>
      </navigator>
      <view class="service-item" hover-class="service-item-hover" bindtap="goOrders">
        <view class="service-icon service-icon-order"><view></view></view>
        <text>我的订单</text>
      </view>
      <view wx:if="{{couponEnabled}}" class="service-item" hover-class="service-item-hover" bindtap="goCoupons">
        <view class="service-icon service-icon-coupon"><view></view></view>
        <text>优惠券</text>
        <view wx:if="{{couponCount > 0}}" class="service-badge">{{couponCount > 99 ? '99+' : couponCount}}</view>
      </view>
      <view wx:if="{{referralEnabled}}" class="service-item" hover-class="service-item-hover" bindtap="goReferral">
        <view class="service-icon service-icon-gift"><view></view></view>
        <text>分享有礼</text>
      </view>
    </view>
  </view>

  <view class="asset-section">
    <view class="section-heading">
      <view class="section-title">商品服务</view>
      <view class="section-caption">收藏与浏览足迹</view>
    </view>
    <view class="asset-grid">
      <view class="asset-item" hover-class="asset-item-hover" bindtap="goFavorites">
        <view class="asset-icon asset-icon-favorite"><view></view></view>
        <view><view class="asset-title">我的收藏</view><view class="asset-desc">收藏的心仪商品</view></view>
        <view class="asset-arrow">›</view>
      </view>
      <view class="asset-item" hover-class="asset-item-hover" bindtap="goHistory">
        <view class="asset-icon asset-icon-history"><view></view></view>
        <view><view class="asset-title">浏览记录</view><view class="asset-desc">最近看过的商品</view></view>
        <view class="asset-arrow">›</view>
      </view>
    </view>
  </view>
</view>
