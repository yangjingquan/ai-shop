page {
  background: #f7f4ed;
}

.recommend-page {
  min-height: 100vh;
  background: #f7f4ed;
  color: #17191f;
  box-sizing: border-box;
}

.content {
  padding: 20rpx 32rpx 36rpx;
  box-sizing: border-box;
}

.hero {
  height: 236rpx;
  margin-top: 0;
  padding: 28rpx;
  position: relative;
  overflow: hidden;
  border-radius: 16rpx;
  color: #fff;
  background:
    radial-gradient(circle at 84% 30%, #ffef68 0 18%, transparent 19%),
    linear-gradient(132deg, #17191f 0%, #252b36 55%, #ff5f55 56%, #ff8c68 100%);
  box-shadow: 0 32rpx 60rpx rgba(225, 74, 62, 0.16);
  box-sizing: border-box;
}

.hero-kicker {
  width: max-content;
  height: 46rpx;
  display: flex;
  align-items: center;
  padding: 0 16rpx;
  border-radius: 12rpx;
  color: #17191f;
  background: #c7ff6b;
  font-size: 20rpx;
  font-weight: 900;
}

.hero-title {
  margin-top: 20rpx;
  font-size: 52rpx;
  line-height: 1;
  font-weight: 950;
}

.hero-desc {
  margin-top: 8rpx;
  color: rgba(255, 255, 255, 0.72);
  font-size: 22rpx;
  font-weight: 760;
}

.filters {
  height: 72rpx;
  margin-top: 24rpx;
  white-space: nowrap;
}

.filter-track {
  display: inline-flex;
  gap: 16rpx;
}

.chip {
  height: 64rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 0 24rpx;
  border-radius: 16rpx;
  color: #4d515a;
  background: #fff;
  font-size: 24rpx;
  font-weight: 850;
  box-shadow: 0 14rpx 30rpx rgba(50, 44, 36, 0.05);
}

.chip.active {
  color: #fff;
  background: #17191f;
}

.showcase {
  margin-top: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.feature {
  height: 308rpx;
  display: grid;
  grid-template-columns: 1fr 208rpx;
  gap: 20rpx;
  padding: 24rpx;
  border-radius: 16rpx;
  background: #fff;
  box-shadow: 0 20rpx 44rpx rgba(50, 44, 36, 0.07);
  box-sizing: border-box;
}

.feature-info {
  min-width: 0;
  padding-top: 10rpx;
}

.top-no {
  color: #ff4b43;
  font-size: 22rpx;
  font-weight: 950;
}

.feature-title {
  margin: 18rpx 0 14rpx;
  font-size: 38rpx;
  line-height: 1.13;
  font-weight: 950;
  overflow: hidden;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.feature-desc {
  color: #8b8e97;
  font-size: 22rpx;
  line-height: 1.35;
  font-weight: 760;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.price {
  margin-top: 14rpx;
  color: #ff4b43;
  font-size: 30rpx;
  font-weight: 950;
}

.price.big {
  margin-top: 24rpx;
  font-size: 40rpx;
}

.visual,
.visual-img {
  width: 208rpx;
  height: 236rpx;
  align-self: center;
  justify-self: end;
  position: relative;
  overflow: hidden;
  border-radius: 16rpx;
  background: #e7fbff;
}

.visual.phone::before,
.mini-visual.phone::before {
  content: '';
  position: absolute;
  left: 68rpx;
  top: 50rpx;
  width: 72rpx;
  height: 144rpx;
  border-radius: 28rpx;
  background: #17191f;
  transform: rotate(-7deg);
}

.visual.phone::after,
.mini-visual.phone::after {
  content: '';
  position: absolute;
  left: 86rpx;
  top: 78rpx;
  width: 36rpx;
  height: 68rpx;
  border-radius: 14rpx;
  background: #4ac8ff;
  transform: rotate(-7deg);
}

.pair-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
}

.pick {
  height: 348rpx;
  padding: 18rpx;
  border-radius: 16rpx;
  background: #fff;
  box-shadow: 0 20rpx 44rpx rgba(50, 44, 36, 0.06);
  box-sizing: border-box;
}

.mini-visual,
.mini-img {
  width: 100%;
  height: 164rpx;
  position: relative;
  overflow: hidden;
  border-radius: 16rpx;
  background: #fff3b7;
}

.mini-visual.watch::before {
  content: '';
  position: absolute;
  left: 108rpx;
  top: 18rpx;
  width: 24rpx;
  height: 128rpx;
  border-radius: 16rpx;
  background: #17191f;
  transform: rotate(-7deg);
}

.mini-visual.watch::after {
  content: '';
  position: absolute;
  left: 68rpx;
  top: 50rpx;
  width: 96rpx;
  height: 96rpx;
  border: 16rpx solid #17191f;
  border-radius: 50%;
  background: #c7ff6b;
  box-sizing: border-box;
}

.mini-visual.audio {
  background: radial-gradient(circle at 32% 72%, #ff5f55 0 22rpx, transparent 24rpx), radial-gradient(circle at 68% 72%, #ff5f55 0 22rpx, transparent 24rpx), #ffe1de;
}

.mini-visual.audio::before {
  content: '';
  position: absolute;
  left: 50rpx;
  top: 54rpx;
  width: 144rpx;
  height: 84rpx;
  border: 18rpx solid #17191f;
  border-bottom: 0;
  border-radius: 76rpx 76rpx 0 0;
  box-sizing: border-box;
}

.mini-visual.bag {
  background: linear-gradient(#ff6a5c, #d83736) 74rpx 70rpx / 100rpx 72rpx no-repeat, radial-gradient(circle at 50% 28%, transparent 34rpx, #17191f 36rpx 42rpx, transparent 44rpx), #e5ffd8;
}

.pick-title {
  margin: 18rpx 0 10rpx;
  font-size: 26rpx;
  line-height: 1.2;
  font-weight: 950;
  overflow: hidden;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.pick-desc {
  color: #8b8e97;
  font-size: 20rpx;
  line-height: 1.25;
  font-weight: 760;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.rank {
  height: 168rpx;
  display: grid;
  grid-template-columns: 104rpx 1fr auto;
  gap: 20rpx;
  align-items: center;
  padding: 20rpx;
  border-radius: 16rpx;
  background: linear-gradient(135deg, #fffdf3 0%, #fff3c8 48%, #ffe1de 100%);
  color: #17191f;
  border: 1rpx solid rgba(255, 95, 85, 0.16);
  box-shadow: 0 20rpx 44rpx rgba(225, 74, 62, 0.08);
  box-sizing: border-box;
}

.rank-num {
  color: #ff5f55;
  font-size: 44rpx;
  font-weight: 950;
}

.rank-info {
  min-width: 0;
}

.rank-title {
  margin-bottom: 10rpx;
  font-size: 28rpx;
  font-weight: 950;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.rank-desc {
  color: rgba(23, 25, 31, 0.62);
  font-size: 20rpx;
  font-weight: 760;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.rank-price {
  color: #ff4b43;
  font-size: 32rpx;
  font-weight: 950;
}

.load-footer {
  min-height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #9b8f80;
  font-size: 24rpx;
  font-weight: 760;
}
