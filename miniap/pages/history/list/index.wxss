.record-page{min-height:100vh;padding:24rpx;box-sizing:border-box;background:#f8f5f0}.record-head{display:flex;align-items:center;justify-content:space-between;margin:8rpx 6rpx 20rpx}.record-title{color:#2e211a;font-size:36rpx;font-weight:800}.record-subtitle{margin-top:7rpx;color:#a6978b;font-size:22rpx}.clear-action{padding:10rpx 4rpx;color:#d85a28;font-size:25rpx}.goods-list{background:#fff;border-radius:22rpx;overflow:hidden;box-shadow:0 8rpx 22rpx rgba(75,47,26,.04)}.goods-row{display:flex;align-items:center;min-height:160rpx;padding:20rpx;border-bottom:1rpx solid #f1ebe5;box-sizing:border-box}.goods-row:last-child{border-bottom:0}.goods-row-disabled{opacity:.62}.goods-image{flex:0 0 auto;width:120rpx;height:120rpx;border-radius:16rpx;background:#f6eee5}.goods-image-fallback{display:flex;align-items:center;justify-content:center;color:#d36a36;font-size:38rpx;font-weight:800}.goods-main{flex:1;min-width:0;margin-left:18rpx}.goods-name{overflow:hidden;color:#35271f;font-size:28rpx;font-weight:700;line-height:1.45;text-overflow:ellipsis;white-space:nowrap}.goods-price{margin-top:12rpx;color:#ed5520;font-size:30rpx;font-weight:800}.goods-status{margin-top:12rpx;color:#94877e;font-size:24rpx}.goods-meta{margin-top:9rpx;color:#aa9c91;font-size:21rpx}.remove-btn{flex:0 0 auto;margin:0 0 0 12rpx;padding:0 16rpx;border:1rpx solid #ebc7b3;border-radius:22rpx;background:#fff;color:#d85a28;font-size:21rpx;line-height:44rpx}.remove-btn::after,.go-shopping::after{border:0}.empty-state{padding:172rpx 28rpx;text-align:center}.empty-mark{display:flex;align-items:center;justify-content:center;width:108rpx;height:108rpx;margin:0 auto 24rpx;border-radius:50%;background:#fff0e7;color:#ed5520;font-size:34rpx;font-weight:800}.empty-title{color:#49382d;font-size:30rpx;font-weight:800}.empty-desc{margin-top:12rpx;color:#a6978b;font-size:24rpx;line-height:1.6}.go-shopping{width:190rpx;height:64rpx;margin-top:30rpx;border-radius:34rpx;background:linear-gradient(100deg,#f4511e,#ff7a1a);color:#fff;font-size:25rpx;font-weight:700;line-height:64rpx}.load-state{padding:28rpx 0 calc(28rpx + env(safe-area-inset-bottom));color:#aa9c91;font-size:22rpx;text-align:center}
