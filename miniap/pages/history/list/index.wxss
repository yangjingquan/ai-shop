.history-page {
  width: 100%;
  min-height: 100vh;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.history-page .page-section-head {
  margin: 32rpx 0 24rpx;
}

.hero-clear-btn {
  position: absolute;
  right: 32rpx;
  top: 120rpx;
  height: 56rpx;
  padding: 0 24rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.6);
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.2);
  color: #fff;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 52rpx;
  text-align: center;
  box-sizing: border-box;
}

.history-list {
  padding-left: 4rpx;
}

.history-row {
  display: flex;
  gap: 20rpx;
  margin-bottom: 8rpx;
}

.history-row-disabled {
  opacity: 0.72;
}

.timeline {
  position: relative;
  flex: none;
  width: 28rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.timeline-marker {
  width: 20rpx;
  height: 20rpx;
  margin-top: 40rpx;
  border-radius: 50%;
  background: #D5D8E0;
  flex: none;
  z-index: 1;
}

.timeline-marker-active {
  background: #FF4A1C;
  box-shadow: 0 0 0 8rpx #FFF1EB;
}

.timeline-line {
  flex: 1;
  width: 4rpx;
  margin-top: 8rpx;
  background: #ECEDF0;
}

.history-row:last-child .timeline-line {
  display: none;
}

.record-card {
  flex: 1;
  display: flex;
  gap: 20rpx;
  margin: 12rpx 0 20rpx;
  padding: 20rpx;
  min-width: 0;
}

.goods-image {
  flex: none;
  width: 168rpx;
  height: 168rpx;
  border-radius: 24rpx;
}

.goods-image-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  font-weight: 800;
}

.goods-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.record-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.goods-name {
  flex: 1;
  min-width: 0;
  font-size: 26rpx;
  font-weight: 700;
  color: #15161C;
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.remove-link {
  flex: none;
  height: 48rpx;
  padding: 0 20rpx;
  border: 2rpx solid #ECEDF0;
  border-radius: 24rpx;
  background: #fff;
  color: #15161C;
  font-size: 22rpx;
  font-weight: 600;
  line-height: 44rpx;
  text-align: center;
  box-sizing: border-box;
}

.goods-price {
  margin-top: 8rpx;
  font-size: 32rpx;
}

.goods-status {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #5B5F6B;
}

.goods-meta {
  margin-top: auto;
  padding-top: 8rpx;
  font-size: 22rpx;
  color: #9A9EA8;
  line-height: 1.45;
}


.loading-row {
  display: flex;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.loading-card-inner {
  flex: 1;
  display: flex;
  gap: 20rpx;
  padding: 20rpx;
  border-radius: 32rpx;
  background: #fff;
}

.loading-cover {
  width: 168rpx;
  height: 168rpx;
  border-radius: 24rpx;
  flex: none;
}

.loading-copy {
  flex: 1;
  padding-top: 12rpx;
}

.loading-line {
  height: 24rpx;
  border-radius: 12rpx;
  margin-bottom: 16rpx;
}

.loading-price {
  width: 42%;
}

.loading-meta {
  width: 86%;
  margin-top: 24rpx;
}

.skel {
  background: linear-gradient(90deg, #EEF0F3, #F7F8FA, #EEF0F3);
  background-size: 220% 100%;
  animation: hist-skel 1.4s ease-in-out infinite;
}

@keyframes hist-skel {
  0% { background-position: 100% 0; }
  100% { background-position: -120% 0; }
}

.history-action-btn {
  margin-top: 28rpx;
  min-width: 240rpx;
}
