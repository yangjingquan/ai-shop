<view class="record-page">
  <view class="record-head"><view><view class="record-title">浏览记录</view><view class="record-subtitle">最近浏览的商品会保留在这里</view></view><view wx:if="{{items.length}}" class="clear-action" bindtap="clearHistory">清空</view></view>
  <view wx:if="{{items.length}}" class="goods-list">
    <view wx:for="{{items}}" wx:key="productId" class="goods-row {{item.available ? '' : 'goods-row-disabled'}}" data-id="{{item.productId}}" data-available="{{item.available}}" bindtap="openProduct">
      <image wx:if="{{item.mainImage}}" class="goods-image" src="{{item.mainImage}}" mode="aspectFill" />
      <view wx:else class="goods-image goods-image-fallback">{{item.initial}}</view>
      <view class="goods-main"><view class="goods-name">{{item.name}}</view><view wx:if="{{item.available}}" class="goods-price">¥{{item.priceText}}</view><view wx:else class="goods-status">已下架</view><view class="goods-meta"><text wx:if="{{item.viewedAtText}}">浏览于 {{item.viewedAtText}}</text><text wx:if="{{item.viewCountText > 1}}"> · 已浏览 {{item.viewCountText}} 次</text></view></view>
      <button class="remove-btn" catchtap="removeHistory" data-id="{{item.productId}}">删除</button>
    </view>
  </view>
  <view wx:elif="{{!loading}}" class="empty-state"><view class="empty-mark">迹</view><view class="empty-title">暂无浏览记录</view><view class="empty-desc">浏览商品后，会自动记录在这里</view><button class="go-shopping" bindtap="goShopping">去逛逛</button></view>
  <view wx:if="{{loadingMore}}" class="load-state">加载中…</view><view wx:elif="{{items.length && !hasMore}}" class="load-state">没有更多记录了</view>
</view>
