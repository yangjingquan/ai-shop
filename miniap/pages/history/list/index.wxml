<view class="history-page page-shell">
  <view class="page-hero page-hero-primary">
    <view class="hero-blob"></view>
    <view class="hero-top-row">
      <view class="hero-title-stack">
        <view class="hero-kicker">RECENTLY VIEWED</view>
        <view class="hero-heading">浏览记录</view>
      </view>
      <text
        wx:if="{{items.length}}"
        class="hero-action-pill"
        catchtap="clearHistory"
      >{{clearing ? '清空中' : '清空'}}</text>
    </view>
    <view class="hero-desc">最近看过的商品，都留在这里</view>
  </view>

  <view class="page-body page-body-lift">
    <view wx:if="{{loading && !items.length}}" class="loading-list">
      <view wx:for="{{[1, 2, 3]}}" wx:key="*this" class="loading-row">
        <view class="timeline-marker skel"></view>
        <view class="loading-card-inner">
          <view class="loading-cover skel"></view>
          <view class="loading-copy">
            <view class="loading-line skel"></view>
            <view class="loading-line skel loading-price"></view>
            <view class="loading-line skel loading-meta"></view>
          </view>
        </view>
      </view>
    </view>

    <block wx:elif="{{items.length}}">
      <view class="page-section-head">
        <text class="page-section-title">最近浏览</text>
        <text class="page-section-tip">共 {{total}} 件商品</text>
      </view>
      <view class="history-list">
        <view
          wx:for="{{items}}"
          wx:key="productId"
          class="history-row {{item.available ? '' : 'history-row-disabled'}}"
          data-id="{{item.productId}}"
          data-available="{{item.available}}"
          bindtap="openProduct"
        >
          <view class="timeline">
            <view class="timeline-marker {{index === 0 ? 'timeline-marker-active' : ''}}"></view>
            <view class="timeline-line"></view>
          </view>
          <view class="record-card card">
            <image wx:if="{{item.mainImage}}" class="goods-image" src="{{item.mainImage}}" mode="aspectFill" lazy-load />
            <view wx:else class="goods-image goods-image-fallback img-placeholder img-placeholder-5">{{item.initial}}</view>
            <view class="goods-main">
              <view class="record-top">
                <text class="goods-name">{{item.name}}</text>
                <text
                  class="remove-link"
                  catchtap="removeHistory"
                  data-id="{{item.productId}}"
                >{{removingId === item.productId ? '处理中' : '删除'}}</text>
              </view>
              <view wx:if="{{item.available}}" class="goods-price price"><text>¥</text>{{item.priceText}}</view>
              <view wx:else class="goods-status">该商品暂不可购买</view>
              <view class="goods-meta">
                <text wx:if="{{item.viewedAtText}}">浏览于 {{item.viewedAtText}}</text>
                <block wx:if="{{item.viewCount > 1}}"><text> · 已浏览 {{item.viewCount}} 次</text></block>
              </view>
            </view>
          </view>
        </view>
      </view>
    </block>

    <view wx:else class="empty-state2 card">
      <view class="empty-state2-symbol">足</view>
      <text class="empty-state2-title">{{loadError ? '浏览记录加载失败' : '还没有浏览记录'}}</text>
      <text class="empty-state2-desc">{{loadError ? '网络可能开小差了，请重新加载' : '浏览商品后，会自动记录在这里'}}</text>
      <button wx:if="{{loadError}}" class="btn btn-ghost btn-sm history-action-btn" bindtap="retryLoad">重新加载</button>
      <button wx:else class="btn btn-primary btn-sm history-action-btn" bindtap="goShopping">去逛逛</button>
    </view>

    <view wx:if="{{loadingMore}}" class="page-end-note">正在加载更多记录…</view>
    <view wx:elif="{{items.length && !hasMore}}" class="page-end-note">—— 已经到底了 ——</view>
  </view>
</view>
