page {
  background: #F6F6F8;
}

.cat-page {
  min-height: 100vh;
  width: 100%;
  padding-top: 20rpx;
  padding-left: 32rpx;
  padding-right: 32rpx;
  overflow-x: hidden;
  box-sizing: border-box;
  background: #F6F6F8;
  color: #15161C;
}

.topbar {
  height: 76rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.page-title {
  width: auto;
  font-size: 52rpx;
  line-height: 1;
  font-weight: 900;
  letter-spacing: 0;
  color: #15161C;
}

.search {
  height: 76rpx;
  flex: 1;
  display: flex;
  align-items: center;
  padding: 0 28rpx;
  color: #9A9EA8;
  background: #fff;
  border-radius: 38rpx;
  box-shadow: 0 8rpx 24rpx rgba(20, 22, 28, 0.06);
  font-size: 26rpx;
  font-weight: 400;
  box-sizing: border-box;
}

.layout {
  height: calc(100vh - 240rpx - env(safe-area-inset-bottom));
  min-height: 0;
  margin-top: 24rpx;
  display: grid;
  grid-template-columns: 176rpx 1fr;
  gap: 0;
}

.side {
  height: 100%;
  padding: 12rpx 0;
  background: #F6F6F8;
  box-sizing: border-box;
  scrollbar-width: none;
  -ms-overflow-style: none;
}

.side::-webkit-scrollbar {
  width: 0;
  height: 0;
  display: none;
  color: transparent;
}

.side-item {
  width: 100%;
  min-height: 104rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  color: #5B5F6B;
  font-size: 26rpx;
  line-height: 1.2;
  text-align: center;
  font-weight: 400;
  box-sizing: border-box;
  padding: 0 16rpx;
}

.side-item text {
  max-width: 120rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.side-item.active {
  color: #15161C;
  background: #fff;
  font-weight: 800;
  font-size: 28rpx;
  border-radius: 0 28rpx 28rpx 0;
}

.side-item.active::before {
  content: '';
  width: 8rpx;
  height: 40rpx;
  position: absolute;
  left: 0;
  top: 32rpx;
  border-radius: 4rpx;
  background: linear-gradient(180deg, #FF4A1C, #FF8A00);
}

.empty-side {
  padding: 40rpx 12rpx;
  color: #9A9EA8;
  font-size: 24rpx;
  text-align: center;
}

.main {
  min-width: 0;
  height: 100%;
  min-height: 0;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  box-sizing: border-box;
}

.category-panel {
  flex: 0 0 auto;
  padding: 24rpx 28rpx;
  border-radius: 32rpx;
  background: linear-gradient(135deg, #FFF1EB, #FFF8F2);
  box-sizing: border-box;
}

.category-head {
  min-height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.category-head > text {
  flex: 1;
  min-width: 0;
  font-size: 32rpx;
  line-height: 56rpx;
  font-weight: 900;
  color: #15161C;
}

.expand-toggle {
  flex: 0 0 auto;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: normal;
  padding: 0 24rpx;
  border-radius: 30rpx;
  color: #FF4A1C;
  background: #fff;
  font-size: 24rpx;
  font-weight: 700;
  box-sizing: border-box;
}

.expand-toggle.active {
  color: #fff;
  background: #15161C;
}

.chip-row {
  width: 100%;
  white-space: nowrap;
}

.chip-track {
  display: inline-flex;
  gap: 14rpx;
  min-width: 100%;
}

.cat-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14rpx;
}

.cat-chip {
  min-width: 0;
  height: 68rpx;
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 28rpx;
  border-radius: 34rpx;
  color: #5B5F6B;
  background: #fff;
  font-size: 24rpx;
  font-weight: 600;
  white-space: nowrap;
  box-sizing: border-box;
}

.cat-grid .cat-chip {
  padding: 0 12rpx;
}

.cat-chip.active {
  color: #15161C;
  background: #FFF1EB;
  border: 3rpx solid #FF4A1C;
  font-weight: 800;
}

.section-head {
  flex: 0 0 auto;
  margin: 28rpx 0 20rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.section-title {
  font-size: 34rpx;
  line-height: 1;
  font-weight: 800;
  letter-spacing: 0;
  color: #15161C;
}

.view-toggle {
  flex: 0 0 auto;
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 20rpx;
  color: #5B5F6B;
  background: #F6F6F8;
}

.view-toggle-icon {
  width: 34rpx;
  height: 34rpx;
}

.product-list {
  display: grid;
  gap: 18rpx;
}

.product-scroll {
  flex: 1;
  min-height: 0;
  height: 0;
}

.product-grid {
  grid-template-columns: repeat(2, minmax(0, 1fr));
}

.product-single {
  grid-template-columns: minmax(0, 1fr);
}

.tile {
  min-width: 0;
  min-height: 340rpx;
  padding: 14rpx;
  border-radius: 16rpx;
  background: #fff;
  box-shadow: 0 18rpx 36rpx rgba(50, 44, 36, 0.06);
  box-sizing: border-box;
}

.product-single .tile {
  min-height: 208rpx;
  display: grid;
  grid-template-columns: 172rpx minmax(0, 1fr);
  grid-template-rows: auto auto 1fr;
  column-gap: 20rpx;
  padding: 18rpx;
}

.product-single .tile-media {
  grid-row: 1 / 4;
  height: 172rpx;
}

.product-single .tile-name {
  height: auto;
  min-height: 58rpx;
  margin: 4rpx 0 10rpx;
  font-size: 28rpx;
  line-height: 34rpx;
}

.product-single .tile-desc {
  height: 48rpx;
  font-size: 21rpx;
  line-height: 24rpx;
}

.product-single .price-wrap {
  align-self: end;
  margin-top: 8rpx;
}

.tile-media {
  height: 176rpx;
  position: relative;
  overflow: hidden;
  border-radius: 16rpx;
  background: #eef9ff;
}

.tile-media image {
  width: 100%;
  height: 100%;
  display: block;
}

.tile-media-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #eef9ff;
}

.product-art {
  width: 96rpx;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 28rpx;
  color: #fff;
  background: #17191f;
  transform: rotate(-6deg);
  box-shadow: 0 18rpx 28rpx rgba(23, 25, 31, 0.18);
}

.product-art text {
  display: block;
  transform: rotate(6deg);
  font-size: 38rpx;
  font-weight: 950;
}

.tile-name {
  height: 56rpx;
  margin: 14rpx 0 6rpx;
  color: #17191f;
  font-size: 25rpx;
  line-height: 28rpx;
  font-weight: 950;
  overflow: hidden;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.tile-desc {
  height: 42rpx;
  margin: 0;
  color: #8b8e97;
  font-size: 19rpx;
  line-height: 21rpx;
  font-weight: 750;
  overflow: hidden;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.price-wrap {
  align-self: end;
  margin-top: 8rpx;
}

.price {
  display: block;
  color: #FF4A1C;
  font-size: 27rpx;
  font-weight: 950;
}

.original-price {
  margin-top: 3rpx;
  color: #8b8e97;
  font-size: 20rpx;
  font-weight: 650;
  text-decoration: line-through;
}

.empty-content {
  min-height: 520rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  color: #8b8e97;
  font-size: 26rpx;
}

.empty-icon {
  width: 96rpx;
  height: 96rpx;
  opacity: 0.52;
}

