page {
  background: #f7f4ed;
}

.cat-page {
  min-height: 100vh;
  padding: 20rpx 24rpx calc(112rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: #f7f4ed;
  color: #17191f;
}

.topbar {
  height: 84rpx;
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.page-title {
  width: 116rpx;
  font-size: 46rpx;
  line-height: 1;
  font-weight: 950;
  letter-spacing: 0;
}

.search {
  height: 80rpx;
  flex: 1;
  display: flex;
  align-items: center;
  padding: 0 28rpx;
  color: #8b8e97;
  background: #fff;
  border: 1rpx solid rgba(23, 25, 31, 0.06);
  border-radius: 16rpx;
  box-shadow: 0 16rpx 44rpx rgba(55, 47, 36, 0.07);
  font-size: 26rpx;
  font-weight: 650;
  box-sizing: border-box;
}

.layout {
  height: calc(100vh - 236rpx - env(safe-area-inset-bottom));
  min-height: 0;
  margin-top: 28rpx;
  display: grid;
  grid-template-columns: 176rpx 1fr;
  gap: 24rpx;
}

.side {
  height: 100%;
  padding: 16rpx 12rpx;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.68);
  box-shadow: inset 0 0 0 1rpx rgba(23, 25, 31, 0.04);
  box-sizing: border-box;
}

.side-item {
  width: 152rpx;
  min-height: 92rpx;
  margin-bottom: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  border-radius: 14rpx;
  color: #5f626b;
  font-size: 24rpx;
  line-height: 1.12;
  text-align: center;
  font-weight: 820;
  box-sizing: border-box;
}

.side-item text {
  max-width: 120rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.side-item.active {
  color: #fff;
  background: #17191f;
  box-shadow: 0 20rpx 40rpx rgba(23, 25, 31, 0.16);
}

.side-item.active::before {
  content: '';
  width: 10rpx;
  height: 44rpx;
  position: absolute;
  left: -12rpx;
  top: 24rpx;
  border-radius: 8rpx;
  background: #ff4b43;
}

.empty-side {
  padding: 40rpx 12rpx;
  color: #8b8e97;
  font-size: 24rpx;
  text-align: center;
}

.main {
  min-width: 0;
  height: 100%;
  box-sizing: border-box;
}

.category-panel {
  padding: 20rpx;
  border-radius: 16rpx;
  background: #fff;
  box-shadow: 0 20rpx 40rpx rgba(50, 44, 36, 0.06);
  box-sizing: border-box;
}

.category-head {
  min-height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.category-head > text {
  flex: 1;
  min-width: 0;
  font-size: 30rpx;
  line-height: 56rpx;
  font-weight: 950;
}

.expand-toggle {
  flex: 0 0 auto;
  height: 52rpx;
  line-height: 52rpx;
  padding: 0 20rpx;
  border-radius: 14rpx;
  color: #17191f;
  background: #f4f2ec;
  font-size: 22rpx;
  font-weight: 900;
  box-sizing: border-box;
}

.expand-toggle.active {
  color: #fff;
  background: #17191f;
}

.chip-row {
  width: 100%;
  white-space: nowrap;
}

.chip-track {
  display: inline-flex;
  gap: 14rpx;
  min-width: 100%;
}

.cat-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14rpx;
}

.cat-chip {
  min-width: 0;
  height: 58rpx;
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 22rpx;
  border-radius: 14rpx;
  color: #4d515a;
  background: #f4f2ec;
  font-size: 22rpx;
  font-weight: 850;
  white-space: nowrap;
  box-sizing: border-box;
}

.cat-grid .cat-chip {
  padding: 0 10rpx;
}

.cat-chip.active {
  color: #17191f;
  background: #ffef68;
}

.section-head {
  margin: 26rpx 0 18rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.section-title {
  font-size: 32rpx;
  line-height: 1;
  font-weight: 950;
  letter-spacing: 0;
}

.view-toggle {
  flex: 0 0 auto;
  width: 52rpx;
  height: 52rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 14rpx;
  color: #17191f;
  background: #fff;
  box-shadow: inset 0 0 0 1rpx rgba(23, 25, 31, 0.06);
}

.view-toggle-icon {
  width: 34rpx;
  height: 34rpx;
}

.product-list {
  display: grid;
  gap: 18rpx;
}

.product-grid {
  grid-template-columns: repeat(2, minmax(0, 1fr));
}

.product-single {
  grid-template-columns: minmax(0, 1fr);
}

.tile {
  min-width: 0;
  min-height: 340rpx;
  padding: 14rpx;
  border-radius: 16rpx;
  background: #fff;
  box-shadow: 0 18rpx 36rpx rgba(50, 44, 36, 0.06);
  box-sizing: border-box;
}

.product-single .tile {
  min-height: 208rpx;
  display: grid;
  grid-template-columns: 172rpx minmax(0, 1fr);
  grid-template-rows: auto auto 1fr;
  column-gap: 20rpx;
  padding: 18rpx;
}

.product-single .tile-media {
  grid-row: 1 / 4;
  height: 172rpx;
}

.product-single .tile-name {
  height: auto;
  min-height: 58rpx;
  margin: 4rpx 0 10rpx;
  font-size: 28rpx;
  line-height: 34rpx;
}

.product-single .tile-desc {
  height: 48rpx;
  font-size: 21rpx;
  line-height: 24rpx;
}

.product-single .price-wrap {
  align-self: end;
  margin-top: 8rpx;
}

.tile-media {
  height: 176rpx;
  position: relative;
  overflow: hidden;
  border-radius: 16rpx;
  background: #eef9ff;
}

.tile-media image {
  width: 100%;
  height: 100%;
  display: block;
}

.tile-media-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #eef9ff;
}

.product-art {
  width: 96rpx;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 28rpx;
  color: #fff;
  background: #17191f;
  transform: rotate(-6deg);
  box-shadow: 0 18rpx 28rpx rgba(23, 25, 31, 0.18);
}

.product-art text {
  display: block;
  transform: rotate(6deg);
  font-size: 38rpx;
  font-weight: 950;
}

.tile-name {
  height: 56rpx;
  margin: 14rpx 0 6rpx;
  color: #17191f;
  font-size: 25rpx;
  line-height: 28rpx;
  font-weight: 950;
  overflow: hidden;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.tile-desc {
  height: 42rpx;
  margin: 0;
  color: #8b8e97;
  font-size: 19rpx;
  line-height: 21rpx;
  font-weight: 750;
  overflow: hidden;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.price-wrap {
  align-self: end;
  margin-top: 8rpx;
}

.price {
  display: block;
  color: #ff4b43;
  font-size: 27rpx;
  font-weight: 950;
}

.original-price {
  margin-top: 3rpx;
  color: #8b8e97;
  font-size: 20rpx;
  font-weight: 650;
  text-decoration: line-through;
}

.empty-content {
  min-height: 520rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  color: #8b8e97;
  font-size: 26rpx;
}

.empty-icon {
  width: 96rpx;
  height: 96rpx;
  opacity: 0.52;
}
