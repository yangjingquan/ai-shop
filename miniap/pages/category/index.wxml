<view class="cat-page">
  <view class="topbar">
    <view class="page-title">分类</view>
    <view class="search" bindtap="onSearchTap">⌕ 搜索手机、香氛、运动鞋</view>
  </view>

  <view class="layout">
    <scroll-view class="side" scroll-y>
      <view
        wx:for="{{ topCats }}"
        wx:key="id"
        class="side-item {{ activeTopId === item.id ? 'active' : '' }}"
        bindtap="onTopTab"
        data-id="{{ item.id }}"
      >
        <text>{{ item.name }}</text>
      </view>
      <view wx:if="{{ topCats.length === 0 && !loading }}" class="empty-side">
        <text>暂无分类</text>
      </view>
    </scroll-view>

    <scroll-view class="main" scroll-y>
      <view wx:if="{{ currentTop }}" class="category-panel">
        <view class="category-head">
          <text>{{ currentTopName }}</text>
          <view class="expand-toggle {{ categoryExpanded ? 'active' : '' }}" bindtap="onToggleCategoryPanel">
            {{ categoryExpanded ? '收起' : '展开' }}
          </view>
        </view>
        <scroll-view wx:if="{{ !categoryExpanded }}" class="chip-row" scroll-x enhanced show-scrollbar="false">
          <view class="chip-track">
            <view
              class="cat-chip {{ selectedSubId === 0 ? 'active' : '' }}"
              bindtap="onSubCategory"
              data-id="0"
            >全部</view>
            <view
              wx:for="{{ subCats }}"
              wx:key="id"
              class="cat-chip {{ selectedSubId === item.id ? 'active' : '' }}"
              bindtap="onSubCategory"
              data-id="{{ item.id }}"
            >{{ item.name }}</view>
          </view>
        </scroll-view>
        <view wx:else class="cat-grid">
          <view
            class="cat-chip {{ selectedSubId === 0 ? 'active' : '' }}"
            bindtap="onSubCategory"
            data-id="0"
          >全部</view>
          <view
            wx:for="{{ subCats }}"
            wx:key="id"
            class="cat-chip {{ selectedSubId === item.id ? 'active' : '' }}"
            bindtap="onSubCategory"
            data-id="{{ item.id }}"
          >{{ item.name }}</view>
        </view>
      </view>

      <view class="section-head">
        <view class="section-title">{{ selectedSubName }}</view>
        <view class="view-toggle" bindtap="onToggleProductView">
          <image
            class="view-toggle-icon"
            src="{{ productViewMode === 'grid' ? '/assets/icons/view-list.svg' : '/assets/icons/view-module.svg' }}"
            mode="aspectFit"
          />
        </view>
      </view>

      <view wx:if="{{ products.length }}" class="product-list {{ productViewMode === 'grid' ? 'product-grid' : 'product-single' }}">
        <view
          wx:for="{{ products }}"
          wx:key="id"
          class="tile"
          bindtap="onProduct"
          data-id="{{ item.id }}"
        >
          <view class="tile-media {{ item.mainImage ? '' : 'tile-media-empty' }}">
            <image wx:if="{{ item.mainImage }}" src="{{ item.mainImage }}" mode="aspectFill" />
            <view wx:else class="product-art"><text>{{ item.shortName }}</text></view>
          </view>
          <view class="tile-name">{{ item.name }}</view>
          <view class="tile-desc">{{ item.subtitle }}</view>
          <view class="price">¥ {{ item.minPrice }}</view>
        </view>
      </view>

      <view wx:if="{{ !products.length && !productLoading }}" class="empty-content">
        <image class="empty-icon" src="/assets/icons/empty.png" mode="aspectFit" />
        <view>暂无商品</view>
      </view>
    </scroll-view>
  </view>
</view>
