page {
  background: #F6F6F8;
}

.home {
  min-height: 100vh;
  background: #F6F6F8;
  color: #15161C;
  box-sizing: border-box;
}

.home-loading {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #9A9EA8;
  background: #F6F6F8;
  box-sizing: border-box;
}

.loading-spinner {
  width: 52rpx;
  height: 52rpx;
  border: 5rpx solid #ECEDF0;
  border-top-color: #FF4A1C;
  border-radius: 50%;
  animation: homeLoadingSpin .8s linear infinite;
}

.loading-label {
  margin-top: 20rpx;
  font-size: 24rpx;
}

@keyframes homeLoadingSpin {
  to { transform: rotate(360deg); }
}

.coupon-mask { position: fixed; z-index: 20; inset: 0; display: flex; align-items: center; justify-content: center; padding: 48rpx; background: rgba(21, 22, 28, 0.52); }
.new-user-popup { position: relative; width: 100%; padding: 54rpx 34rpx 30rpx; border-radius: 44rpx; box-sizing: border-box; text-align: center; background: linear-gradient(145deg, #FFFAF3, #FFF0DF); box-shadow: 0 24rpx 70rpx rgba(255, 74, 28, 0.28); }
.referral-entry { display: flex; align-items: center; justify-content: space-between; margin-top: 22rpx; padding: 28rpx 32rpx; border-radius: 36rpx; color: #fff; background: linear-gradient(90deg, #0FB577, #7ADB5A); box-shadow: 0 12rpx 28rpx rgba(22, 196, 127, 0.24); }
.referral-entry-kicker { font-size: 20rpx; letter-spacing: 5rpx; font-weight: 800; opacity: 0.9; }
.referral-entry-title { margin-top: 8rpx; font-size: 32rpx; font-weight: 800; }
.referral-entry-desc { margin-top: 6rpx; font-size: 22rpx; opacity: 0.9; }
.referral-entry-arrow { font-size: 48rpx; font-weight: 300; color: #fff; flex-shrink: 0; margin-left: 16rpx; }
.points-entry { display:flex; align-items:stretch; justify-content:space-between; margin-top:20rpx; border-radius:36rpx; color:#fff; background:#15161C; box-shadow:0 12rpx 28rpx rgba(21, 22, 28, 0.18); overflow: hidden; }
.points-entry-main { flex: 1; padding: 28rpx 32rpx; }
.points-entry-kicker { font-size:20rpx; letter-spacing:5rpx; font-weight: 800; color: #FFD23F; }
.points-entry-value { margin-top:8rpx; font-size:56rpx; line-height:1; font-weight:900; }
.points-entry-value text { font-size:24rpx; font-weight:400; opacity: 0.7; }
.points-entry-desc { margin-top:12rpx; font-size:22rpx; opacity:.9; }
.points-entry-day { min-width:236rpx; padding: 28rpx 24rpx; background:#FFD23F; color:#15161C; display: flex; flex-direction: column; justify-content: center; gap: 8rpx; }
.points-entry-day text { display:block; font-size:28rpx; font-weight:800; }
.points-entry-day text:last-child { font-size:22rpx; font-weight:600; }
.full-reduction-entry{display:flex;align-items:center;justify-content:space-between;margin-top:20rpx;padding:28rpx 32rpx;border-radius:36rpx;color:#fff;background:linear-gradient(90deg, #FF4A1C, #FF8A00);box-shadow:0 12rpx 28rpx rgba(255, 74, 28, 0.24)}
.full-reduction-kicker{font-size:20rpx;letter-spacing:5rpx;font-weight:800;opacity:.9}
.full-reduction-title{margin-top:8rpx;font-size:32rpx;font-weight:800}
.full-reduction-rule{margin-top:6rpx;font-size:22rpx;font-weight:400;opacity:.92}
.full-reduction-arrow{font-size:52rpx;font-weight:300;opacity:.9;flex-shrink:0;margin-left:16rpx}
.presale-entry { display:flex; align-items:center; justify-content:space-between; gap:20rpx; margin-top:20rpx; padding:28rpx 32rpx; border-radius:36rpx; color:#fff; background:linear-gradient(135deg, #6A4CFF, #FF5CA8); box-shadow:0 12rpx 28rpx rgba(123, 92, 255, 0.24); }
.presale-entry-copy { min-width:0; }
.presale-entry-kicker { font-size:20rpx; letter-spacing:5rpx; font-weight: 800; opacity:.85; }
.presale-entry-title { margin-top:8rpx; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; font-size:32rpx; font-weight:800; }
.presale-entry-desc { margin-top:6rpx; font-size:22rpx; opacity:.9; }
.presale-entry-price { min-width:180rpx; font-size:52rpx; line-height:1; font-weight:900; text-align:right; }
.presale-entry-price text { margin-right:4rpx; font-size:28rpx; }
.presale-entry-price view { margin-top:12rpx; font-size:24rpx; font-weight:700; padding: 10rpx 20rpx; background: rgba(255, 255, 255, 0.2); border-radius: 20rpx; display: inline-block; }
.popup-close { position: absolute; top: 12rpx; right: 22rpx; color: #9A9EA8; font-size: 48rpx; font-weight: 300; }
.popup-kicker { color: #FF4A1C; font-size: 20rpx; letter-spacing: 5rpx; font-weight: 800; }
.popup-title { margin-top: 10rpx; color: #FF4A1C; font-size: 56rpx; font-weight: 900; }
.popup-desc { margin-top: 8rpx; color: #5B5F6B; font-size: 26rpx; }
.coupon-ticket { display: flex; align-items: center; margin: 34rpx 0 26rpx; padding: 24rpx 28rpx; border: 3rpx solid #FF4A1C; border-radius: 32rpx; background: #fff; text-align: left; }
.ticket-amount { color: #FF4A1C; font-size: 88rpx; line-height: 1; font-weight: 900; font-family: 'DIN Alternate', 'Roboto Condensed', sans-serif; }
.ticket-amount text { margin-right: 4rpx; font-size: 36rpx; }
.ticket-info { margin-left: 24rpx; color: #15161C; font-size: 30rpx; font-weight: 800; }
.ticket-info text { display: block; margin-top: 10rpx; color: #5B5F6B; font-size: 24rpx; font-weight: 400; }
.claim-btn { width: 100%; height: 96rpx; display: flex; align-items: center; justify-content: center; line-height: normal; border-radius: 48rpx; color: #fff; background: linear-gradient(90deg, #FF4A1C, #FF8A00); font-size: 32rpx; font-weight: 700; box-shadow: 0 12rpx 28rpx rgba(255, 74, 28, 0.28); }
.popup-note { margin-top: 18rpx; color: #9A9EA8; font-size: 22rpx; }

.content {
  padding: 20rpx 32rpx 28rpx;
  box-sizing: border-box;
}

.nav {
  height: 76rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.brand {
  width: 76rpx;
  height: 76rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 24rpx;
  color: #FF4A1C;
  font-size: 40rpx;
  font-weight: 900;
  background: #fff;
  box-shadow: 0 8rpx 24rpx rgba(255, 74, 28, 0.12);
}

.search {
  height: 76rpx;
  flex: 1;
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 0 8rpx 0 28rpx;
  color: #9A9EA8;
  background: #fff;
  border-radius: 38rpx;
  box-shadow: 0 8rpx 24rpx rgba(20, 22, 28, 0.06);
  box-sizing: border-box;
}

.search input {
  flex: 1;
  min-width: 0;
  font-size: 26rpx;
  font-weight: 400;
  color: #15161C;
}

.search-clear {
  width: 30rpx;
  height: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  border-radius: 50%;
  color: #fff;
  background: #C8CBD2;
  font-size: 18rpx;
  line-height: 30rpx;
  font-weight: 700;
}

.search-mark {
  font-size: 30rpx;
  font-weight: 700;
}

.input-placeholder {
  color: #9A9EA8;
}

.search-btn {
  height: 60rpx;
  padding: 0 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 30rpx;
  color: #fff;
  background: #15161C;
  font-size: 26rpx;
  font-weight: 800;
}

.banner {
  width: 100%;
  margin-top: 24rpx;
  height: 336rpx;
  min-height: 336rpx;
  max-height: 336rpx;
  position: relative;
  overflow: hidden;
  border-radius: 40rpx;
  box-sizing: border-box;
  box-shadow: 0 16rpx 48rpx rgba(255, 74, 28, 0.16);
}

.banner swiper-item {
  height: 336rpx;
}

.banner-img {
  width: 100%;
  height: 336rpx;
  display: block;
}

.banner-placeholder {
  background: linear-gradient(160deg, #15161C 0%, #2B2E3A 55%, #15161C 100%);
}

.banner-text {
  position: absolute;
  left: 44rpx;
  top: 44rpx;
  z-index: 2;
  color: #fff;
}

.kicker {
  width: max-content;
  padding: 14rpx 28rpx;
  color: #15161C;
  background: #FFD23F;
  border-radius: 32rpx;
  font-size: 22rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
}

.banner-title {
  margin-top: 12rpx;
  font-size: 52rpx;
  line-height: 1.1;
  font-weight: 900;
  white-space: pre-line;
}

.banner-desc {
  margin-top: 8rpx;
  color: rgba(255, 255, 255, 0.7);
  font-size: 24rpx;
  font-weight: 400;
}

.cta {
  margin-top: 28rpx;
  width: max-content;
  padding: 0 28rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #15161C;
  background: #FFD23F;
  border-radius: 32rpx;
  font-size: 24rpx;
  font-weight: 800;
}

.shoe {
  position: absolute;
  right: -20rpx;
  bottom: -30rpx;
  width: 340rpx;
  height: 340rpx;
  border-radius: 80rpx;
  background: linear-gradient(135deg, #FF4A1C, #FF8A00);
  transform: rotate(18deg);
  opacity: 0.3;
}


.categories {
  margin-top: 28rpx;
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: 20rpx 0;
  padding: 28rpx 12rpx 16rpx;
  border-radius: 40rpx;
  background: #fff;
  box-shadow: 0 8rpx 24rpx rgba(20, 22, 28, 0.04);
}

.cat {
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  color: #5B5F6B;
  font-size: 24rpx;
  font-weight: 600;
}

.cat-icon {
  width: 88rpx;
  height: 88rpx;
  margin-bottom: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 30rpx;
  font-size: 36rpx;
  font-weight: 800;
  box-shadow: 0 8rpx 20rpx rgba(20, 22, 28, 0.06);
}

.cat-img {
  width: 56rpx;
  height: 56rpx;
}

.tone-1 { background: linear-gradient(135deg, #FFE3D6, #FFC2A8); }
.tone-2 { background: linear-gradient(135deg, #E3ECFF, #BFD3FF); }
.tone-3 { background: linear-gradient(135deg, #DDF7EC, #AEEBD1); }
.tone-4 { background: linear-gradient(135deg, #FFF3C9, #FFE08A); }
.tone-5 { background: linear-gradient(135deg, #F0E6FF, #D6C2FF); }

.cat-name {
  max-width: 112rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.section-head {
  margin: 44rpx 0 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.section-title {
  font-size: 38rpx;
  line-height: 1;
  font-weight: 800;
  letter-spacing: 0;
  color: #15161C;
}

.more {
  color: #5B5F6B;
  font-size: 24rpx;
  font-weight: 400;
}

.section-subtitle {
  margin-top: 8rpx;
  color: #9A9EA8;
  font-size: 24rpx;
  line-height: 1;
  font-weight: 400;
}

.section-note {
  padding: 6rpx 16rpx;
  border-radius: 40rpx;
  color: #FF4A1C;
  background: #FFF1EB;
  font-size: 20rpx;
  line-height: 1;
  letter-spacing: 4rpx;
  font-weight: 800;
}

.arrival-head {
  margin-top: 44rpx;
  margin-bottom: 20rpx;
}

.arrival-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 20rpx;
}

.arrival-card {
  min-width: 0;
  min-height: 260rpx;
  padding: 16rpx;
  position: relative;
  overflow: hidden;
  border-radius: 32rpx;
  background: #fff;
  box-sizing: border-box;
  box-shadow: 0 8rpx 24rpx rgba(20, 22, 28, 0.04);
}

.arrival-badge {
  width: max-content;
  padding: 4rpx 12rpx;
  position: relative;
  z-index: 2;
  border-radius: 12rpx;
  color: #fff;
  background: #15161C;
  font-size: 20rpx;
  line-height: 1;
  letter-spacing: 1rpx;
  font-weight: 800;
}

.arrival-image,
.arrival-visual {
  width: 120rpx;
  height: 120rpx;
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  border-radius: 24rpx;
}

.arrival-visual { transform: rotate(-7deg); }

.arrival-copy {
  position: absolute;
  right: 16rpx;
  bottom: 16rpx;
  left: 16rpx;
}

.arrival-name,
.feed-name {
  overflow: hidden;
  color: #15161C;
  font-weight: 800;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.arrival-name {
  max-height: 60rpx;
  padding-right: 128rpx;
  box-sizing: border-box;
  font-size: 28rpx;
  line-height: 1.1;
}

.arrival-desc,
.feed-desc {
  overflow: hidden;
  color: #9A9EA8;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.arrival-desc {
  margin-top: 6rpx;
  font-size: 22rpx;
  line-height: 1;
}

.arrival-price {
  margin-top: 8rpx;
  color: #FF4A1C;
  font-size: 34rpx;
  line-height: 1;
  font-weight: 800;
  font-family: 'DIN Alternate', 'Roboto Condensed', sans-serif;
}

.recommend {
  height: 276rpx;
  padding: 16rpx;
  overflow: hidden;
  border-radius: 32rpx;
  background: #fff;
  box-shadow: 0 8rpx 24rpx rgba(20, 22, 28, 0.04);
  box-sizing: border-box;
  white-space: nowrap;
}

.recommend-track {
  display: inline-flex;
  gap: 16rpx;
}

.rec-card {
  width: 240rpx;
  height: 244rpx;
  flex: 0 0 240rpx;
  display: grid;
  grid-template-rows: 144rpx 56rpx 32rpx;
  gap: 8rpx;
  align-items: center;
  justify-items: center;
  position: relative;
  border-radius: 24rpx;
  background: #F6F6F8;
  box-sizing: border-box;
  padding: 8rpx;
}

.rec-tone-1 { background: linear-gradient(135deg, #FFE3D6, #FFC2A8); }
.rec-tone-2 { background: linear-gradient(135deg, #E3ECFF, #BFD3FF); }
.rec-tone-3 { background: linear-gradient(135deg, #DDF7EC, #AEEBD1); }
.rec-tone-4 { background: linear-gradient(135deg, #FFF3C9, #FFE08A); }

.rec-image {
  width: 112rpx;
  height: 112rpx;
  border-radius: 24rpx;
}

.rec-visual {
  width: 112rpx;
  height: 112rpx;
  position: relative;
  border-radius: 24rpx;
  transform: rotate(-7deg);
}

.rec-visual.phone {
  background: linear-gradient(#4ac8ff, #4ac8ff) 36rpx 24rpx / 26rpx 50rpx no-repeat, #15161C;
}

.rec-visual.watch {
  background: linear-gradient(#15161C, #15161C) 40rpx 4rpx / 18rpx 88rpx no-repeat, radial-gradient(circle, #FFD23F 0 28rpx, #15161C 30rpx 38rpx, transparent 40rpx);
}

.rec-visual.audio {
  background: radial-gradient(circle at 25% 70%, #FF4A1C 0 14rpx, transparent 16rpx), radial-gradient(circle at 75% 70%, #FF4A1C 0 14rpx, transparent 16rpx);
}

.rec-visual.audio::before {
  content: '';
  position: absolute;
  left: 12rpx;
  top: 26rpx;
  width: 72rpx;
  height: 52rpx;
  border: 14rpx solid #15161C;
  border-bottom: 0;
  border-radius: 48rpx 48rpx 0 0;
  box-sizing: border-box;
}

.rec-visual.bag {
  background: linear-gradient(#FF4A1C, #FF8A00) 20rpx 36rpx / 58rpx 48rpx no-repeat, radial-gradient(circle at 50% 22%, transparent 20rpx, #15161C 22rpx 26rpx, transparent 28rpx);
}

.rec-name {
  width: 180rpx;
  color: #15161C;
  font-size: 26rpx;
  line-height: 1.2;
  text-align: center;
  font-weight: 700;
  overflow: hidden;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.price {
  color: #FF4A1C;
  font-size: 32rpx;
  line-height: 1;
  font-weight: 800;
  font-family: 'DIN Alternate', 'Roboto Condensed', sans-serif;
}

.feed-head {
  margin-top: 44rpx;
  margin-bottom: 20rpx;
}

.product-feed {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 20rpx;
}

.feed-card {
  min-width: 0;
  min-height: 380rpx;
  padding: 16rpx;
  display: flex;
  flex-direction: column;
  border-radius: 32rpx;
  background: #fff;
  box-sizing: border-box;
  box-shadow: 0 8rpx 24rpx rgba(20, 22, 28, 0.04);
}

.feed-image-wrap {
  height: 200rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  border-radius: 24rpx;
}

.feed-image,
.feed-visual {
  width: 160rpx;
  height: 160rpx;
}

.feed-image-wrap .feed-visual {
  width: 160rpx;
  height: 160rpx;
}

.feed-visual { transform: rotate(-7deg); }

.feed-name {
  min-height: 56rpx;
  margin-top: 16rpx;
  font-size: 28rpx;
  line-height: 1.1;
  font-weight: 700;
}

.feed-desc {
  margin-top: 8rpx;
  font-size: 22rpx;
  line-height: 1;
}

.feed-price-row {
  min-height: 40rpx;
  margin-top: auto;
  padding-top: 12rpx;
  display: flex;
  align-items: baseline;
  min-width: 0;
}

.feed-price {
  flex: 0 1 auto;
  min-width: 0;
  overflow: hidden;
  color: #FF4A1C;
  font-size: 34rpx;
  line-height: 1;
  font-weight: 800;
  font-family: 'DIN Alternate', 'Roboto Condensed', sans-serif;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.feed-original {
  flex: 0 1 auto;
  min-width: 0;
  margin-left: 12rpx;
  overflow: hidden;
  color: #9A9EA8;
  font-size: 22rpx;
  line-height: 1;
  text-decoration: line-through;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.deal-head {
  margin-top: 40rpx;
}

.deal-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
}

.deal-row.single-deal {
  grid-template-columns: 1fr;
}

.group-card,
.flash-card {
  height: 304rpx;
  padding: 28rpx;
  position: relative;
  overflow: hidden;
  border-radius: 36rpx;
  box-sizing: border-box;
}

.group-card {
  color: #fff;
  background: linear-gradient(145deg, #E7F0FF, #fff);
  box-shadow: 0 8rpx 24rpx rgba(61, 123, 255, 0.12);
}

.flash-card {
  color: #15161C;
  background: linear-gradient(160deg, #FFE8DF, #fff);
  box-shadow: 0 8rpx 24rpx rgba(255, 74, 28, 0.08);
}

.deal-title {
  font-size: 32rpx;
  font-weight: 900;
}

.deal-title.dark {
  color: #15161C;
}

.flash-copy {
  position: relative;
  z-index: 2;
  width: calc(100% - 120rpx);
  height: 100%;
  min-width: 0;
  box-sizing: border-box;
}

.flash-head {
  display: flex;
  align-items: center;
  min-width: 0;
}

.flash-head .deal-title {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.flash-arrow {
  flex: 0 0 auto;
  margin-left: 8rpx;
  color: #5B5F6B;
  font-size: 36rpx;
  line-height: 1;
  font-weight: 700;
}

.flash-status {
  display: inline-flex;
  max-width: 100%;
  margin-top: 10rpx;
  padding: 6rpx 12rpx;
  overflow: hidden;
  color: #fff;
  background: #FF4A1C;
  border-radius: 12rpx;
  font-size: 20rpx;
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.flash-product {
  display: -webkit-box;
  height: 52rpx;
  margin-top: 12rpx;
  overflow: hidden;
  color: #5B5F6B;
  font-size: 24rpx;
  font-weight: 400;
  line-height: 26rpx;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.flash-price-row {
  display: flex;
  align-items: baseline;
  min-width: 0;
  margin-top: 10rpx;
}

.flash-price {
  position: static;
  flex: 0 1 auto;
  min-width: 0;
  overflow: hidden;
  color: #FF4A1C;
  font-size: 44rpx;
  font-weight: 900;
  font-family: 'DIN Alternate', 'Roboto Condensed', sans-serif;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.flash-price-suffix {
  margin-left: 6rpx;
  color: #FF4A1C;
  font-size: 22rpx;
  font-weight: 600;
}

.flash-countdown {
  display: flex;
  align-items: center;
  min-width: 0;
  margin-top: 12rpx;
  color: #5B5F6B;
  font-size: 22rpx;
  white-space: nowrap;
}

.flash-countdown-label {
  flex: 0 0 auto;
}

.flash-time {
  min-width: 0;
  margin-left: 8rpx;
  padding: 6rpx 10rpx;
  overflow: hidden;
  color: #fff;
  background: #15161C;
  border-radius: 12rpx;
  font-size: 22rpx;
  font-weight: 800;
  font-family: 'DIN Alternate', monospace;
  letter-spacing: 1rpx;
  text-overflow: ellipsis;
}

.deal-desc {
  margin-top: 12rpx;
  color: #3D7BFF;
  font-size: 24rpx;
  font-weight: 600;
}

.avatars {
  margin-top: 28rpx;
  display: flex;
}

.avatars view {
  width: 48rpx;
  height: 48rpx;
  margin-right: -12rpx;
  border: 4rpx solid #E7F0FF;
  border-radius: 50%;
  background: #3D7BFF;
}

.avatars view:nth-child(2) { background: #6FA8FF; }
.avatars view:nth-child(3) { background: #A8CAFF; }

.group-price {
  position: absolute;
  left: 28rpx;
  bottom: 28rpx;
  color: #3D7BFF;
  font-size: 28rpx;
  font-weight: 800;
  padding: 8rpx 20rpx;
  background: rgba(255, 255, 255, 0.9);
  border-radius: 24rpx;
}

.headphone {
  position: absolute;
  right: 16rpx;
  bottom: 20rpx;
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  background: radial-gradient(circle at 50% 50%, transparent 0 40rpx, rgba(61, 123, 255, 0.15) 42rpx 52rpx, transparent 54rpx), radial-gradient(circle at 30% 61%, rgba(61, 123, 255, 0.2) 0 20rpx, transparent 22rpx), radial-gradient(circle at 70% 61%, rgba(61, 123, 255, 0.2) 0 20rpx, transparent 22rpx);
  transform: rotate(-9deg);
  opacity: 0.4;
}

.speaker {
  position: absolute;
  z-index: 1;
  right: 12rpx;
  bottom: 24rpx;
  width: 100rpx;
  height: 120rpx;
  opacity: 0.15;
  border-radius: 30rpx;
  background: radial-gradient(circle at 50% 30%, #FF4A1C 0 18rpx, #fff 20rpx 30rpx, #FF4A1C 32rpx 36rpx, transparent 38rpx), radial-gradient(circle at 50% 72%, #FF4A1C 0 26rpx, #fff 28rpx 42rpx, transparent 44rpx), #FFE8DF;
  transform: rotate(7deg);
}

.lottery-entry { display: flex; align-items: center; position: relative; overflow: hidden; min-height: 152rpx; margin-top: 20rpx; padding: 24rpx 28rpx; box-sizing: border-box; border-radius: 36rpx; color: #fff; background: linear-gradient(135deg, #6A4CFF, #FF5CA8); box-shadow: 0 12rpx 28rpx rgba(123, 92, 255, 0.24); }
.lottery-entry::after { content: ''; position: absolute; right: -60rpx; top: -70rpx; width: 220rpx; height: 220rpx; border-radius: 50%; background: rgba(255, 255, 255, 0.15); }
.lottery-entry-image { flex: 0 0 auto; width: 120rpx; height: 120rpx; border-radius: 24rpx; background: rgba(255, 255, 255, 0.2); }
.lottery-entry-copy { position: relative; z-index: 1; min-width: 0; margin-left: 20rpx; }
.lottery-entry-kicker { color: rgba(255, 255, 255, 0.9); font-size: 20rpx; letter-spacing: 5rpx; font-weight: 800; }
.lottery-entry-title { margin-top: 8rpx; color: #fff; font-size: 32rpx; font-weight: 800; }
.lottery-entry-desc { margin-top: 6rpx; color: rgba(255, 255, 255, 0.85); font-size: 22rpx; }
.lottery-entry-arrow { position: relative; z-index: 1; margin-left: auto; padding-left: 16rpx; color: #fff; font-size: 24rpx; font-weight: 700; white-space: nowrap; }

/* The home feed leads with discovery, then introduces campaigns as optional value. */
.content { padding: 18rpx 24rpx 34rpx; }
.nav { height: 92rpx; gap: 14rpx; }
.brand { width: 88rpx; height: 88rpx; border-radius: 28rpx; background: #201f1c; box-shadow: none; }
.search { height: 76rpx; padding: 0 22rpx; border-radius: 38rpx; border-color: #eee6dc; box-shadow: none; }
.search-btn { width: 96rpx; height: 76rpx; border-radius: 38rpx; color: #fff; background: #201f1c; border: 0; box-shadow: none; font-size: 24rpx; }
.banner { height: 340rpx; margin-top: 22rpx; border-radius: 28rpx; box-shadow: 0 16rpx 36rpx rgba(47, 31, 16, .12); }
.categories { margin-top: 26rpx; gap: 10rpx; }
.cat-icon { width: 90rpx; height: 90rpx; border-radius: 28rpx; box-shadow: none; }
.cat-name { font-size: 21rpx; }
.section-head { margin: 40rpx 2rpx 18rpx; }
.section-title { font-size: 38rpx; letter-spacing: -.5rpx; }
.recommend { height: 286rpx; padding: 14rpx; border-radius: 24rpx; background: #fff; box-shadow: 0 12rpx 30rpx rgba(47, 31, 16, .06); }
.rec-card { width: 234rpx; height: 254rpx; grid-template-rows: 122rpx 66rpx 36rpx; border-radius: 18rpx; }
.rec-image { width: 112rpx; height: 112rpx; }
.deal-row { gap: 14rpx; }
.group-card, .flash-card { height: 292rpx; border-radius: 24rpx; }
.group-card { background: linear-gradient(145deg, #201f1c, #37302a); }
.flash-card { background: linear-gradient(145deg, #ffead7, #ffb86e); box-shadow: none; }
.presale-entry, .points-entry, .full-reduction-entry, .lottery-entry, .referral-entry { border-radius: 24rpx; }
.topic-entry { margin-top: 16rpx; }
.topic-card { display: flex; align-items: center; gap: 20rpx; min-height: 160rpx; margin: 16rpx 0; padding: 16rpx; border-radius: 32rpx; background: #fff; box-shadow: 0 8rpx 24rpx rgba(20, 22, 28, 0.04); }
.topic-card-image, .topic-cover-placeholder { flex: 0 0 auto; width: 180rpx; height: 132rpx; border-radius: 24rpx; background: linear-gradient(135deg, #EDEEF2, #D5D8E0); }
.topic-card-copy { flex: 1; min-width: 0; }
.topic-card-copy view { overflow: hidden; color: #15161C; font-size: 28rpx; font-weight: 800; text-overflow: ellipsis; white-space: nowrap; }
.topic-card-copy text { display: block; overflow: hidden; margin-top: 12rpx; color: #9A9EA8; font-size: 22rpx; text-overflow: ellipsis; white-space: nowrap; }
