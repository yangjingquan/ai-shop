page {
  background: #f7f4ed;
}

.home {
  min-height: 100vh;
  padding-bottom: calc(112rpx + env(safe-area-inset-bottom));
  background: #f7f4ed;
  color: #17191f;
  box-sizing: border-box;
}

.content {
  padding: 20rpx 32rpx 28rpx;
  box-sizing: border-box;
}

.nav {
  height: 84rpx;
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.brand {
  width: 84rpx;
  height: 84rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 26rpx;
  color: #fff;
  font-size: 34rpx;
  font-weight: 900;
  background: #17191f;
  box-shadow: 0 20rpx 36rpx rgba(23, 25, 31, 0.18);
}

.search {
  height: 80rpx;
  flex: 1;
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 0 28rpx;
  color: #8b8e97;
  background: #fff;
  border: 1rpx solid rgba(23, 25, 31, 0.06);
  border-radius: 16rpx;
  box-shadow: 0 16rpx 44rpx rgba(55, 47, 36, 0.07);
  box-sizing: border-box;
}

.search input {
  flex: 1;
  min-width: 0;
  font-size: 26rpx;
  font-weight: 650;
}

.search-mark {
  font-size: 30rpx;
  font-weight: 900;
}

.input-placeholder {
  color: #8b8e97;
}

.search-btn {
  width: 104rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 16rpx;
  color: #17191f;
  background: linear-gradient(135deg, #c7ff6b 0%, #ffef68 100%);
  border: 2rpx solid rgba(23, 25, 31, 0.08);
  font-size: 26rpx;
  font-weight: 950;
  box-shadow: 0 16rpx 34rpx rgba(199, 255, 107, 0.28), inset 0 -6rpx 0 rgba(23, 25, 31, 0.08);
}

.banner {
  margin-top: 28rpx;
  height: 316rpx;
  position: relative;
  overflow: hidden;
  border-radius: 16rpx;
  box-shadow: 0 32rpx 60rpx rgba(225, 74, 62, 0.2);
}

.banner-img {
  width: 100%;
  height: 100%;
  display: block;
}

.banner-placeholder {
  background:
    radial-gradient(circle at 78% 28%, rgba(255, 237, 135, 0.95) 0 14%, transparent 15%),
    linear-gradient(132deg, #161820 0%, #232832 42%, #ff5f55 43%, #ff8c68 100%);
}

.banner-text {
  position: absolute;
  left: 36rpx;
  top: 40rpx;
  z-index: 2;
  color: #fff;
}

.kicker {
  width: max-content;
  padding: 10rpx 18rpx;
  color: #17191f;
  background: #c7ff6b;
  border-radius: 12rpx;
  font-size: 22rpx;
  font-weight: 800;
}

.banner-title {
  margin-top: 24rpx;
  font-size: 58rpx;
  line-height: 1.02;
  font-weight: 950;
  white-space: pre-line;
}

.banner-desc {
  margin-top: 10rpx;
  color: rgba(255, 255, 255, 0.78);
  font-size: 24rpx;
  font-weight: 650;
}

.cta {
  margin-top: 28rpx;
  width: 164rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #17191f;
  background: #fff;
  border-radius: 14rpx;
  font-size: 24rpx;
  font-weight: 900;
}

.shoe {
  position: absolute;
  right: 44rpx;
  bottom: 36rpx;
  width: 272rpx;
  height: 128rpx;
  transform: rotate(-16deg);
  filter: drop-shadow(0 32rpx 28rpx rgba(0, 0, 0, 0.25));
}

.shoe::before {
  content: '';
  position: absolute;
  inset: 28rpx 0 20rpx 36rpx;
  background: #f8f5e9;
  border-radius: 100rpx 160rpx 48rpx 60rpx;
  clip-path: polygon(0 48%, 32% 18%, 57% 13%, 72% 27%, 100% 62%, 94% 87%, 8% 86%);
}

.shoe::after {
  content: '';
  position: absolute;
  left: 12rpx;
  bottom: 0;
  width: 248rpx;
  height: 34rpx;
  background: #17191f;
  border-radius: 18rpx 50rpx 18rpx 28rpx;
}

.shoe-line {
  position: absolute;
  left: 84rpx;
  top: 48rpx;
  width: 96rpx;
  height: 16rpx;
  border-top: 6rpx solid #ff5f55;
  border-bottom: 6rpx solid #4ac8ff;
  transform: rotate(6deg);
  z-index: 3;
}


.categories {
  margin-top: 30rpx;
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: 16rpx;
  padding-bottom: 2rpx;
}

.cat {
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  color: #373a42;
  font-size: 22rpx;
  font-weight: 760;
}

.cat-icon {
  width: 96rpx;
  height: 96rpx;
  margin-bottom: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 16rpx;
  font-size: 44rpx;
  background: #fff;
  box-shadow: 0 16rpx 36rpx rgba(45, 36, 22, 0.06);
}

.cat-img {
  width: 56rpx;
  height: 56rpx;
}

.tone-1 { background: #fff3b7; }
.tone-2 { background: #dff7ff; }
.tone-3 { background: #e5ffd8; }
.tone-4 { background: #ffe1de; }
.tone-5 { background: #ece8ff; }

.cat-name {
  max-width: 112rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.section-head {
  margin: 34rpx 0 18rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.section-title {
  font-size: 36rpx;
  line-height: 1;
  font-weight: 950;
  letter-spacing: 0;
}

.more {
  color: #878b94;
  font-size: 24rpx;
  font-weight: 760;
}

.recommend {
  height: 252rpx;
  padding: 16rpx;
  overflow: hidden;
  border-radius: 16rpx;
  background:
    linear-gradient(180deg, transparent 0 126rpx, rgba(23, 25, 31, 0.08) 128rpx 132rpx, transparent 134rpx),
    #fff;
  box-shadow: 0 20rpx 44rpx rgba(50, 44, 36, 0.07);
  box-sizing: border-box;
  white-space: nowrap;
}

.recommend-track {
  display: inline-flex;
  gap: 16rpx;
}

.rec-card {
  width: 264rpx;
  height: 220rpx;
  flex: 0 0 264rpx;
  display: grid;
  grid-template-rows: 100rpx 62rpx 36rpx;
  gap: 8rpx;
  align-items: center;
  justify-items: center;
  position: relative;
  border-radius: 16rpx;
  background: #f7f4ed;
  box-sizing: border-box;
}

.rec-tone-1 { background: #e7fbff; }
.rec-tone-2 { background: #fff3b7; }
.rec-tone-3 { background: #ffe1de; }
.rec-tone-4 { background: #e5ffd8; }

.rec-image {
  width: 96rpx;
  height: 96rpx;
  border-radius: 22rpx;
}

.rec-visual {
  width: 96rpx;
  height: 96rpx;
  position: relative;
  border-radius: 28rpx;
  transform: rotate(-7deg);
}

.rec-visual.phone {
  background: linear-gradient(#4ac8ff, #4ac8ff) 36rpx 24rpx / 26rpx 50rpx no-repeat, #17191f;
}

.rec-visual.watch {
  background: linear-gradient(#17191f, #17191f) 40rpx 4rpx / 18rpx 88rpx no-repeat, radial-gradient(circle, #c7ff6b 0 28rpx, #17191f 30rpx 38rpx, transparent 40rpx);
}

.rec-visual.audio {
  background: radial-gradient(circle at 25% 70%, #ff5f55 0 14rpx, transparent 16rpx), radial-gradient(circle at 75% 70%, #ff5f55 0 14rpx, transparent 16rpx);
}

.rec-visual.audio::before {
  content: '';
  position: absolute;
  left: 12rpx;
  top: 26rpx;
  width: 72rpx;
  height: 52rpx;
  border: 14rpx solid #17191f;
  border-bottom: 0;
  border-radius: 48rpx 48rpx 0 0;
  box-sizing: border-box;
}

.rec-visual.bag {
  background: linear-gradient(#ff6a5c, #d83736) 20rpx 36rpx / 58rpx 48rpx no-repeat, radial-gradient(circle at 50% 22%, transparent 20rpx, #17191f 22rpx 26rpx, transparent 28rpx);
}

.rec-name {
  width: 152rpx;
  color: #2e323a;
  font-size: 22rpx;
  line-height: 1.16;
  text-align: center;
  font-weight: 900;
  overflow: hidden;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.price {
  color: #ff4b43;
  font-size: 24rpx;
  line-height: 1;
  font-weight: 950;
}

.deal-head {
  margin-top: 34rpx;
}

.deal-row {
  display: grid;
  grid-template-columns: 1.05fr 0.95fr;
  gap: 20rpx;
}

.group-card,
.flash-card {
  height: 252rpx;
  padding: 24rpx;
  position: relative;
  overflow: hidden;
  border-radius: 16rpx;
  box-sizing: border-box;
}

.group-card {
  color: #fff;
  background: #17191f;
}

.flash-card {
  background: #ffef68;
  box-shadow: inset 0 -48rpx 0 rgba(255, 123, 84, 0.18);
}

.deal-title {
  font-size: 32rpx;
  font-weight: 950;
}

.deal-title.dark {
  color: #17191f;
}

.deal-desc {
  margin-top: 10rpx;
  color: rgba(255, 255, 255, 0.68);
  font-size: 22rpx;
  font-weight: 760;
}

.avatars {
  margin-top: 24rpx;
  display: flex;
}

.avatars view {
  width: 56rpx;
  height: 56rpx;
  margin-right: -14rpx;
  border: 4rpx solid #17191f;
  border-radius: 50%;
  background: #c7ff6b;
}

.avatars view:nth-child(2) { background: #ffcf47; }
.avatars view:nth-child(3) { background: #4ac8ff; }

.group-price {
  position: absolute;
  left: 24rpx;
  bottom: 24rpx;
  color: #c7ff6b;
  font-size: 32rpx;
  font-weight: 950;
}

.headphone {
  position: absolute;
  right: 16rpx;
  bottom: 18rpx;
  width: 144rpx;
  height: 144rpx;
  border-radius: 50%;
  background: radial-gradient(circle at 50% 50%, transparent 0 42rpx, #fff 44rpx 54rpx, transparent 56rpx), radial-gradient(circle at 30% 61%, #fff 0 20rpx, transparent 22rpx), radial-gradient(circle at 70% 61%, #fff 0 20rpx, transparent 22rpx), #333843;
  transform: rotate(-9deg);
}

.timer {
  margin-top: 16rpx;
  display: flex;
  gap: 8rpx;
}

.timer text {
  min-width: 46rpx;
  height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  background: #17191f;
  border-radius: 10rpx;
  font-size: 22rpx;
  font-weight: 900;
}

.flash-price {
  position: absolute;
  left: 24rpx;
  bottom: 24rpx;
  color: #e53935;
  font-size: 34rpx;
  font-weight: 950;
}

.speaker {
  position: absolute;
  right: 28rpx;
  bottom: 28rpx;
  width: 108rpx;
  height: 132rpx;
  border-radius: 30rpx;
  background: radial-gradient(circle at 50% 30%, #17191f 0 18rpx, #fff 20rpx 30rpx, #17191f 32rpx 36rpx, transparent 38rpx), radial-gradient(circle at 50% 72%, #17191f 0 26rpx, #fff 28rpx 42rpx, transparent 44rpx), #ff755e;
  transform: rotate(7deg);
}
