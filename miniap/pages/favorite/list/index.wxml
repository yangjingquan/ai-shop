<view class="favorite-page">
  <view class="favorite-head">
    <view>
      <view class="favorite-title">我的收藏</view>
      <view class="favorite-subtitle">把心仪好物留在这里，随时回来看看</view>
    </view>
    <view wx:if="{{total}}" class="favorite-count">{{total}} 件</view>
  </view>

  <view wx:if="{{loading && !items.length}}" class="loading-grid">
    <view wx:for="{{[1, 2, 3, 4]}}" wx:key="*this" class="loading-card">
      <view class="loading-cover shimmer"></view>
      <view class="loading-line loading-name shimmer"></view>
      <view class="loading-line loading-price shimmer"></view>
    </view>
  </view>

  <block wx:elif="{{items.length}}">
    <view class="collection-head">
      <view class="collection-title">心动好物</view>
      <view class="collection-tip">点击商品查看详情</view>
    </view>
    <view class="goods-grid">
      <view wx:for="{{items}}" wx:key="productId" class="goods-card {{item.available ? '' : 'goods-card-disabled'}}" data-id="{{item.productId}}" data-available="{{item.available}}" bindtap="openProduct">
        <view class="goods-cover">
          <image wx:if="{{item.mainImage}}" class="goods-image" src="{{item.mainImage}}" mode="aspectFill" lazy-load />
          <view wx:else class="goods-image goods-image-fallback">{{item.initial}}</view>
          <view wx:if="{{!item.available}}" class="unavailable-mask"><text>已下架</text></view>
          <button class="favorite-action {{removingId === item.productId ? 'favorite-action-disabled' : ''}}" catchtap="removeFavorite" data-id="{{item.productId}}" disabled="{{removingId === item.productId}}">{{removingId === item.productId ? '处理中' : '已收藏'}}</button>
        </view>
        <view class="goods-content">
          <view class="goods-name">{{item.name}}</view>
          <view wx:if="{{item.available}}" class="goods-price"><text class="price-symbol">¥</text><text class="price-value">{{item.priceText}}</text></view>
          <view wx:else class="goods-status">该商品暂不可购买</view>
          <view wx:if="{{item.savedAtText}}" class="goods-meta">收藏于 {{item.savedAtText}}</view>
        </view>
      </view>
    </view>
  </block>

  <view wx:else class="empty-state">
    <view class="empty-illustration"><view class="bookmark-shape"></view></view>
    <view class="empty-title">{{loadError ? '收藏加载失败' : '收藏夹还是空的'}}</view>
    <view class="empty-desc">{{loadError ? '网络可能开小差了，请重新加载' : '遇到心仪商品，点击收藏后会展示在这里'}}</view>
    <button wx:if="{{loadError}}" class="go-shopping" bindtap="retryLoad">重新加载</button>
    <button wx:else class="go-shopping" bindtap="goShopping">去逛逛</button>
  </view>

  <view wx:if="{{loadingMore}}" class="load-state">正在加载更多收藏…</view>
  <view wx:elif="{{items.length && !hasMore}}" class="load-state load-state-end"><view class="end-line"></view><text>已经到底了</text><view class="end-line"></view></view>
</view>
