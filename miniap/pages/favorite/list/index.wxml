<view class="favorite-page page-shell">
  <view class="page-hero page-hero-primary">
    <view class="hero-blob"></view>
    <view class="hero-top-row">
      <view class="hero-title-stack">
        <view class="hero-kicker">MY FAVORITES</view>
        <view class="hero-heading">我的收藏</view>
      </view>
      <view wx:if="{{total}}" class="hero-count-pill">{{total}} 件</view>
    </view>
    <view class="hero-desc">把心仪好物留在这里，随时回来看看</view>
  </view>

  <view class="page-body page-body-lift">
    <view wx:if="{{loading && !items.length}}" class="loading-grid">
      <view wx:for="{{[1, 2, 3, 4]}}" wx:key="*this" class="loading-card">
        <view class="loading-cover skel"></view>
        <view class="loading-line loading-name skel"></view>
        <view class="loading-line loading-price skel"></view>
      </view>
    </view>

    <block wx:elif="{{items.length}}">
      <view class="page-section-head">
        <text class="page-section-title">心动好物</text>
        <text class="page-section-tip">点击商品查看详情</text>
      </view>
      <view class="goods-grid">
        <view
          wx:for="{{items}}"
          wx:key="productId"
          class="goods-card {{item.available ? '' : 'goods-card-disabled'}}"
          data-id="{{item.productId}}"
          data-available="{{item.available}}"
          bindtap="openProduct"
        >
          <view class="goods-cover">
            <image wx:if="{{item.mainImage}}" class="goods-image" src="{{item.mainImage}}" mode="aspectFill" lazy-load />
            <view wx:else class="goods-image goods-image-fallback img-placeholder img-placeholder-1">{{item.initial}}</view>
            <view wx:if="{{!item.available}}" class="unavailable-mask"><text>已下架</text></view>
            <view
              class="favorite-badge {{removingId === item.productId ? 'favorite-badge-disabled' : ''}}"
              catchtap="removeFavorite"
              data-id="{{item.productId}}"
            >{{removingId === item.productId ? '处理中' : '♥ 已收藏'}}</view>
          </view>
          <view class="goods-content">
            <view class="goods-name">{{item.name}}</view>
            <view wx:if="{{item.available}}" class="goods-price price"><text>¥</text>{{item.priceText}}</view>
            <view wx:else class="goods-status">该商品暂不可购买</view>
            <view wx:if="{{item.savedAtText}}" class="goods-meta">收藏于 {{item.savedAtText}}</view>
          </view>
        </view>
      </view>
    </block>

    <view wx:else class="empty-state2 card">
      <view class="empty-state2-symbol">♥</view>
      <text class="empty-state2-title">{{loadError ? '收藏加载失败' : '收藏夹还是空的'}}</text>
      <text class="empty-state2-desc">{{loadError ? '网络可能开小差了，请重新加载' : '遇到心仪商品，点击收藏后会展示在这里'}}</text>
      <button wx:if="{{loadError}}" class="btn btn-ghost btn-sm favorite-action-btn" bindtap="retryLoad">重新加载</button>
      <button wx:else class="btn btn-primary btn-sm favorite-action-btn" bindtap="goShopping">去逛逛</button>
    </view>

    <view wx:if="{{loadingMore}}" class="page-end-note">正在加载更多收藏…</view>
    <view wx:elif="{{items.length && !hasMore}}" class="page-end-note">—— 已经到底了 ——</view>
  </view>
</view>
