.favorite-page {
  min-height: 100vh;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
}

.favorite-page .page-body {
  margin-top: 8rpx;
}

.goods-grid,
.loading-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.goods-card,
.loading-card {
  width: calc(50% - 10rpx);
  margin-bottom: 20rpx;
  padding: 16rpx 16rpx 24rpx;
  border-radius: 32rpx;
  background: #fff;
  box-shadow: 0 8rpx 36rpx rgba(20, 22, 28, 0.04);
  box-sizing: border-box;
}

.goods-card-disabled {
  opacity: 0.72;
}

.goods-cover {
  position: relative;
  width: 100%;
  height: 280rpx;
  border-radius: 24rpx;
  overflow: hidden;
}

.favorite-page .page-section-head {
  margin: 32rpx 0 24rpx;
}

.goods-image {
  width: 100%;
  height: 100%;
}

.goods-image-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  font-weight: 800;
}

.favorite-badge {
  position: absolute;
  top: 12rpx;
  right: 12rpx;
  z-index: 3;
  min-width: 0;
  height: auto;
  margin: 0;
  padding: 6rpx 16rpx;
  border: 0;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.92);
  color: #FF4A1C;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 1.4;
}

.favorite-badge::after {
  border: 0;
}

.favorite-badge-disabled {
  color: #9A9EA8;
}

.unavailable-mask {
  position: absolute;
  inset: 0;
  z-index: 2;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 24rpx;
  background: rgba(0, 0, 0, 0.45);
  color: #fff;
  font-size: 28rpx;
  font-weight: 800;
}

.goods-content {
  margin-top: 12rpx;
}

.goods-name {
  display: -webkit-box;
  overflow: hidden;
  font-size: 26rpx;
  font-weight: 700;
  color: #15161C;
  line-height: 1.45;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  min-width: 0;
}

.goods-price {
  margin-top: 8rpx;
  font-size: 32rpx;
}

.goods-status {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #5B5F6B;
}

.goods-meta {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #9A9EA8;
}

.loading-cover {
  width: 100%;
  height: 280rpx;
  border-radius: 24rpx;
}

.loading-line {
  height: 24rpx;
  margin-top: 16rpx;
  border-radius: 12rpx;
}

.loading-name {
  width: 80%;
}

.loading-price {
  width: 40%;
}

.skel {
  background: linear-gradient(90deg, #EEF0F3, #F7F8FA, #EEF0F3);
  background-size: 220% 100%;
  animation: fav-skel 1.4s ease-in-out infinite;
}

@keyframes fav-skel {
  0% { background-position: 100% 0; }
  100% { background-position: -120% 0; }
}

.favorite-action-btn {
  margin-top: 28rpx;
  min-width: 240rpx;
}
