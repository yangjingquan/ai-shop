.group-list-page {
  min-height: 100vh;
  padding-bottom: 48rpx;
}

.group-hero .hero-note {
  margin-top: 16rpx;
  font-size: 24rpx;
  opacity: 0.9;
}

.group-body {
  padding: 0 32rpx 48rpx;
}

.search-row {
  display: flex;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.search-box {
  flex: 1;
  display: flex;
  align-items: center;
  height: 72rpx;
  padding: 0 24rpx;
  border-radius: 36rpx;
  background: #fff;
  box-shadow: 0 8rpx 36rpx rgba(20, 22, 28, 0.04);
}

.search-box input {
  flex: 1;
  font-size: 28rpx;
}

.search-clear {
  padding: 8rpx;
  color: #9A9EA8;
}

.search-btn {
  flex: none;
  height: 72rpx;
  padding: 0 28rpx;
}

.product-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.product-card {
  display: flex;
  gap: 20rpx;
  padding: 20rpx;
}

.thumb {
  width: 160rpx;
  height: 160rpx;
  border-radius: 24rpx;
  flex: none;
}

.info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.name {
  font-size: 28rpx;
  font-weight: 700;
  color: #15161C;
  display: -webkit-box;
  overflow: hidden;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.meta {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #9A9EA8;
}

.price-row {
  margin-top: 12rpx;
  display: flex;
  align-items: baseline;
  gap: 12rpx;
}

.price {
  font-size: 36rpx;
}

.ordinary {
  font-size: 22rpx;
  color: #9A9EA8;
  text-decoration: line-through;
}
