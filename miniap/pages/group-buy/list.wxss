.group-list-page { min-height: 100vh; padding: 34rpx 24rpx; background: #f7f4ed; box-sizing: border-box; }
.page-title { color: #17191f; font-size: 42rpx; font-weight: 950; }.page-subtitle { margin: 8rpx 0 26rpx; color: #8b8e97; font-size: 24rpx; }
.search-row { display: flex; gap: 16rpx; margin-bottom: 24rpx; }
.search-box { flex: 1; height: 72rpx; display: flex; align-items: center; gap: 12rpx; padding: 0 20rpx 0 24rpx; border-radius: 8rpx; background: #fff; box-sizing: border-box; }
.search-box input { flex: 1; min-width: 0; height: 72rpx; font-size: 28rpx; }
.search-clear { width: 30rpx; height: 30rpx; display: flex; align-items: center; justify-content: center; flex-shrink: 0; border-radius: 50%; color: #fff; background: #c8ccd4; font-size: 18rpx; line-height: 30rpx; font-weight: 900; }
.search-btn { width: 112rpx; height: 72rpx; display: flex; align-items: center; justify-content: center; line-height: normal; text-align: center; border-radius: 8rpx; background: #ff6600; color: #fff; font-size: 28rpx; }
.product-list { display: flex; flex-direction: column; gap: 20rpx; }.product-card { display: flex; gap: 20rpx; padding: 20rpx; border-radius: 20rpx; background: #fff; box-shadow: 0 12rpx 28rpx rgba(50, 44, 36, .05); }
.thumb { width: 180rpx; height: 180rpx; border-radius: 8rpx; background: #eee; flex-shrink: 0; }
.info { flex: 1; min-width: 0; display: flex; flex-direction: column; justify-content: space-between; }
.name { color: #222; font-size: 30rpx; font-weight: 600; line-height: 1.35; }
.meta { color: #666; font-size: 24rpx; }.group-tag { display: inline-block; margin-right: 10rpx; padding: 4rpx 10rpx; border-radius: 8rpx; color: #ff4b43; background: #fff0e7; font-size: 20rpx; }
.price-row { display: flex; align-items: baseline; gap: 12rpx; flex-wrap: wrap; }
.price { color: #ff4b43; font-size: 34rpx; font-weight: 700; }
.ordinary { color: #999; font-size: 22rpx; text-decoration: line-through; }
.empty-card, .loading-text, .end-text { padding: 40rpx 0; color: #999; text-align: center; font-size: 26rpx; }
