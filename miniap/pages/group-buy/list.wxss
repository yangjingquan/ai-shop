.group-list-page { min-height: 100vh; padding: 24rpx; background: #f7f7f7; box-sizing: border-box; }
.search-row { display: flex; gap: 16rpx; margin-bottom: 24rpx; }
.search-row input { flex: 1; height: 72rpx; padding: 0 24rpx; border-radius: 8rpx; background: #fff; font-size: 28rpx; }
.search-btn { width: 112rpx; height: 72rpx; line-height: 72rpx; text-align: center; border-radius: 8rpx; background: #ff6600; color: #fff; font-size: 28rpx; }
.product-list { display: flex; flex-direction: column; gap: 20rpx; }
.product-card { display: flex; gap: 20rpx; padding: 20rpx; border-radius: 8rpx; background: #fff; }
.thumb { width: 180rpx; height: 180rpx; border-radius: 8rpx; background: #eee; flex-shrink: 0; }
.info { flex: 1; min-width: 0; display: flex; flex-direction: column; justify-content: space-between; }
.name { color: #222; font-size: 30rpx; font-weight: 600; line-height: 1.35; }
.meta { color: #666; font-size: 24rpx; }
.price-row { display: flex; align-items: baseline; gap: 12rpx; flex-wrap: wrap; }
.price { color: #ff4b43; font-size: 34rpx; font-weight: 700; }
.ordinary { color: #999; font-size: 22rpx; text-decoration: line-through; }
.empty-card, .loading-text, .end-text { padding: 40rpx 0; color: #999; text-align: center; font-size: 26rpx; }
