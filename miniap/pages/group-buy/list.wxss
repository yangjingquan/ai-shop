page { background: #f8f5f0; }

.group-list-page { min-height: 100vh; padding: 18rpx 20rpx 44rpx; background: #f8f5f0; color: #201f1c; box-sizing: border-box; }
.group-hero { padding: 32rpx 28rpx 26rpx; overflow: hidden; position: relative; border-radius: 28rpx; color: #fff; background: linear-gradient(135deg, #201f1c 0%, #3d342d 58%, #ef5523 59%, #ff8c36 100%); }
.group-hero::after { content: ''; position: absolute; right: -56rpx; bottom: -76rpx; width: 238rpx; height: 238rpx; border: 20rpx solid rgba(255,255,255,.13); border-radius: 50%; }
.hero-kicker, .hero-note { position: relative; z-index: 1; font-size: 19rpx; letter-spacing: .13em; color: #ffcf7c; font-weight: 800; }
.page-title { position: relative; z-index: 1; margin-top: 14rpx; color: #fff; font-size: 48rpx; line-height: 1.05; font-weight: 950; }
.page-subtitle { position: relative; z-index: 1; margin: 12rpx 0 0; color: rgba(255,255,255,.78); font-size: 24rpx; }
.hero-note { display: inline-flex; margin-top: 24rpx; padding: 9rpx 14rpx; border-radius: 999rpx; color: #fff; letter-spacing: 0; background: rgba(255,255,255,.15); font-size: 20rpx; }
.search-row { display: flex; gap: 10rpx; margin: 18rpx 0 24rpx; }
.search-box { height: 76rpx; padding: 0 20rpx; border: 1rpx solid #eee6dc; border-radius: 38rpx; background: #fff; box-sizing: border-box; }
.search-box input { height: 74rpx; font-size: 25rpx; }
.search-btn { width: 108rpx; height: 76rpx; border-radius: 38rpx; background: #201f1c; color: #fff; font-size: 24rpx; font-weight: 800; }
.product-list { display: flex; flex-direction: column; gap: 14rpx; }
.product-card { display: flex; gap: 16rpx; padding: 14rpx; border: 1rpx solid #eee6dc; border-radius: 24rpx; background: #fff; box-shadow: none; }
.thumb { width: 190rpx; height: 190rpx; border-radius: 18rpx; background: #f6f1eb; }
.info { padding: 6rpx 4rpx 4rpx 0; }
.name { color: #201f1c; font-size: 29rpx; font-weight: 800; line-height: 1.35; }
.meta { color: #82776f; font-size: 22rpx; }
.group-tag { padding: 5rpx 11rpx; border-radius: 999rpx; color: #e94d1b; background: #fff0e7; font-size: 19rpx; }
.price-row { gap: 10rpx; }
.price { color: #ef5523; font-size: 38rpx; font-weight: 950; }
.ordinary { color: #a09790; font-size: 20rpx; }
.empty-card, .loading-text, .end-text { padding: 56rpx 0; color: #93877d; text-align: center; font-size: 24rpx; }
