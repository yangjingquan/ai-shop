.group-page { min-height: 100vh; padding: 32rpx; background: #f7f7f7; box-sizing: border-box; }
.panel { padding: 32rpx; border-radius: 8rpx; background: #fff; }
.status { color: #222; font-size: 34rpx; font-weight: 700; }
.count { margin: 24rpx 0; color: #ff6600; font-size: 30rpx; }
.leader, .remaining { color: #666; font-size: 25rpx; line-height: 1.6; }
.remaining { color: #d9480f; }
.members { display: flex; flex-wrap: wrap; gap: 18rpx; margin: 24rpx 0; }
.member { display: flex; align-items: center; width: 100%; color: #555; font-size: 24rpx; }
.avatar { width: 54rpx; height: 54rpx; margin-right: 14rpx; border-radius: 50%; background: #ffe8d9; }
.fallback { display: flex; align-items: center; justify-content: center; color: #d9480f; }
.share-button { margin-top: 16rpx; background: #fff; color: #ff6600; border: 1rpx solid #ff6600; }
.empty { padding: 120rpx 32rpx; color: #888; text-align: center; }
.failure-tip { margin: 18rpx 0; padding: 18rpx; border-radius: 8rpx; color: #9a3412; background: #fff7ed; font-size: 25rpx; line-height: 1.6; }
button { background: #ff6600; color: #fff; border-radius: 8rpx; }
