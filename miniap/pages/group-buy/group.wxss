.group-page { min-height: 100vh; padding-bottom: 36rpx; background: #f7f4ed; color: #17191f; }
.hero { position: relative; padding: 28rpx 32rpx 48rpx; color: #fff; text-align: center; background: #ff5a1f; }
.hero.formed { background: #eaf8ee; color: #159447; }.hero.failed { background: #fff0ed; color: #f04438; }
.hero-back { position: absolute; left: 28rpx; top: 22rpx; font-size: 58rpx; font-weight: 300; line-height: 48rpx; }.hero-title { font-size: 28rpx; font-weight: 800; }.hero-main { margin-top: 38rpx; font-size: 38rpx; font-weight: 950; }.hero-sub { margin-top: 18rpx; font-size: 25rpx; color: #666; }.hero.formed .hero-sub, .hero.failed .hero-sub { color: inherit; opacity: .8; }
.countdown-row { margin-top: 24rpx; display: flex; justify-content: center; align-items: center; gap: 18rpx; font-size: 25rpx; }.countdown { padding: 8rpx 14rpx; border-radius: 8rpx; background: #fff; color: #f04438; font-size: 34rpx; font-weight: 900; letter-spacing: 4rpx; }
.card { margin: 18rpx 24rpx 0; padding: 24rpx; border-radius: 20rpx; background: #fff; box-shadow: 0 12rpx 28rpx rgba(50, 44, 36, .05); box-sizing: border-box; }
.member-head { display: flex; justify-content: space-between; font-size: 28rpx; font-weight: 900; }.accent, .product-price { color: #ff4b43; }.progress { height: 12rpx; margin: 22rpx 0; border-radius: 20rpx; background: #f4dfd2; overflow: hidden; }.progress-inner { height: 100%; border-radius: inherit; background: #ff5a1f; }
.member-list { display: flex; flex-wrap: wrap; gap: 24rpx 18rpx; }.member { width: 112rpx; display: flex; flex-direction: column; align-items: center; color: #61646d; font-size: 21rpx; }.avatar { width: 72rpx; height: 72rpx; border-radius: 50%; background: #fff0e7; }.fallback { display: flex; align-items: center; justify-content: center; color: #ff5a1f; font-weight: 900; }.member-name { max-width: 112rpx; margin-top: 8rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }.leader-tag { margin-top: 4rpx; color: #ff5a1f; font-size: 19rpx; }.invite-slot { color: #ff5a1f; }.invite-plus { width: 68rpx; height: 68rpx; display: flex; align-items: center; justify-content: center; border: 2rpx dashed #ff8c62; border-radius: 50%; font-size: 44rpx; font-weight: 300; }
button::after { border: none; }.primary-btn, .ghost-btn { width: 100%; height: 82rpx; display: flex; align-items: center; justify-content: center; margin-top: 28rpx; padding: 0; border-radius: 42rpx; font-size: 28rpx; font-weight: 900; line-height: normal; box-sizing: border-box; }.primary-btn { color: #fff; background: #ff4b43; }.primary-btn.small { width: auto; flex: 1; margin-top: 0; }.ghost-btn { color: #f04438; background: #fff; border: 1rpx solid #f5b3a8; }.ghost-btn.full { width: 100%; }.remind-link { margin-top: 20rpx; color: #8b8e97; text-align: center; font-size: 23rpx; }
.result-card { text-align: center; }.result-icon { width: 92rpx; height: 92rpx; margin: 4rpx auto 16rpx; border-radius: 50%; color: #fff; background: #2db95b; font-size: 64rpx; line-height: 92rpx; font-weight: 900; }.failed-icon { background: #f04438; }.result-title { color: #159447; font-size: 36rpx; font-weight: 950; }.failed-card .result-title { color: #f04438; }.result-desc { margin-top: 10rpx; color: #8b8e97; font-size: 24rpx; }.result-actions { display: flex; align-items: center; gap: 16rpx; margin-top: 28rpx; }.result-actions .ghost-btn, .result-actions .primary-btn.small { width: auto; flex: 1; margin-top: 0; }
.refund-progress { display: flex; align-items: center; justify-content: center; margin: 32rpx 0 4rpx; }.refund-node { position: relative; color: #aeb7c7; font-size: 21rpx; }.refund-node::before { content: ''; display: block; width: 24rpx; height: 24rpx; margin: 0 auto 10rpx; border: 3rpx solid #d9dee8; border-radius: 50%; background: #fff; box-sizing: border-box; }.refund-node.active { color: #f04438; }.refund-node.active::before { border-color: #f04438; background: #f04438; }.refund-line { width: 58rpx; height: 3rpx; margin: -32rpx 8rpx 0; background: #d9dee8; }.refund-line.active { background: #f04438; }
.product-card { display: flex; align-items: center; padding: 20rpx; }.product-image { width: 136rpx; height: 136rpx; border-radius: 14rpx; background: #f4f4f4; }.product-info { flex: 1; min-width: 0; margin-left: 20rpx; }.product-name { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 27rpx; font-weight: 900; }.product-price { margin-top: 12rpx; font-size: 30rpx; font-weight: 900; }.product-meta { margin-top: 8rpx; color: #8b8e97; font-size: 22rpx; }.arrow { width: 28rpx; height: 28rpx; opacity: .45; }.detail-card { padding: 8rpx 24rpx; }.detail-row { min-height: 78rpx; display: flex; align-items: center; justify-content: space-between; border-bottom: 1rpx solid #f1f1f1; color: #61646d; font-size: 24rpx; }.detail-row:last-child { border-bottom: 0; }.detail-row text:last-child { color: #17191f; }.arrow-text { margin-left: 12rpx; color: #aeb7c7 !important; font-size: 34rpx; vertical-align: -2rpx; }.empty { padding: 160rpx 32rpx; color: #8b8e97; text-align: center; font-size: 26rpx; }
