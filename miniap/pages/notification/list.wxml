<view class="notification-page page-shell">
  <view class="toolbar">
    <text class="summary">{{unreadCount ? unreadCount + ' 条未读消息' : '暂无未读消息'}}</text>
    <text wx:if="{{unreadCount > 0}}" class="read-all" bindtap="readAll">全部已读</text>
  </view>

  <view wx:if="{{list.length}}" class="message-list">
    <view
      wx:for="{{list}}"
      wx:key="id"
      class="message-card {{item.isRead ? 'read' : 'unread'}}"
      data-id="{{item.id}}"
      data-link="{{item.link}}"
      bindtap="readMessage"
    >
      <view class="message-head">
        <view class="title-row">
          <view wx:if="{{!item.isRead}}" class="unread-dot"></view>
          <text class="title">{{item.title}}</text>
        </view>
        <text class="time">{{item.timeText}}</text>
      </view>
      <view class="content">{{item.content}}</view>
      <view wx:if="{{item.link}}" class="link-tip">查看详情 ›</view>
    </view>
  </view>

  <view wx:elif="{{!loading}}" class="empty">
    <view class="empty-icon">消息</view>
    <view class="empty-title">暂无消息</view>
    <view class="empty-desc">拼团结果等通知会出现在这里</view>
  </view>

  <view wx:if="{{loading}}" class="loading">加载中...</view>
  <view wx:if="{{finished && list.length}}" class="finished">没有更多消息了</view>
</view>
