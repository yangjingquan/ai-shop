.notification-page {
  min-height: 100vh;
  padding: 24rpx;
  box-sizing: border-box;
  background: #f6f7f9;
}
.toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 6rpx 4rpx 22rpx;
  font-size: 25rpx;
}
.summary { color: #7b818a; }
.read-all { color: #ff6600; }
.message-card {
  margin-bottom: 18rpx;
  padding: 28rpx;
  border-radius: 20rpx;
  background: #fff;
  box-shadow: 0 8rpx 24rpx rgba(31,35,41,0.05);
}
.message-card.read { opacity: 0.72; }
.message-card.unread { border-left: 6rpx solid #ff6600; }
.message-head, .title-row {
  display: flex;
  align-items: center;
}
.message-head { justify-content: space-between; gap: 20rpx; }
.title-row { gap: 12rpx; min-width: 0; }
.unread-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #ff4d4f;
  flex-shrink: 0;
}
.title { font-size: 30rpx; font-weight: 700; color: #1f2329; }
.time { font-size: 22rpx; color: #a3a8b0; flex-shrink: 0; }
.content { margin-top: 18rpx; color: #59606a; font-size: 27rpx; line-height: 1.65; }
.link-tip { margin-top: 18rpx; color: #ff6600; font-size: 24rpx; }
.empty { padding-top: 220rpx; text-align: center; color: #a3a8b0; }
.empty-icon {
  width: 100rpx;
  height: 100rpx;
  margin: 0 auto 24rpx;
  border-radius: 50%;
  background: #eceff3;
  line-height: 100rpx;
  font-size: 24rpx;
}
.empty-title { color: #59606a; font-size: 30rpx; }
.empty-desc { margin-top: 12rpx; font-size: 24rpx; }
.loading, .finished { padding: 24rpx; text-align: center; color: #a3a8b0; font-size: 24rpx; }
