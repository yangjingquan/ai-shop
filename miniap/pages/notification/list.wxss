.notification-page {
  min-height: 100vh;
  padding-bottom: 48rpx;
}

.notification-hero {
  position: relative;
}

.read-all-btn {
  position: absolute;
  right: 32rpx;
  top: 120rpx;
  width: auto;
  flex: none;
  height: 56rpx;
  margin: 0;
  padding: 0 24rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.6);
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.2);
  color: #fff;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 56rpx;
}

.read-all-btn::after {
  border: 0;
}

.notification-body {
  padding: 0 32rpx;
  margin-top: 8rpx;
}

.message-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.message-card {
  padding: 28rpx;
}

.message-card.unread {
  border-left: 6rpx solid #FF4A1C;
}

.message-head {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
}

.title-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex: 1;
  min-width: 0;
}

.unread-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #FF4A1C;
  flex: none;
}

.title {
  font-size: 30rpx;
  font-weight: 800;
  color: #15161C;
}

.time {
  flex: none;
  font-size: 22rpx;
  color: #9A9EA8;
}

.content {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #5B5F6B;
  line-height: 1.55;
}

.link-tip {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #FF4A1C;
  font-weight: 600;
}

.message-card.read .title,
.message-card.read .content {
  opacity: 0.85;
}
