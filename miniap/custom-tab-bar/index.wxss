.tab-bar {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: calc(36rpx + env(safe-area-inset-bottom));
  z-index: 1000;
  display: flex;
  height: 124rpx;
  padding: 0 12rpx;
  box-sizing: border-box;
  background: rgba(255, 255, 255, 0.96);
  border-radius: 62rpx;
  box-shadow: 0 20rpx 60rpx rgba(20, 22, 28, 0.12);
  backdrop-filter: blur(20rpx);
}

.tab-item {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  color: #9A9EA8;
}

.tab-icon {
  width: 44rpx;
  height: 44rpx;
  display: block;
}

.tab-label {
  color: inherit;
  font-size: 20rpx;
  line-height: 28rpx;
  font-weight: 400;
}

.tab-item.is-active .tab-icon {
  width: 44rpx;
  height: 44rpx;
}

.tab-item.is-active .tab-label {
  color: #FF4A1C;
  font-weight: 700;
}
