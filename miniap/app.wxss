page {
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', 'PingFang SC', sans-serif;
  font-size: 28rpx;
  color: #201f1c;
  background: #f8f5f0;
}

/* Tide Select: shared foundations keep all shopping and marketing pages in one language. */
page, view, text { box-sizing: border-box; }

button {
  font-family: inherit;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: normal;
}

button::after {
  border: none;
}

.page-shell {
  min-height: 100vh;
  background: #f8f5f0;
  box-sizing: border-box;
}

.card {
  background: #fff;
  border: 1rpx solid rgba(32, 31, 28, 0.06);
  border-radius: 24rpx;
  box-shadow: 0 12rpx 32rpx rgba(39, 31, 22, 0.06);
}

.section-title {
  display: flex;
  align-items: center;
  gap: 10rpx;
  color: #1f2329;
  font-size: 30rpx;
  font-weight: 600;
}

.price,
.price-strong {
  color: #f05222;
  font-weight: 700;
}

.muted {
  color: #646a73;
}

.subtle {
  color: #9aa0a6;
}

.icon {
  width: 32rpx;
  height: 32rpx;
  display: inline-block;
  flex: 0 0 auto;
}

.icon-sm {
  width: 28rpx;
  height: 28rpx;
}

.icon-lg {
  width: 72rpx;
  height: 72rpx;
}

.primary-btn {
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 44rpx;
  background: linear-gradient(100deg, #f4511e, #ff7a1a);
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  text-align: center;
}

.outline-btn {
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 36rpx;
  background: #fff1e8;
  color: #e94d1b;
  font-size: 28rpx;
  text-align: center;
}

.empty-state {
  min-height: 360rpx;
  padding: 96rpx 48rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #9aa0a6;
  text-align: center;
}

.empty-icon {
  width: 96rpx;
  height: 96rpx;
  margin-bottom: 20rpx;
  opacity: 0.72;
}

.empty-title {
  color: #646a73;
  font-size: 28rpx;
  font-weight: 500;
}

.empty-desc {
  margin-top: 8rpx;
  color: #9aa0a6;
  font-size: 24rpx;
}
