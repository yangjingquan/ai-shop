page {
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', 'PingFang SC', 'Noto Sans CJK SC', 'Noto Sans SC', sans-serif;
  font-size: 28rpx;
  color: #15161C;
  background: #F6F6F8;
  --tab-bar-gap: 36rpx;
  --tab-bar-height: 124rpx;
  --tab-bar-inset: calc(var(--tab-bar-gap) + var(--tab-bar-height) + env(safe-area-inset-bottom));
  --tab-page-pad-bottom: calc(200rpx + env(safe-area-inset-bottom));
  --cart-checkout-height: 128rpx;
  --cart-page-pad-bottom: calc(200rpx + var(--cart-checkout-height) + 96rpx + env(safe-area-inset-bottom));
}

page, view, text { box-sizing: border-box; }

button {
  margin: 0;
  padding: 0;
  border: none;
  font-family: inherit;
  font-size: inherit;
  font-weight: inherit;
  color: inherit;
  line-height: inherit;
  background: transparent;
  box-sizing: border-box;
  width: auto;
  min-height: 0;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  vertical-align: middle;
}

button::after {
  display: none;
  border: none;
}

button.btn-block,
.btn-block {
  width: 100%;
  display: flex;
  box-sizing: border-box;
}

button.btn-inline,
.btn-inline {
  width: auto;
  flex: none;
  display: inline-flex;
  max-width: none;
}

.page-shell {
  width: 100%;
  min-height: 100vh;
  background: #F6F6F8;
  box-sizing: border-box;
}

.card {
  background: #fff;
  border-radius: 32rpx;
  box-shadow: 0 8rpx 36rpx rgba(20, 22, 28, 0.04);
}

.section-title {
  display: flex;
  align-items: center;
  gap: 10rpx;
  color: #15161C;
  font-size: 38rpx;
  font-weight: 800;
  letter-spacing: 1rpx;
}

.section-subtitle {
  font-size: 24rpx;
  color: #9A9EA8;
  margin-top: 6rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  margin: 44rpx 32rpx 24rpx;
}

.section-more {
  font-size: 24rpx;
  color: #5B5F6B;
}

.price,
.price-strong {
  color: #FF4A1C;
  font-weight: 800;
  font-family: 'DIN Alternate', 'Roboto Condensed', sans-serif;
}

.price text {
  font-size: 0.65em;
  margin-right: 2rpx;
}

.price-original {
  color: #9A9EA8;
  text-decoration: line-through;
  font-size: 22rpx;
  margin-left: 12rpx;
  font-weight: 400;
}

.text-primary { color: #15161C; }
.text-secondary { color: #5B5F6B; }
.text-tertiary { color: #9A9EA8; }
.text-brand { color: #FF4A1C; }
.text-yellow { color: #FFD23F; }
.text-green { color: #16C47F; }
.text-blue { color: #3D7BFF; }
.text-purple { color: #7B5CFF; }

.bg-brand-light { background: #FFF1EB; }
.bg-gray { background: #F6F6F8; }

.icon {
  width: 32rpx;
  height: 32rpx;
  display: inline-block;
  flex: 0 0 auto;
}

.icon-sm {
  width: 28rpx;
  height: 28rpx;
}

.icon-lg {
  width: 72rpx;
  height: 72rpx;
}

.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: auto;
  flex: none;
  padding: 0 36rpx;
  border-radius: 36rpx;
  font-size: 28rpx;
  font-weight: 600;
  border: 2rpx solid #ECEDF0;
  background: #fff;
  color: #15161C;
}

.btn-primary,
button.btn-primary,
button.btn.btn-primary {
  height: 96rpx;
  border-radius: 48rpx;
  background: linear-gradient(90deg, #FF4A1C, #FF8A00);
  color: #fff;
  border: 0;
  font-size: 32rpx;
  box-shadow: 0 12rpx 28rpx rgba(255, 74, 28, 0.28);
}

.btn-dark {
  height: 72rpx;
  border-radius: 36rpx;
  background: #15161C;
  color: #fff;
  border: 0;
  font-size: 28rpx;
}

.btn-outline {
  height: 72rpx;
  border-radius: 36rpx;
  background: #fff;
  color: #15161C;
  border: 2rpx solid #ECEDF0;
  font-size: 28rpx;
}

.btn-ghost {
  height: 72rpx;
  border-radius: 36rpx;
  background: #fff;
  color: #FF4A1C;
  border: 2rpx solid #FF4A1C;
  font-size: 28rpx;
}

.btn-danger {
  background: #FF4A1C;
  color: #fff;
  border: 0;
}

.btn-disabled {
  background: #E5E6EA;
  color: #A9ACB4;
  box-shadow: none;
  border: 0;
}

.btn-lg {
  height: 96rpx;
  border-radius: 48rpx;
  font-size: 32rpx;
  width: 100%;
  display: flex;
}

.btn-md {
  height: 72rpx;
  border-radius: 36rpx;
  font-size: 28rpx;
}

.btn-sm,
button.btn-sm {
  height: 60rpx;
  border-radius: 30rpx;
  font-size: 24rpx;
  padding: 0 28rpx;
}

button.btn-sm.btn-primary,
button.btn-sm.btn-ghost {
  display: inline-flex;
  width: auto;
  flex: none;
}

.tag {
  display: inline-block;
  font-size: 20rpx;
  font-weight: 700;
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
  background: #FFF1EB;
  color: #FF4A1C;
}

.tag-yellow {
  background: #FFD23F;
  color: #15161C;
}

.tag-green {
  background: #E6FBF2;
  color: #16C47F;
}

.tag-blue {
  background: #E7F0FF;
  color: #3D7BFF;
}

.tag-purple {
  background: #F0E6FF;
  color: #7B5CFF;
}

.tag-solid {
  background: #FF4A1C;
  color: #fff;
}

.pad-custom-tab-bar {
  /* Fallback first: WXSS may drop the whole rule if calc(var()+env()) is invalid */
  padding-bottom: 200rpx;
  padding-bottom: calc(200rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(200rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

/* Tab roots must not use padding shorthand with bottom 0 — it overrides this utility (see order/list, category). */
.home.pad-custom-tab-bar,
.cat-page.pad-custom-tab-bar,
.order-list-page.pad-custom-tab-bar,
.my-page.pad-custom-tab-bar {
  padding-bottom: 200rpx;
  padding-bottom: calc(200rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(200rpx + env(safe-area-inset-bottom));
}

.pad-custom-tab-bar-cart {
  padding-bottom: 360rpx;
  padding-bottom: calc(360rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(360rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

/* In-flow scroll extent (reliable vs page padding alone): tab 36+124 + margin */
.tab-bottom-spacer {
  width: 100%;
  height: 200rpx;
  height: calc(200rpx + constant(safe-area-inset-bottom));
  height: calc(200rpx + env(safe-area-inset-bottom));
  flex-shrink: 0;
}

/* Checkout bar (~168rpx) + tab-bar-inset (36+124) + safe area */
.cart-bottom-spacer {
  width: 100%;
  height: 360rpx;
  height: calc(360rpx + constant(safe-area-inset-bottom));
  height: calc(360rpx + env(safe-area-inset-bottom));
  flex-shrink: 0;
}

.pad-fixed-bottom-bar {
  padding-bottom: calc(156rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.text-ellipsis {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  min-width: 0;
}

.fixed-above-custom-tab-bar {
  bottom: var(--tab-bar-inset);
}

.note-label {
  font-size: 20rpx;
  font-weight: 800;
  letter-spacing: 4rpx;
  color: #FF4A1C;
  background: #FFF1EB;
  padding: 6rpx 16rpx;
  border-radius: 40rpx;
}

.status-badge {
  font-size: 22rpx;
  font-weight: 700;
  padding: 4rpx 12rpx;
  border-radius: 20rpx;
}

.status-badge-active {
  background: #FFF1EB;
  color: #FF4A1C;
}

.status-badge-success {
  background: #E6FBF2;
  color: #16C47F;
}

.status-badge-gray {
  background: #ECEDF0;
  color: #9A9EA8;
}

.checkbox {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  border: 3rpx solid #C8CBD2;
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 24rpx;
}

.checkbox-checked {
  background: #FF4A1C;
  border-color: #FF4A1C;
}

.checkbox-checked::after {
  content: "✓";
}

.checkbox-disabled {
  background: #EEE;
  border-color: #DDD;
}

.empty-state {
  min-height: 360rpx;
  padding: 96rpx 48rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #9A9EA8;
  text-align: center;
}

.empty-icon {
  width: 96rpx;
  height: 96rpx;
  margin-bottom: 20rpx;
  opacity: 0.72;
}

.empty-title {
  color: #5B5F6B;
  font-size: 28rpx;
  font-weight: 500;
}

.empty-desc {
  margin-top: 8rpx;
  color: #9A9EA8;
  font-size: 24rpx;
}

.gradient-bg-primary {
  background: linear-gradient(160deg, #FF4A1C 0%, #FF6A2B 55%, #FF8A00 100%);
}

.gradient-bg-purple {
  background: linear-gradient(160deg, #6A4CFF, #FF5CA8);
}

.gradient-bg-blue {
  background: linear-gradient(160deg, #2E6BFF, #6FA8FF);
}

.gradient-bg-green {
  background: linear-gradient(160deg, #0FB577, #7ADB5A);
}

.gradient-bg-yellow {
  background: linear-gradient(160deg, #FFB400, #FF7A00);
}

.gradient-bg-dark {
  background: linear-gradient(160deg, #15161C, #2E3140);
}

.img-placeholder {
  border-radius: 24rpx;
  position: relative;
  overflow: hidden;
}

.img-placeholder::after {
  content: "";
  position: absolute;
  width: 46%;
  height: 46%;
  left: 27%;
  top: 27%;
  border-radius: 30%;
  background: rgba(255, 255, 255, 0.55);
  transform: rotate(12deg);
}

.img-placeholder-1 { background: linear-gradient(135deg, #FFE3D6, #FFC2A8); }
.img-placeholder-2 { background: linear-gradient(135deg, #E3ECFF, #BFD3FF); }
.img-placeholder-3 { background: linear-gradient(135deg, #DDF7EC, #AEEBD1); }
.img-placeholder-4 { background: linear-gradient(135deg, #FFF3C9, #FFE08A); }
.img-placeholder-5 { background: linear-gradient(135deg, #F0E6FF, #D6C2FF); }
.img-placeholder-6 { background: linear-gradient(135deg, #EDEEF2, #D5D8E0); }

/* Shared marketing / list page hero (inset card + lifted content below) */
.page-hero {
  position: relative;
  margin: 24rpx 24rpx 0;
  padding: 40rpx 32rpx 64rpx;
  border-radius: 32rpx;
  overflow: hidden;
  color: #fff;
  box-sizing: border-box;
}

.page-hero-primary {
  background: linear-gradient(160deg, #FF4A1C 0%, #FF6A2B 55%, #FF8A00 100%);
}

.page-hero-purple {
  background: linear-gradient(150deg, #6A4CFF, #FF5CA8);
}

.page-hero-gold {
  background: linear-gradient(150deg, #FFB400, #FF7A00);
}

.page-hero-green {
  background: linear-gradient(150deg, #0FB577, #7ADB5A);
}

.page-hero-blue {
  background: linear-gradient(150deg, #2E6BFF, #6FA8FF);
}

.page-hero-dark {
  background: linear-gradient(150deg, #15161C, #2E3140);
}

.hero-blob {
  position: absolute;
  width: 440rpx;
  height: 440rpx;
  right: -120rpx;
  top: -160rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.12);
  pointer-events: none;
}

.hero-kicker {
  font-size: 20rpx;
  font-weight: 800;
  letter-spacing: 6rpx;
  line-height: 1.45;
  opacity: 0.7;
}

.hero-heading {
  margin-top: 16rpx;
  font-size: 52rpx;
  font-weight: 900;
  line-height: 1.25;
}

.hero-desc {
  margin-top: 12rpx;
  font-size: 26rpx;
  line-height: 1.55;
  opacity: 0.85;
}

.hero-top-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.hero-title-stack {
  flex: 1;
  min-width: 0;
}

.hero-title-stack .hero-heading {
  margin-top: 12rpx;
}

.hero-action-pill,
.hero-count-pill {
  flex: none;
  height: 56rpx;
  margin-top: 28rpx;
  padding: 0 24rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.55);
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.22);
  color: #fff;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 52rpx;
  text-align: center;
  box-sizing: border-box;
}

.hero-count-pill {
  border: 0;
  background: #fff;
  color: #FF4A1C;
  line-height: 56rpx;
}

.hero-chips-slot {
  margin-top: 28rpx;
  padding-bottom: 4rpx;
}

.hero-badge {
  /* legacy: use hero-count-pill in hero-top-row */
  padding: 8rpx 24rpx;
  border-radius: 28rpx;
  background: #fff;
  color: #FF4A1C;
  font-size: 26rpx;
  font-weight: 800;
}

.hero-chip-row {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 20rpx;
}

.hero-chip {
  display: flex;
  align-items: center;
  height: 56rpx;
  padding: 0 28rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.18);
  color: #fff;
  font-size: 24rpx;
}

.hero-chip-on {
  background: #fff;
  color: #FF4A1C;
  font-weight: 700;
}

.page-body {
  padding: 0 32rpx 48rpx;
  box-sizing: border-box;
}

/* Positive gap after inset page-hero (do not use negative overlap) */
.page-body-lift {
  margin-top: 32rpx;
  position: relative;
  z-index: 1;
}

.page-body-lift > .section-title:first-child,
.page-body-lift > .page-section-head:first-child,
.page-body-lift > .mall-notice:first-child {
  margin-top: 0;
}

.page-section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 32rpx 0 20rpx;
}

.page-section-title {
  font-size: 34rpx;
  font-weight: 800;
  color: #15161C;
}

.page-section-tip {
  font-size: 24rpx;
  color: #9A9EA8;
}

.st-pill {
  display: inline-flex;
  align-items: center;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  font-weight: 700;
  white-space: nowrap;
}

.st-pill-orange {
  background: #FFF1EB;
  color: #FF4A1C;
}

.st-pill-green {
  background: #E6FBF2;
  color: #16C47F;
}

.st-pill-gray {
  background: #ECEDF0;
  color: #9A9EA8;
}

.st-pill-blue {
  background: #E3ECFF;
  color: #3D7BFF;
}

.empty-state2 {
  padding: 72rpx 32rpx;
  text-align: center;
}

.empty-state2-symbol {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 168rpx;
  height: 168rpx;
  margin: 0 auto 24rpx;
  border-radius: 56rpx;
  background: linear-gradient(135deg, #FFF1EB, #FFE0D2);
  color: #FF4A1C;
  font-size: 56rpx;
  font-weight: 900;
}

.empty-state2-title {
  display: block;
  font-size: 32rpx;
  font-weight: 800;
  color: #15161C;
}

.empty-state2-desc {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #9A9EA8;
}

.empty-state2 button,
.empty-state2 .btn {
  display: flex;
  margin: 28rpx auto 0;
}

.page-end-note {
  margin: 28rpx 0;
  text-align: center;
  font-size: 24rpx;
  color: #9A9EA8;
}

.field-textarea {
  width: 100%;
  min-height: 192rpx;
  padding: 24rpx 28rpx;
  border-radius: 28rpx;
  background: #F6F6F8;
  font-size: 28rpx;
  color: #15161C;
  box-sizing: border-box;
}

.field-input-row {
  display: flex;
  align-items: center;
  height: 88rpx;
  padding: 0 28rpx;
  border-radius: 24rpx;
  background: #F6F6F8;
  font-size: 28rpx;
  color: #15161C;
}

.check-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 26rpx;
  color: #5B5F6B;
}

.check-box {
  width: 36rpx;
  height: 36rpx;
  border-radius: 10rpx;
  border: 2rpx solid #C8CBD2;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  color: transparent;
}

.check-box-on {
  background: #FF4A1C;
  border-color: #FF4A1C;
  color: #fff;
}

.qa-tag {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 36rpx;
  height: 36rpx;
  padding: 0 8rpx;
  border-radius: 8rpx;
  font-size: 20rpx;
  font-weight: 800;
  color: #fff;
}

.qa-tag-q {
  background: #15161C;
}

.qa-tag-a {
  background: #FF4A1C;
}
